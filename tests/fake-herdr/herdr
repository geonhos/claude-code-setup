#!/bin/bash
# Fake `herdr` for the viewer-pane tests (headless*.test.sh) and gate/worktree tests. Not a real client.
# Every call is logged to $FAKE_LOG with %q-escaped argv. It answers only the pane commands the viewer uses.
# State:  $FAKE_DIR/split_fail   exists => `pane split` fails
#         $FAKE_DIR/no_run       exists => `pane run` does nothing (shell not at a prompt)
#         $FAKE_DIR/closed.<id>  written by `pane close`; `pane get <id>` then reports pane_not_found
set -u
: "${FAKE_DIR:?FAKE_DIR must be set}"
: "${FAKE_LOG:?FAKE_LOG must be set}"
# %q keeps argument boundaries visible: "a b" is logged as a\ b
{ printf '%q ' "$@"; printf '\n'; } >> "$FAKE_LOG"

case "${1:-} ${2:-}" in
  "pane layout")
    echo '{"id":"cli:pane:layout","result":{"layout":{"panes":[{"pane_id":"w1:p1","rect":{"width":162,"height":45}}]},"type":"pane_layout"}}'
    ;;
  "pane split")
    if [ -f "$FAKE_DIR/split_fail" ]; then
      echo '{"error":{"code":"pane_not_found"}}' >&2; exit 1
    fi
    echo '{"id":"cli:pane:split","result":{"pane":{"pane_id":"w1:p2"}},"type":"pane_split"}'
    ;;
  "pane get")
    if [ -f "$FAKE_DIR/closed.${3:-}" ]; then echo '{"error":{"code":"pane_not_found","message":"pane not found"},"id":"cli:pane:get"}'; exit 1; fi
    echo '{"id":"cli:pane:get","result":{"pane":{"pane_id":"'"${3:-}"'","cwd":"'"$PWD"'"}},"type":"pane_info"}'
    ;;
  "pane close")
    touch "$FAKE_DIR/closed.${3:-}"
    echo '{"id":"cli:pane:close","result":{},"type":"pane_close"}'
    ;;
  "pane read")
    if [ -f "$FAKE_DIR/run.out" ]; then cat "$FAKE_DIR/run.out"; else
      echo "fake screen line 1"
      echo "fake screen line 2"
    fi
    ;;
  "pane run")
    # run the command detached, like a real pane shell
    [ -f "$FAKE_DIR/no_run" ] || { ( cd "$PWD" && HARNESS_ROLE=worker bash -c "${*:4}" ) >"$FAKE_DIR/run.out" 2>&1 & }
    echo '{"id":"cli:pane:run","result":{},"type":"pane_run"}'
    ;;
  *)
    echo "fake herdr: unhandled '$*'" >&2; exit 1
    ;;
esac
