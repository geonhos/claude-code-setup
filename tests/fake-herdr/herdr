#!/bin/bash
# Fake `herdr` for tests/harness.test.sh. Not a real client.
# State:  $FAKE_DIR/live.<agent>   exists => agent is live; content = agent_status
#         $FAKE_DIR/split_fail      exists => `pane split` fails
#         $FAKE_DIR/start_fail      exists => `agent start` fails
#         $FAKE_DIR/prompt_fail     exists => `agent prompt` is rejected (socket_unavailable)
#         $FAKE_DIR/layout          optional "WIDTH HEIGHT" for `pane layout` (default 162 45)
#         $FAKE_DIR/pane.<agent>    pane id recorded by `agent start --pane` (default w1:p2)
#         $FAKE_DIR/session.<agent> Claude session id reported by `agent get` (default sess-<agent>-0)
#         $FAKE_CLEAR               ok (default): `agent prompt <a> /clear` assigns a new session id
#                                   stuck: /clear is accepted but the session id never changes
#         $FAKE_PROMPT_HOOK         shell snippet run when `agent prompt` is called (not for /clear)
set -u
: "${FAKE_DIR:?FAKE_DIR must be set}"
: "${FAKE_LOG:?FAKE_LOG must be set}"
# %q keeps argument boundaries visible: "a b" is logged as a\ b
{ printf '%q ' "$@"; printf '\n'; } >> "$FAKE_LOG"

sub="${1:-} ${2:-}"
case "$sub" in
  "pane layout")
    w=162; h=45
    if [ -f "$FAKE_DIR/layout" ]; then read -r w h < "$FAKE_DIR/layout"; fi
    printf '{"id":"cli:pane:layout","result":{"layout":{"panes":[{"pane_id":"w1:p1","rect":{"width":%s,"height":%s}}]},"type":"pane_layout"}}\n' "$w" "$h"
    ;;
  "pane split")
    if [ -f "$FAKE_DIR/split_fail" ]; then
      echo '{"error":{"code":"pane_not_found"}}' >&2; exit 1
    fi
    echo '{"id":"cli:pane:split","result":{"pane":{"pane_id":"w1:p2"}},"type":"pane_split"}'
    ;;
  "pane close")
    # closing a pane ends the agent living in it
    for f in "$FAKE_DIR"/pane.*; do
      [ -f "$f" ] || continue
      if [ "$(cat "$f")" = "${3:-}" ]; then
        n=${f##*/pane.}
        rm -f "$FAKE_DIR/live.$n" "$f" "$FAKE_DIR/session.$n"
      fi
    done
    echo '{"id":"cli:pane:close","result":{},"type":"pane_close"}'
    ;;
  "agent get")
    name=$3
    if [ -f "$FAKE_DIR/live.$name" ]; then
      status=$(cat "$FAKE_DIR/live.$name")
      pane=w1:p2
      if [ -f "$FAKE_DIR/pane.$name" ]; then pane=$(cat "$FAKE_DIR/pane.$name"); fi
      sess="sess-$name-0"
      if [ -f "$FAKE_DIR/session.$name" ]; then sess=$(cat "$FAKE_DIR/session.$name"); fi
      printf '{"id":"cli:agent:get","result":{"agent":{"agent":"claude","agent_session":{"kind":"id","value":"%s"},"agent_status":"%s","pane_id":"%s"}},"type":"agent_info"}\n' "$sess" "$status" "$pane"
    else
      echo '{"error":{"code":"agent_not_found"}}' >&2; exit 1
    fi
    ;;
  "agent start")
    name=$3
    if [ -f "$FAKE_DIR/start_fail" ]; then
      echo '{"error":{"code":"agent_not_ready"}}' >&2; exit 1
    fi
    echo idle > "$FAKE_DIR/live.$name"
    echo "sess-$name-s$$" > "$FAKE_DIR/session.$name"
    prev=""
    for a in "$@"; do
      if [ "$prev" = --pane ]; then echo "$a" > "$FAKE_DIR/pane.$name"; break; fi
      prev=$a
    done
    echo '{"id":"cli:agent:start","result":{},"type":"agent_start"}'
    ;;
  "agent prompt")
    name=$3
    if [ -f "$FAKE_DIR/prompt_fail" ]; then
      echo '{"error":{"code":"socket_unavailable"}}' >&2; exit 1
    fi
    if [ "$(cat "$FAKE_DIR/live.$name" 2>/dev/null)" = blocked ]; then
      echo '{"error":{"code":"agent_blocked"}}' >&2; exit 1
    fi
    if [ "${4:-}" = /clear ]; then
      if [ "${FAKE_CLEAR:-ok}" != stuck ]; then
        echo "sess-$name-c$$-$RANDOM" > "$FAKE_DIR/session.$name"
        echo idle > "$FAKE_DIR/live.$name"
      fi
      echo '{"id":"cli:agent:prompt","result":{},"type":"agent_prompt"}'
      exit 0
    fi
    if [ -n "${FAKE_PROMPT_HOOK:-}" ]; then
      /bin/bash -c "$FAKE_PROMPT_HOOK"
    fi
    echo '{"id":"cli:agent:prompt","result":{},"type":"agent_prompt"}'
    ;;
  "agent read")
    if [ ! -f "$FAKE_DIR/live.$3" ]; then
      echo '{"error":{"code":"agent_not_found"}}' >&2; exit 1
    fi
    echo "fake screen line 1"
    echo "fake screen line 2"
    ;;
  "pane read")
    echo "fake screen line 1"
    echo "fake screen line 2"
    ;;
  *)
    echo "fake herdr: unhandled '$*'" >&2; exit 1
    ;;
esac
