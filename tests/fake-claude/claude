#!/bin/bash
# Fake `claude -p` for tests/headless.test.sh. Not a real client.
# $FAKE_CLAUDE_MODE: success|noreport|error|maxturns|slow<N>|hang|hangterm|hangpre|nostart|junk
# $FAKE_CLAUDE_DENY=1 emits a permission_denied event + result denial (default none).
#   5 = no-tool_input event + result Bash with input; 6 = same with empty input; 8 = 2 input-less events + 2 identical results;
#   9 = 2 input-less events + 1 result; 10 = 2 events matched to 2 results by tool_use_id in reverse order.
#   2 = Bash event + result {same Bash, Read(.env)}; 3 = Bash event only; 4 = result Read(.env) only.
# $FAKE_CLAUDE_RESUME_MISSING=1: a --resume run fails like an unknown session (no init, rc 1).
# $FAKE_PERM sets init permissionMode (default auto). hangpre sleeps before any output.
#   success   init + tool_use + result success; writes the report via $FAKE_REPORT_CMD
#   noreport  like success, no report      error  result is_error (rc 1)
#   maxturns  error_max_turns (rc 1)       slow<N> sleeps N*0.1s, then success
#   hang      sleeps until killed (TERM -> rc 143)   nostart  rc 127, no output
#   junk      non-JSON and unknown event types mixed in, then success
# argv (%q) and stdin go to $FAKE_LOG; $FAKE_DIR/claude.n counts runs (session sess-<n>).
set -u
: "${FAKE_LOG:?}"; : "${FAKE_DIR:?}"
mode=${FAKE_CLAUDE_MODE:-success}
{ printf 'claude: '; printf '%q ' "$@"; printf '\n'; } >> "$FAKE_LOG"
input=$(cat)
[ -z "${FAKE_ENV_DUMP:-}" ] || env > "$FAKE_ENV_DUMP"   # tests/headless-bg.test.sh: what a background run inherits
printf 'claude stdin: %s\n' "$input" >> "$FAKE_LOG"
[ "$mode" != nostart ] || exit 127
echo $$ > "$FAKE_DIR/claude.pid"
echo $$ >> "$FAKE_DIR/claude.pids"   # every run, so tests kill exactly their own
n=$(( $(cat "$FAKE_DIR/claude.n" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$FAKE_DIR/claude.n"
sid=sess-$n
resume=""; prev=""
for a in "$@"; do [ "$prev" != --resume ] || resume=$a; prev=$a; done
[ -z "$resume" ] || sid=$resume
if [ -n "$resume" ] && [ "${FAKE_CLAUDE_RESUME_MISSING:-}" = 1 ]; then   # real claude 2.1.312: result-only stream, rc 1
  echo "No conversation found with session ID: $resume" >&2
  printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"errors":["No conversation found with session ID: '"$resume"'"],"session_id":"'"$sid"'","permission_denials":[]}'
  exit 1
fi
[ "$mode" != hangterm ] || { trap '' TERM; while :; do sleep 0.1; done; }   # ignores TERM: only KILL stops it
[ "$mode" != hangpre ] || { trap 'exit 143' TERM; while :; do sleep 0.1; done; }
ev() { printf '%s\n' "$1"; }
ev '{"type":"system","subtype":"hook_started","hook_event":"Stop","hook_name":"Stop"}'
ev '{"type":"system","subtype":"init","model":"fake-model","permissionMode":"'"${FAKE_PERM:-auto}"'","cwd":"'"$PWD"'","session_id":"'"$sid"'"}'
ev '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"echo hi"}}],"usage":{"input_tokens":10,"cache_creation_input_tokens":20,"cache_read_input_tokens":30}},"session_id":"'"$sid"'"}'
result() { # subtype is_error — FAKE_CLAUDE_DENY=1 adds one permission_denied event + a result denial
  local den='[]'
  if [ "${FAKE_CLAUDE_DENY:-}" = 1 ]; then
    den='[{"tool_name":"Bash","tool_input":{"command":"rm -rf /tmp/x\nsecond line"}}]'
    ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","tool_input":{"command":"rm -rf /tmp/x\nsecond line"},"decision_reason":"safetyCheck","message":"denied by safety check","session_id":"'"$sid"'"}'
  fi
  case "${FAKE_CLAUDE_DENY:-}" in
    2) den='[{"tool_name":"Bash","tool_input":{"command":"rm -rf /tmp/x"}},{"tool_name":"Read","tool_input":{"file_path":".env"}}]'
       ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","tool_input":{"command":"rm -rf /tmp/x"},"decision_reason":"safetyCheck","message":"m"}' ;;
    3) ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","tool_input":{"command":"rm -rf /tmp/x"},"decision_reason":"safetyCheck","message":"m"}' ;;
    4) den='[{"tool_name":"Read","tool_input":{"file_path":".env"}}]' ;;
    5) den='[{"tool_name":"Bash","tool_input":{"command":"rm -rf /tmp/x"}}]'  # real CLI: event has no tool_input (#197)
       ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","decision_reason":"safetyCheck","message":"m"}' ;;
    6) den='[{"tool_name":"Bash","tool_input":{}}]'
       ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","decision_reason":"safetyCheck","message":"m"}' ;;
    8) den='[{"tool_name":"Bash","tool_input":{"command":"a"}},{"tool_name":"Bash","tool_input":{"command":"a"}}]'  # retry: 2 input-less events, 2 identical results
       ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","decision_reason":"safetyCheck","message":"m"}'
       ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","decision_reason":"safetyCheck","message":"m"}' ;;
    9) den='[{"tool_name":"Bash","tool_input":{"command":"a"}}]'  # 2 input-less events, 1 result
       ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","decision_reason":"safetyCheck","message":"m"}'
       ev '{"type":"system","subtype":"permission_denied","tool_name":"Bash","decision_reason":"safetyCheck","message":"m"}' ;;
    10) den='[{"tool_use_id":"t1","tool_name":"Bash","tool_input":{"command":"a"}},{"tool_use_id":"t2","tool_name":"Bash","tool_input":{"command":"b"}}]'  # events in the reverse order: ids pair them
       ev '{"type":"system","subtype":"permission_denied","tool_use_id":"t2","tool_name":"Bash","decision_reason":"reasonB","message":"m"}'
       ev '{"type":"system","subtype":"permission_denied","tool_use_id":"t1","tool_name":"Bash","decision_reason":"reasonA","message":"m"}' ;;
  esac
  ev '{"type":"result","subtype":"'"$1"'","is_error":'"$2"',"num_turns":3,"duration_ms":1500,"total_cost_usd":0.0123,"session_id":"'"$sid"'","permission_denials":'"$den"'}'
}
case "$mode" in
  hang) trap 'exit 143' TERM; while :; do sleep 0.1; done ;;
  slow*) sleep "$(awk -v n="${mode#slow}" 'BEGIN { printf "%.1f", n * 0.1 }')"
         [ -z "${FAKE_REPORT_CMD:-}" ] || /bin/bash -c "$FAKE_REPORT_CMD"
         result success false; exit 0 ;;
  junk) ev 'this is not json'; ev '{"type":"future_event","x":1}'; ev '{"type":"rate_limit_event"}'; ev '{broken' ;;
esac
case "$mode" in
  error) result error_during_execution true; exit 1 ;;
  maxturns) result error_max_turns true; exit 1 ;;
  noreport) result success false; exit 0 ;;
  *) [ -z "${FAKE_REPORT_CMD:-}" ] || /bin/bash -c "$FAKE_REPORT_CMD"
     result success false; exit 0 ;;
esac
