#!/bin/bash
# harness-verify — computational checks (format, lint, test) for harness workers.
# Spec: docs/superpowers/specs/2026-10-18-verification-loop-design.md
#
#   harness-verify detect                 print resolved commands as JSON
#   harness-verify format [file]          PostToolUse hook (reads hook JSON on stdin if no file)
#   harness-verify stop                   Stop hook (reads hook JSON on stdin)
#   harness-verify run [lint|test|all]    manual / reviewer: exit 0 pass, 1 fail
#   harness-verify baseline [agent]       record the start state (harness ask calls it)
#
# Never blocks a worker because of its own prerequisites: jq missing, not a git
# repo, or no config all exit 0 (with at most one stderr line).
set -u

warn() { echo "harness-verify: $*" >&2; }

if ! command -v jq >/dev/null 2>&1; then
  warn "jq not found, skipping"
  exit 0
fi

STATE_REL=".harness/verify"
IS_GIT=0
ROOT=$PWD
AGENT=implementer
STEP_OUT=""
RAN=0

# enter_root [dir] — cd to dir (hook cwd), then to the git toplevel when there is one
enter_root() {
  local top
  [ -z "${1:-}" ] || cd "$1" 2>/dev/null || true
  if top=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ]; then
    IS_GIT=1
    ROOT=$top
    cd "$ROOT" || true
  else
    IS_GIT=0
    ROOT=$PWD
  fi
}

# set_agent NAME — only plain names are used in state file paths
set_agent() {
  case "${1:-}" in
    ''|*[!A-Za-z0-9_-]*) ;;
    *) AGENT=$1 ;;
  esac
}

# --- config --------------------------------------------------------------------

# cfg_get KEY -> prints the JSON value from the first config file that has KEY
cfg_get() {
  local f
  for f in .harness/verify.local.json .claude/harness.json; do
    [ -f "$f" ] || continue
    if jq -e --arg k "$1" 'type == "object" and has($k)' "$f" >/dev/null 2>&1; then
      jq -c --arg k "$1" '.[$k]' "$f"
      return 0
    fi
  done
  return 1
}

mk_has() { grep -Eq "^$1[[:space:]]*:" Makefile 2>/dev/null; }

# detect_step KEY -> prints the auto-detected command for format|lint|test
detect_step() {
  local key=$1 t r
  if [ -f Makefile ]; then
    if [ "$key" = format ]; then
      for t in fmt format; do
        if mk_has "$t"; then echo "make $t"; return; fi
      done
    elif mk_has "$key"; then
      echo "make $key"; return
    fi
  fi
  if [ -f package.json ] && jq -e --arg k "$key" '.scripts[$k] // empty' package.json >/dev/null 2>&1; then
    r=npm
    if [ -f pnpm-lock.yaml ]; then r=pnpm
    elif [ -f yarn.lock ]; then r=yarn
    elif [ -f bun.lockb ] || [ -f bun.lock ]; then r=bun
    fi
    echo "$r run $key"; return
  fi
  if [ -f pyproject.toml ]; then
    case $key in
      format) grep -q '^\[tool\.ruff' pyproject.toml && { echo 'ruff format {files}'; return; } ;;
      lint)   grep -q '^\[tool\.ruff' pyproject.toml && { echo 'ruff check {files}'; return; } ;;
      test)   grep -q '^\[tool\.pytest' pyproject.toml && { echo pytest; return; } ;;
    esac
  fi
  if [ -f Cargo.toml ]; then
    case $key in
      format) echo 'cargo fmt' ;;
      lint)   echo 'cargo clippy -- -D warnings' ;;
      test)   echo 'cargo test' ;;
    esac
    return
  fi
  if [ -f go.mod ]; then
    case $key in
      format) echo 'gofmt -w {files}' ;;
      lint)   echo 'go vet ./...' ;;
      test)   echo 'go test ./...' ;;
    esac
    return
  fi
  if [ "$key" = test ] && [ -x install.sh ] && grep -q -- '--test' install.sh 2>/dev/null; then
    echo './install.sh --test'
  fi
}

# resolve_step KEY -> command string, or nothing when the step is disabled/absent
resolve_step() {
  local v
  if v=$(cfg_get "$1"); then
    printf '%s' "$v" | jq -r 'if type == "string" then . else empty end'
    return
  fi
  detect_step "$1"
}

max_attempts() {
  local v
  v=$(cfg_get maxAttempts 2>/dev/null)
  case "$v" in ''|*[!0-9]*|0) v=3 ;; esac
  echo "$v"
}

cmd_detect() {
  local f l t a m
  f=$(resolve_step format); l=$(resolve_step lint); t=$(resolve_step test)
  a=$(cfg_get app 2>/dev/null); [ -n "$a" ] || a=null
  m=$(max_attempts)
  jq -n -c --arg f "$f" --arg l "$l" --arg t "$t" --argjson a "$a" --argjson m "$m" '
    def nz: if . == "" then null else . end;
    {format: ($f | nz), lint: ($l | nz), test: ($t | nz), app: $a, maxAttempts: $m}'
}

# --- files ---------------------------------------------------------------------

# changed_files -> files changed since the baseline (or HEAD), one per line
changed_files() {
  local base f
  [ "$IS_GIT" = 1 ] || return 0
  base=$(sed -n 1p "$STATE_REL/$AGENT.base" 2>/dev/null)
  [ -n "$base" ] || base=HEAD
  { git -c core.quotepath=off diff --name-only "$base" -- . ':(exclude).harness' 2>/dev/null
    git -c core.quotepath=off ls-files --others --exclude-standard -- . ':(exclude).harness' 2>/dev/null
  } | sort -u | while IFS= read -r f; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
}

# quote_files -> stdin lines to one shell-quoted, space-separated string
quote_files() {
  local f out=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    out="$out $(printf '%q' "$f")"
  done
  printf '%s' "${out# }"
}

# expand_files CMD QUOTED -> CMD with every {files} replaced
expand_files() {
  local c=$1 q=$2 tok='{files}' out=""
  while :; do
    case "$c" in
      *"$tok"*) out="$out${c%%"$tok"*}$q"; c=${c#*"$tok"} ;;
      *) break ;;
    esac
  done
  printf '%s' "$out$c"
}

# --- running steps -------------------------------------------------------------

# run_step STEP FILES — STEP is lint|test. Sets STEP_OUT, RAN. Returns the
# command's status; 0 when the step is absent or has {files} but no files exist.
run_step() {
  local cmd q rc
  STEP_OUT=""
  cmd=$(resolve_step "$1")
  [ -n "$cmd" ] || return 0
  case "$cmd" in
    *'{files}'*)
      q=${2:-}
      [ -n "$q" ] || return 0
      cmd=$(expand_files "$cmd" "$q") ;;
  esac
  RAN=1
  STEP_OUT=$(/bin/bash -c "$cmd" </dev/null 2>&1)
  rc=$?
  return $rc
}

tail40() { printf '%s\n' "$1" | tail -n 40; }

cmd_run() {
  local what=${1:-all} files="" rc=0 ran_any=0
  case "$what" in lint|test|all) ;; *) warn "usage: harness-verify run [lint|test|all]"; exit 1 ;; esac
  enter_root
  files=$(changed_files | quote_files)
  if [ "$what" = lint ] || [ "$what" = all ]; then
    RAN=0
    run_step lint "$files" || rc=1
    [ "$RAN" -eq 0 ] || { ran_any=1; printf '== lint ==\n%s\n' "$STEP_OUT"; }
    [ "$rc" -eq 0 ] || exit 1
  fi
  if [ "$what" = test ] || [ "$what" = all ]; then
    RAN=0
    run_step test "$files" || rc=1
    [ "$RAN" -eq 0 ] || { ran_any=1; printf '== test ==\n%s\n' "$STEP_OUT"; }
    [ "$rc" -eq 0 ] || exit 1
  fi
  [ "$ran_any" -eq 1 ] || echo "harness-verify: nothing to run"
  exit 0
}

# --- state ---------------------------------------------------------------------

# state_id -> HEAD sha and a hash of the working tree changes (outside .harness/)
state_id() {
  local head h
  head=$(git rev-parse HEAD 2>/dev/null)
  h=$({ git status --porcelain -- . ':(exclude).harness'
        git diff -- . ':(exclude).harness'
        git ls-files --others --exclude-standard -- . ':(exclude).harness' | while IFS= read -r f; do
          printf '%s\n' "$f"; cat "$f" 2>/dev/null
        done; } 2>/dev/null | cksum)
  printf '%s\n%s\n' "$head" "$h"
}

write_result() { # status step tail attempts
  mkdir -p "$STATE_REL"
  jq -n -c --arg s "$1" --arg st "$2" --arg t "$3" --argjson a "${4:-0}" \
    '{status: $s, attempts: $a, step: $st, tail: $t}' > "$STATE_REL/$AGENT.json"
}

cmd_baseline() {
  set_agent "${1:-}"
  enter_root
  if [ "$IS_GIT" != 1 ]; then
    warn "not a git repo, no baseline"
    exit 0
  fi
  mkdir -p "$STATE_REL"
  state_id > "$STATE_REL/$AGENT.base"
  echo 0 > "$STATE_REL/$AGENT.attempts"
  rm -f "${STATE_REL:?}/${AGENT:?}.json"
  exit 0
}

# --- hooks ---------------------------------------------------------------------

cmd_stop() {
  local input attempts max files step="" out reason
  input=$(cat)
  set_agent "$(printf '%s' "$input" | jq -r '.agent_type // empty' 2>/dev/null)"
  enter_root "$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)"
  if [ "$IS_GIT" != 1 ]; then
    exit 0
  fi
  if [ -f "$STATE_REL/$AGENT.base" ] && [ "$(state_id)" = "$(cat "$STATE_REL/$AGENT.base")" ]; then
    write_result skipped "" "" 0
    exit 0
  fi
  attempts=$(cat "$STATE_REL/$AGENT.attempts" 2>/dev/null)
  case "$attempts" in ''|*[!0-9]*) attempts=0 ;; esac
  max=$(max_attempts)
  files=$(changed_files | quote_files)

  RAN=0
  if ! run_step lint "$files"; then
    step=lint; out=$STEP_OUT
  elif ! run_step test "$files"; then
    step=test; out=$STEP_OUT
  fi
  if [ -z "$step" ]; then
    if [ "$RAN" -eq 1 ]; then write_result pass "" "" "$attempts"; else write_result skipped "" "" "$attempts"; fi
    exit 0
  fi
  out=$(tail40 "$out")
  if [ "$attempts" -lt "$max" ]; then
    attempts=$((attempts + 1))
    echo "$attempts" > "$STATE_REL/$AGENT.attempts"
    rm -f ".harness/reports/${AGENT:?}.md"
    write_result fail "$step" "$out" "$attempts"
    reason=$(printf 'Verification failed at step %s (attempt %s of %s). Last output:\n%s\n\nFix the cause and finish again; then rewrite the report.' "$step" "$attempts" "$max" "$out")
    jq -n -c --arg r "$reason" '{decision: "block", reason: $r}'
    exit 0
  fi
  write_result fail "$step" "$out" "$attempts"
  exit 0
}

cmd_format() {
  local input="" file="${1:-}" tool cwd q out fcmd lcmd d
  if [ -z "$file" ]; then
    input=$(cat)
    tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null)
    case "$tool" in
      Edit|Write|MultiEdit) ;;
      *) exit 0 ;;
    esac
    file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
    cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
    set_agent "$(printf '%s' "$input" | jq -r '.agent_type // empty' 2>/dev/null)"
  else
    cwd=""
  fi
  enter_root "$cwd"
  [ -n "$file" ] || exit 0
  case "$file" in
    /*)
      # compare physical paths (macOS /var -> /private/var)
      d=$(cd -P "${file%/*}" 2>/dev/null && pwd -P) || exit 0
      file="$d/${file##*/}"
      case "$file" in
        "$ROOT"/*) file=${file#"$ROOT"/} ;;
        *) exit 0 ;;
      esac ;;
  esac
  case "$file" in .harness/*|.git/*|*/../*|../*) exit 0 ;; esac
  [ -f "$file" ] || exit 0
  q=$(printf '%s\n' "$file" | quote_files)

  fcmd=$(resolve_step format)
  if [ -n "$fcmd" ]; then
    case "$fcmd" in *'{files}'*) fcmd=$(expand_files "$fcmd" "$q") ;; esac
    /bin/bash -c "$fcmd" </dev/null >/dev/null 2>&1 || true
  fi
  lcmd=$(resolve_step lint)
  case "$lcmd" in
    *'{files}'*)
      lcmd=$(expand_files "$lcmd" "$q")
      if ! out=$(/bin/bash -c "$lcmd" </dev/null 2>&1); then
        out=$(printf '%s\n' "$out" | head -n 40)
        jq -n -c --arg r "$(printf 'Lint failed for %s:\n%s' "$file" "$out")" '{decision: "block", reason: $r}'
      fi ;;
  esac
  exit 0
}

case "${1:-}" in
  detect)   enter_root; cmd_detect ;;
  format)   shift; cmd_format "$@" ;;
  stop)     cmd_stop ;;
  run)      shift; cmd_run "$@" ;;
  baseline) shift; cmd_baseline "$@" ;;
  *)
    echo "usage: harness-verify detect | format [file] | stop | run [lint|test|all] | baseline [agent]" >&2
    exit 1 ;;
esac
