#!/bin/bash
# The body is one brace group: bash parses the whole file before running any of it, so a
# tool that rewrites this file in place cannot corrupt a run in progress (wiki: troubleshooting).
{
# harness — conductor-side wrapper for detached headless Claude workers (decision 0011).
# Usage: see usage() below. Exit codes of `ask`/`report`: 0 report printed, 1 usage/setup, 2 denied tool call and no report,
# 3 no report (or reviewer without VERDICT), 4 run still going/unknown, 5 verification failed (report still printed).
set -u

# lib/ is sourced eagerly, here, inside the brace group: bash 3.2 reads a sourced file whole,
# so an in-place edit cannot corrupt the run (a lazily sourced file would lose that protection).
# The symlinked $0 is resolved by hand (no readlink -f on old macOS).
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  case $src in */*) d=$(CDPATH= cd -P "${src%/*}" && pwd) ;; *) d=$PWD ;; esac
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$d/$src ;; esac
done
case $src in */*) d=${src%/*} ;; *) d=. ;; esac   # no dirname: PATH may be bare in hooks/tests
HARNESS_LIB=${HARNESS_LIB:-$(CDPATH= cd -P "$d/../lib" 2>/dev/null && pwd)}
# Explicit list, fixed order, no glob: a stray file in lib/ is never sourced. Definitions only.
for m in defaults root metrics headless dash lane openwatch; do
  . "$HARNESS_LIB/harness-$m.sh" 2>/dev/null || { echo "harness: cannot load lib/harness-$m.sh" >&2; exit 1; }
done
unset src d m
# end loader

AGENTS=$HARNESS_ROLES
REPORT_DIR=".harness/reports"
LOG_DIR=".harness/log"
JSONL=".harness/progress.jsonl"
PROGRESS_MD=".harness/progress.md"
DEFAULT_TIMEOUT=$HARNESS_DEFAULT_TIMEOUT_MS
IMPLEMENTER_TIMEOUT=$HARNESS_IMPLEMENTER_TIMEOUT_MS
ASK_DIR=".harness/asks"
# parsed once by ask_parse_args (cmd_ask); ask_inner only reads them
ASK_TIMEOUT=$DEFAULT_TIMEOUT; ASK_TIMEOUT_SET=0; ASK_KEEP=0; ASK_BAD=0; ASK_NOLANE=0; ASK_HINT=0; ASK_INSTR=

# usage: text to stderr, exit 1 (error path); `usage help` (harness help|--help|-h): text to stdout, exit 0
usage() {
  local fd=2 rc=1
  [ "${1:-}" = help ] && { fd=1; rc=0; }
  cat >&$fd <<EOF
usage:
  harness ask    <agent> [--timeout MS (default: implementer $IMPLEMENTER_TIMEOUT, others $DEFAULT_TIMEOUT)] [--keep] [--no-lane] [--] '<instruction>'   (options may also follow the instruction)
  harness report <agent>
  harness wait   <agent> [--timeout MS]
  harness watch  <agent> [-n N]   (human terminal only)
  harness open-watch <agent>   (open the watch dashboard in a new pane/window)
  harness status
  harness [-C DIR] <command> ...
  harness lane   <issue#> [slug] [--type feat|fix|docs] | ls | rm <issue#|path> [--force]
  harness init   [--no-agent] [--shared]   (once per repo: makes it a harness checkout, writes the worker deny rules and the rules block in AGENTS.md; ask refuses without it)
  harness close  <agent> [--force]
  harness wiki-lint [DIR]
  harness metrics [--since YYYY-MM-DD] [--json]
  harness help | --help | -h
agents: $AGENTS
EOF
  exit $rc
}

die() { echo "harness: $*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"; }

valid_agent() {
  case " $AGENTS " in
    *" $1 "*) return 0 ;;
  esac
  die "unknown agent '$1' (expected one of: $AGENTS)"
}

# fmt_ctx <tokens> — "137k", or "-" when unknown
fmt_ctx() {
  case "${1:-}" in
    ''|*[!0-9]*) echo - ;;
    *) echo "$(($1 / 1000))k" ;;
  esac
}

# --- progress log ----------------------------------------------------------------------

git_head() { git rev-parse --short HEAD 2>/dev/null || true; }
# file_sum <file> — cksum "crc-size" of a file (portable), empty if unreadable
file_sum() { cksum < "$1" 2>/dev/null | awk '{ print $1 "-" $2 }'; }
num_or_null() { case "${1:-}" in ''|*[!0-9]*) echo null ;; *) echo "$1" ;; esac; }

# record_progress <agent> <text> <rc> <t0> <head_before> <stdout-file>
# Writes the log file + jsonl line, rotates, regenerates progress.md.
record_progress() {
  local agent=$1 text=$2 rc=$3 t0=$4 hb=$5 out=$6 cb=
  local report="$REPORT_DIR/$agent.md" vj=.harness/verify/implementer.json rmt
  local now ts stamp ha sess ca status="" summary="" verify="" logf n brief sha="" va="" hl='{}' line
  now=$(date +%s)
  # a report older than this ask is a previous ask's (this one died before archiving it)
  if [ -f "$report" ]; then rmt=$(file_mtime "$report") && [ "$rmt" -ge "$t0" ] || report=/dev/null.none; fi
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  stamp=$(date +%Y%m%d-%H%M%S)
  ha=$(git_head)
  # session and context come from the run's exit.json
  hl=$(hl_progress_obj "$agent" "$t0")
  sess=$(printf '%s' "$hl" | jq -r '.session // empty' 2>/dev/null)
  ca=$(printf '%s' "$hl" | jq -r '.ctx_after // empty' 2>/dev/null)
  cb=$(sed -n 's/^ctx_before=//p' "$ASK_DIR/$agent.run" 2>/dev/null | head -n 1)
  hl=$(printf '%s' "$hl" | jq -c 'del(.session, .ctx_after)' 2>/dev/null) || hl='{}'
  if [ -f "$report" ]; then
    status=$(sed -n 's/^status: *//p' "$report" | head -n 1)
    summary=$(sed -n 's/^# *//p' "$report" | head -n 1)
    sha=$(file_sum "$report")
  fi
  if [ "$agent" = implementer ]; then
    verify=$(jq -r '.status // empty' "$vj" 2>/dev/null)
    va=$(jq -r '.attempts // empty' "$vj" 2>/dev/null)
    grep -q '^verify: INTERRUPTED' "$out" 2>/dev/null && verify=interrupted
  fi

  mkdir -p "$LOG_DIR" || return 1
  logf="$LOG_DIR/$stamp-$agent.md"; n=1
  while [ -e "$logf" ]; do n=$((n + 1)); logf="$LOG_DIR/$stamp-$agent-$n.md"; done
  brief=$(printf '%s' "$text" | grep -o '\.harness/task-[A-Za-z0-9_.-]*\.md' | head -n 1)
  {
    printf '# %s ask %s (exit %s, %ss)\n\n## Instruction\n\n%s\n' "$agent" "$ts" "$rc" "$((now - t0))" "$text"
    if [ -n "$brief" ] && [ -f "$brief" ]; then
      printf '\n## Brief (%s)\n\n' "$brief"; cat "$brief"
    fi
    if [ -f "$report" ]; then
      printf '\n## Report\n\n'; cat "$report"
    else
      printf '\n## Screen / output (no report)\n\n'; cat "$out"
      if [ "$hl" != '{}' ]; then
        printf '\n## Run output (last 40 lines)\n\n'
        hl_view_tail "$agent" 40
      fi
    fi
    if [ -s "${ASK_ERR:-}" ]; then
      printf '\n## Errors\n\n'; cat "$ASK_ERR"
    fi
    if [ "$hl" != '{}' ]; then
      printf '\n## Run\n\n'
      printf '%s' "$hl" | jq -r '"ask \(.ask_id // "-"), result \(.result // "-"), turns \(.turns // "-"), cost $\(.cost_usd // "-"), stream \(.stream_log // "-")"' 2>/dev/null
    fi
  } > "$logf" || return 1

  # rotate the jsonl first so the new line lands in the fresh file
  if [ -f "$JSONL" ] && [ "$(wc -c < "$JSONL" | tr -d ' ')" -gt "${HARNESS_JSONL_MAX:-1048576}" ]; then
    mv "$JSONL" "$JSONL.$stamp" && gzip -f "$JSONL.$stamp"
  fi
  line=$(jq -n -c --arg ts "$ts" --arg agent "$agent" --arg session "$sess" \
    --arg instr "$(printf '%s' "$text" | tr '\n' ' ' | cut -c1-160)" \
    --argjson exit "$rc" --arg verify "$verify" --argjson dur "$((now - t0))" \
    --arg hb "$hb" --arg ha "$ha" --argjson cb "$(num_or_null "$cb")" --argjson ca "$(num_or_null "$ca")" \
    --arg status "$status" --arg summary "$summary" --arg sha "$sha" --argjson va "$(num_or_null "$va")" \
    --argjson hl "$hl" --argjson nl "${ASK_NOLANE:-0}" '
    def nz: if . == "" then null else . end;
    {ts: $ts, agent: $agent, session: ($session | nz), instr: $instr, exit: $exit,
     verify: ($verify | nz), verify_attempts: $va, dur_s: $dur, head_before: ($hb | nz), head_after: ($ha | nz),
     ctx_before: $cb, ctx_after: $ca, status: ($status | nz), summary: ($summary | nz), report_sha: ($sha | nz)} + (if $nl == 1 then {no_lane: true} else {} end) + $hl') || return 1
  printf '%s\n' "$line" >> "$JSONL" || return 1

  rotate_logs "$logf"
  write_progress_md
  lane_mirror "$line"
  return 0
}

# ask_parse_args <agent> [args...] — the one walk over an ask's arguments (called by cmd_ask). Options
# (--keep, --no-lane, --timeout MS) may stand before or after the instruction, in any order; `--` ends the
# options (an instruction that starts with `--` follows it). Exactly one other argument is the instruction.
# Sets ASK_INSTR, ASK_TIMEOUT/KEEP/NOLANE and ASK_BAD=1 for an unknown option, a --timeout without a
# positive integer (zero included), or an instruction count other than one; cmd_ask turns ASK_BAD into the usage error.
ask_parse_args() {
  local agent=$1 ninstr=0 endopts=0
  shift
  ASK_KEEP=0; ASK_BAD=0; ASK_NOLANE=0; ASK_HINT=0; ASK_INSTR=
  ASK_TIMEOUT=$DEFAULT_TIMEOUT; ASK_TIMEOUT_SET=0
  [ "$agent" != implementer ] || ASK_TIMEOUT=$IMPLEMENTER_TIMEOUT
  while [ $# -gt 0 ]; do
    if [ "$endopts" = 0 ]; then
      case "$1" in
        --) endopts=1; shift; continue ;;
        --timeout)
          case "${2:-}" in
            ''|*[!0-9]*) ASK_BAD=1; shift ;;     # missing/invalid value: usage
            *[!0]*) if digits_cap "$2"; then   # 10#: 08 is 8, not an octal error
                      ASK_TIMEOUT=$((10#$2)); ASK_TIMEOUT_SET=1; shift 2
                    else ASK_BAD=1; shift; fi ;;   # more than 12 digits: usage
            *) ASK_BAD=1; shift ;;               # zero (0, 00): usage
          esac
          continue ;;
        --keep) ASK_KEEP=1; shift; continue ;;
        --no-lane) ASK_NOLANE=1; shift; continue ;;
        --*[[:space:]]*) ASK_BAD=1; ASK_HINT=1; shift; continue ;;   # looks like an instruction that starts with --
        --*) ASK_BAD=1; shift; continue ;;
      esac
    fi
    ninstr=$((ninstr + 1)); ASK_INSTR=$1; shift
  done
  [ "$ninstr" = 1 ] || ASK_BAD=1
}

# rotate_logs <current-log> — newest N logs kept, older than D days deleted; raw headless
# streams are gzipped once a day old and dropped with the logs
rotate_logs() {
  local f
  ls -1t "$LOG_DIR"/*.md 2>/dev/null | grep -vxF -- "$1" | tail -n +"${HARNESS_LOG_KEEP:-200}" \
    | while IFS= read -r f; do rm -f "$f"; done
  find "$LOG_DIR" -name '*.md' -mtime "+${HARNESS_LOG_DAYS:-14}" 2>/dev/null \
    | grep -vxF -- "$1" | while IFS= read -r f; do rm -f "$f"; done
  find "$LOG_DIR" -name '*.jsonl' -mtime +0 2>/dev/null | while IFS= read -r f; do gzip -f "$f" 2>/dev/null; done
  find "$LOG_DIR" \( -name '*.jsonl' -o -name '*.jsonl.gz' \) -mtime "+${HARNESS_LOG_DAYS:-14}" 2>/dev/null \
    | while IFS= read -r f; do rm -f "$f"; done
  return 0
}

# write_progress_md — regenerate .harness/progress.md (<= 60 lines)
write_progress_md() {
  local tmp="$PROGRESS_MD.tmp.$$" branch goal a f q line=""
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
  goal="(unset)"
  if [ -s .harness/goal.md ]; then
    goal=$(tr '\n' ' ' < .harness/goal.md | sed 's/  */ /g; s/ $//' | cut -c1-400)
  fi
  {
    printf '# Progress — %s (%s)\n' "$(basename "$PWD")" "$branch"
    printf 'Goal: %s\n' "$goal"
    printf '## Recent asks (newest first, max 15)\n'
    grep -v '"event":"close"' "$JSONL" 2>/dev/null | tail -n 15 | jq -r -R 'fromjson? | "- \(.ts) \(if .lane then "[#\(.lane)] " else "" end)\(.agent) exit \(.exit) verify \(.verify // "-") \(.head_before // "")..\(.head_after // "") — \(.summary // "")"' 2>/dev/null \
      | awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) print a[i] }'
    q=$(grep '"event":"close"' "$JSONL" 2>/dev/null | tail -n 5 | jq -r -R 'fromjson? | "\(.ts) \(if .lane then "[#\(.lane)] " else "" end)\(.role) (\(.reason // "?"))"' 2>/dev/null \
      | awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) printf "%s%s", (i == NR ? "" : "; "), a[i]; if (NR) print "" }')
    [ -z "$q" ] || printf 'Recent closes (max 5): %s\n' "$q"
    for f in $(ls -t .harness/reports/*.md 2>/dev/null); do
      q=$(awk '/^## Open questions/ { on = 1; next } /^## / { on = 0 } on && /^- / { if (tolower($0) !~ /^- *none *$/) print }' "$f" | head -n 10)
      if [ -n "$q" ]; then
        printf '## Open questions (from %s)\n%s\n' "$(basename "$f" .md)" "$q"
        break
      fi
    done
    printf '## Workers\n'
    for a in $AGENTS; do
      q=$(hl_status_line "$a" progress)
      if [ -z "$line" ]; then line=$q; else line="$line · $q"; fi
    done
    printf -- '- %s\n' "$line"
  } 2>/dev/null | head -n 60 > "$tmp" && mv "$tmp" "$PROGRESS_MD"
}

# verify_tool ARGS... — run harness-verify from PATH (installed by ./install.sh)
verify_tool() {
  command -v harness-verify >/dev/null 2>&1 || return 1
  harness-verify "$@"
}

# restore_interrupted <agent> <report> — implementer only: the Stop hook hides the
# report as <report>.pending while it verifies. If the hook was killed, only the
# .pending file is left: restore it and exit 5. Callers must have checked the agent
# is idle/done (a working agent may still be verifying; never restore then).
restore_interrupted() {
  [ "$1" = implementer ] && [ ! -f "$2" ] && [ -f "$2.pending" ] || return 0
  mv -f "$2.pending" "$2"
  cat "$2"
  echo "verify: INTERRUPTED"
  exit 5
}

# learned_has_evidence <text> — the bullet cites an ask-id, a commit (7-40 hex with a
# letter a-f and a digit, standalone), path/file.ext:line (path has a / or an extension),
# a .harness/ path or a .log file. `step:2`, `host:8080` and bare numbers do not count.
learned_has_evidence() {
  printf '%s\n' "$1" | grep -Eq '(^|[^0-9])[0-9]{9,}-[0-9]+-[0-9]+|[A-Za-z0-9_.-]*/[A-Za-z0-9_./-]*:[0-9]+|[A-Za-z0-9_-]+\.[A-Za-z][A-Za-z0-9]{0,4}:[0-9]+|\.harness/|\.log([^A-Za-z]|$)' && return 0
  printf '%s\n' "$1" | grep -Eo '(^|[^0-9A-Za-z])[0-9a-f]{7,40}($|[^0-9A-Za-z])' | grep '[0-9]' | grep -q '[a-f]' && return 0
  return 1
}

# learned_is_status <text> — true when the bullet is only task status: after dropping
# commit shas, numbers, diff stats and status words (commit, pushed, PR, files changed,
# tests pass ...) no other word is left. A bullet that states a lesson keeps its words.
learned_is_status() {
  printf '%s\n' "$1" | perl -CSD -ne '
    s/^-\s+//; $_ = lc;
    s/\b[0-9a-f]{7,40}\b//g; s/[+-]\d+//g; s/\d+//g;
    s/\b(commit(ted|s)?|push(ed)?|pr|pull|request|not|no|opened?|files?|changed|tests?|pass(ed|es|ing)?|fail(ed)?|done|merged?|branch|lines?|and|the|on|to|in|a|of|is|are|was|were|yet|origin|main|added|updated)\b//g;
    s/[^\p{L}]//g;
    exit($_ eq "" ? 0 : 1);'
}

# learned_title <text> — the bullet cut for an issue title: whole when <= 70 chars, else
# cut at the last clause/sentence boundary (or word boundary) inside 70 chars, + `…`.
learned_title() {
  printf '%s' "$1" | perl -CSD -ne '
    chomp; if (length($_) <= 70) { print; exit }
    my $w = substr($_, 0, 70); my $n = substr($_, 70, 1); my $c;
    if ($n =~ /\s/) { $c = $w }
    elsif ($w =~ /^(.{25,}[.;:!?,。])\s/s) { $c = $1 }
    elsif ($w =~ /^(.{10,})\s+\S*$/s) { $c = $1 }
    else { $c = $w }
    $c =~ s/[\s,;:-]+$//; print $c . "\x{2026}";'
}

# queue_learned <agent> <report> — file each evidence-backed bullet of the report's
# optional `## Notes` section as a GitHub
# issue labelled `wiki` (title: cut at a clause boundary near 70 chars; body: bullet + source line).
# Indented continuation lines are joined to their bullet. An open `wiki` issue
# or closed `wiki` issue with the same title (or one filed earlier in this run) is skipped.
# Status-only bullets (commit/push/PR info) and bullets without evidence are dropped with a
# one-line stderr warning. Without docs/wiki/index.md under the cwd (the checkout root) nothing is
# filed: one stdout line, the Notes stay in the report. Never fails the caller: no gh, a failing gh or no
# ask-id print one warning and continue.
queue_learned() {
  local agent=$1 report=$2 raw line kept="" n=0 dropped=0 askid date title body open made=0 skipped=0
  raw=$(awk '
    function flush() { if (cur != "") print cur; cur = "" }
    /^## Notes[ \t]*$/ { on = 1; next }
    on && (/^## / || /^VERDICT:/) { flush(); on = 0 }
    on && /^[ \t]*[-*] / { flush(); cur = $0; sub(/^[ \t]*[-*] +/, "- ", cur); next }
    on && cur != "" && /^[ \t]+[^ \t]/ { t = $0; sub(/^[ \t]+/, "", t); cur = cur " " t; next }
    on && /^[ \t]*$/ { flush() }
    END { flush() }
  ' "$report" 2>/dev/null) || return 0
  [ -n "$raw" ] || return 0
  while IFS= read -r line; do
    case "$line" in "- none"|"- None"|"- none."|"- -") continue ;; esac
    if learned_is_status "$line"; then
      dropped=$((dropped + 1))
    elif learned_has_evidence "$line"; then
      n=$((n + 1))
      kept="$kept$line
"
    else
      dropped=$((dropped + 1))
    fi
  done <<EOF_LEARNED
$raw
EOF_LEARNED
  [ "$dropped" -eq 0 ] || echo "harness: wiki: dropped $dropped Notes bullet(s) without evidence or only task status (need a lesson plus ask-id, commit, file:line or log)" >&2
  [ -n "$kept" ] || return 0
  if [ ! -f docs/wiki/index.md ]; then
    echo "wiki: no docs/wiki here; $n Notes bullet(s) left in the report"
    return 0
  fi
  askid=$(awk 'NR == 1 { print $1 }' "$ASK_DIR/$agent.current" 2>/dev/null)
  if [ -z "$askid" ]; then
    echo "harness: wiki: no ask-id for $agent; Notes bullets not filed" >&2
    return 0
  fi
  if ! command -v gh >/dev/null 2>&1; then
    echo "harness: wiki: gh not found; Notes bullets not filed as issues" >&2
    return 0
  fi
  date=$(date +%Y-%m-%d)
  open=$(gh issue list --label wiki --state all --limit 500 --json title --jq '.[].title' 2>/dev/null) || {
    echo "harness: wiki: gh issue list failed; $n Notes bullet(s) not filed as issues, they remain in the report" >&2
    return 0
  }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    line=${line#- }
    title=$(learned_title "$line")
    if printf '%s\n' "$open" | grep -qxF -- "$title"; then
      skipped=$((skipped + 1))
      continue
    fi
    body="$line

Source: $agent ask $askid, $date"
    if gh issue create --label wiki --title "$title" --body "$body" >/dev/null 2>&1; then
      made=$((made + 1))
      open="$open
$title"
    else
      echo "harness: wiki: gh issue create failed; $((n - made - skipped)) Notes bullet(s) not filed, they remain in the report" >&2
      break
    fi
  done <<EOF_KEPT
$kept
EOF_KEPT
  [ "$made" -eq 0 ] && [ "$skipped" -eq 0 ] && return 0
  echo "wiki: $made issue$([ "$made" -eq 1 ] || echo s) filed with label wiki ($skipped duplicate skipped)"
}

# finish_report <agent> <report> — print the report and exit with the
# verification-aware status (0 pass · 3 reviewer without VERDICT · 5 failed)
finish_report() {
  local agent=$1 report=$2 last vj st
  queue_learned "$agent" "$report"
  case "$agent" in
    implementer)
      vj=".harness/verify/implementer.json"
      st=$(jq -r '.status // empty' "$vj" 2>/dev/null)
      cat "$report"
      if [ "$st" = fail ]; then
        echo "verify: FAIL ($(jq -r '.step // "?"' "$vj" 2>/dev/null), $(jq -r '.attempts // 0' "$vj" 2>/dev/null) attempts)"
        exit 5
      fi
      exit 0 ;;
    reviewer)
      last=$(awk 'NF { l = $0 } END { print l }' "$report")
      case "$last" in
        "VERDICT: PASS") cat "$report"; exit 0 ;;
        "VERDICT: FAIL") cat "$report"; exit 5 ;;
      esac
      echo "harness: reviewer report has no final 'VERDICT: PASS|FAIL' line; ask it to rewrite the report." >&2
      exit 3 ;;
  esac
  cat "$report"
  exit 0
}

# kill_tree <pid> — TERM pid and all its descendants (macOS has no setsid)
kill_tree() {
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done
  kill "$1" 2>/dev/null
  return 0
}

# ask_finish [rc] — replay the buffered stdout, log the ask, remove the temp
# file, exit. Runs once: normally after the inner ask, or from the EXIT/TERM/INT
# trap when the wrapper is killed mid-wait (rc 143/130 then).
ask_finish() {
  [ "$ASK_DONE" = 0 ] || return 0
  ASK_DONE=1
  local rc=${1:-1}
  if [ -n "$ASK_PID" ] && kill -0 "$ASK_PID" 2>/dev/null; then
    kill_tree "$ASK_PID"
  fi
  cat "$ASK_TMP" 2>/dev/null
  if [ -n "${ASK_ERR:-}" ] && [ -f "$ASK_ERR" ]; then cat "$ASK_ERR" >&2; fi
  record_progress "$ASK_AGENT" "$ASK_TEXT" "$rc" "$ASK_T0" "$ASK_HB" "$ASK_TMP" \
    || echo "harness: could not write the progress log (ask result unchanged)" >&2
  rm -f "$ASK_TMP" "${ASK_ERR:-}"
  exit "$rc"
}

# cmd_ask — runs ask_inner (which exits through many paths) in a background
# subshell and waits, then logs the outcome. Output and exit code are the inner
# ones; logging problems only warn on stderr.
cmd_ask() {
  [ "${HARNESS_ROLE:-}" != worker ] || die "harness ask is for the conductor; a worker (HARNESS_ROLE=worker) does its task itself"
  # a usage error starts nothing and writes no progress row (no run to record)
  local agent=${1:-}
  [ $# -eq 0 ] || shift
  ask_parse_args "$agent" "$@"
  local text=$ASK_INSTR
  case " $AGENTS " in *" $agent "*) ;; *) ask_inner "$agent" "$text" ;; esac
  if [ "$ASK_BAD" != 0 ] || [ -z "$text" ]; then
    [ "$ASK_HINT" = 0 ] || echo "harness ask: an instruction that starts with -- must follow a bare --" >&2
    usage
  fi
  [ "$agent" != implementer ] || [ "$ASK_NOLANE" = 1 ] || ! lane_in_primary \
    || die "refusing to run the implementer in the primary worktree: create a work folder with 'harness lane <issue#>' and use 'harness -C <folder> ask implementer ...' (--no-lane: only for tasks that do not change this repo)"
  set -- "$agent" "$text"
  ASK_TMP=$(mktemp "${TMPDIR:-/tmp}/harness-ask.XXXXXX") || ask_inner "$@"
  ASK_AGENT=$agent ASK_TEXT=$text ASK_DONE=0 ASK_PID=""
  ASK_T0=$(date +%s); ASK_HB=$(git_head)
  trap 'ask_finish 143' TERM
  trap 'ask_finish 130' INT
  trap 'ask_finish 129' HUP
  trap 'ask_finish "$?"' EXIT
  ASK_ERR=$(mktemp "${TMPDIR:-/tmp}/harness-err.XXXXXX") || ASK_ERR=   # not harness-ask.*: tests glob that prefix
  ( ask_inner "$@" ) > "$ASK_TMP" 2> "${ASK_ERR:-/dev/null}" &
  ASK_PID=$!
  wait "$ASK_PID"
  ask_finish "$?"
}

ask_inner() {
  local agent=${1:-} text=${2:-} timeout=$ASK_TIMEOUT keep=$ASK_KEEP
  [ -n "$agent" ] && [ -n "$text" ] || usage
  valid_agent "$agent"

  if [ "$agent" = implementer ] && ! command -v harness-verify >/dev/null 2>&1; then
    die "harness-verify not found on PATH; run ./install.sh (the implementer's checks would silently not run)"
  fi

  ask_headless "$agent" "$text" "$timeout" "$keep"
}

# digits_only <string> — succeed only for a non-empty all-digit string
digits_only() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
}

# digits_cap <string> — digits_only, and at most 12 digits after the leading zeros: a longer number
# wraps in $(( )) (2^63) and gives a wrong or negative timeout
digits_cap() {
  digits_only "$1" || return 1
  local s=${1#"${1%%[!0]*}"}
  [ "${#s}" -le 12 ]
}

# file_mtime <file> — epoch seconds. GNU `stat -c %Y` first (BSD/macOS stat has no
# -c and fails); `stat -f %m` second (on GNU, -f is filesystem mode and prints junk,
# so every result is validated as all digits).
file_mtime() {
  local mt
  mt=$(stat -c %Y "$1" 2>/dev/null) && digits_only "$mt" && { echo "$mt"; return 0; }
  mt=$(stat -f %m "$1" 2>/dev/null) && digits_only "$mt" && { echo "$mt"; return 0; }
  return 1
}

cmd_report() {
  local agent=${1:-}
  [ -n "$agent" ] || usage
  valid_agent "$agent"
  report_headless "$agent"
}

cmd_status() {
  local a
  for a in $AGENTS; do hl_status_line "$a" status; done
}

# --- config, close -----------------------------------------------------------------------
CONFIG_FILE=".harness/config.json"

# log_close <role> <reason> [runner] — event line in progress.jsonl (key `role`, not
# `agent`, so per-agent ask lookups never match it) + progress.md refresh
log_close() {
  [ -n "$2" ] || return 0
  # no marker side effects: create .harness/ only at a checkout root (an existing one is used as is)
  [ -d .harness/asks ] || [ "$(harness_root "$PWD" 2>/dev/null)" = "$(pwd -P)" ] || return 0
  mkdir -p .harness 2>/dev/null || return 0
  local line
  line=$(jq -n -c --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg role "$1" --arg reason "$2" --arg runner "${3:-}" \
    '{ts: $ts, event: "close", role: $role, reason: $reason}
     + (if $runner != "" then {runner: $runner} else {} end)' 2>/dev/null) || return 0
  printf '%s\n' "$line" >> "$JSONL" 2>/dev/null
  write_progress_md
  lane_mirror "$line"
  return 0
}

cmd_close() {
  local target="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      -*) usage ;;
      *) [ -z "$target" ] || usage; target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || usage
  valid_agent "$target"
  close_headless "$target" "$force"
  exit $?
}

# --- harness checkout: init (decision 0010) -----------------------------------------
# require_checkout — ask acts only in an initialised checkout; run from a subdir,
# they continue at the checkout root (the conductor cannot cd), so .harness/ stays in one place
require_checkout() {
  local root
  root=$(harness_root "$PWD") || die "not a harness checkout (no .harness/asks); run 'harness init' here first"
  [ "$root" = "$(pwd -P)" ] || cd "$root" || die "cannot enter $root"
  root=$(pwd -P)
  # one jq call: warn (never refuse) when this checkout's local settings lack a worker deny rule
  jq -e --argjson d "$HARNESS_DENY_RULES" '($d - (.permissions.deny // [])) | length == 0' \
    .claude/settings.local.json >/dev/null 2>&1 \
    || echo "harness: warning: $root/.claude/settings.local.json lacks the worker deny rules; run 'harness init' again in $root" >&2
  return 0
}

# The worker deny set (#165, decision 0014), one rule per line; `harness init` adds the missing
# ones to .claude/settings.local.json, `harness ask` warns when any is absent. The only place
# that names the blocked commands (the implementer prompt does not).
HARNESS_DENY_RULES='[
  "Bash(git reset *--hard*)",
  "Bash(git clean *)",
  "Bash(git push *--force*)",
  "Bash(git push -f*)",
  "Bash(git push * -f*)",
  "Read(.env)",
  "Read(.env.*)",
  "Read(~/.ssh/**)",
  "Read(~/.aws/**)"
]'

# settings_commit TMP FILE — write TMP into FILE through the file (a symlinked FILE stays a
# symlink, as install.sh does) after one .bak copy of the original (never overwritten)
settings_commit() {
  local tmp=$1 f=$2
  [ -e "$f.bak" ] || cp "$f" "$f.bak" 2>/dev/null || return 1
  cat "$tmp" > "$f"
}

# settings_problem FILE WANT_DENY — print what makes an existing FILE unmergeable (one distinct message
# per case, with the fix) and return 0; return 1 when FILE is absent or mergeable. WANT_DENY=1 also
# checks .permissions (object) and .permissions.deny (array); null counts as absent.
settings_problem() {
  local f=$1 wd=$2 fix="fix or remove the file, then run 'harness init' again"
  [ -e "$f" ] || return 1
  if [ ! -f "$f" ]; then echo "$f is not a regular file; $fix"
  elif [ ! -r "$f" ]; then echo "$f is not readable; $fix"
  elif [ -z "$(tr -d '[:space:]' < "$f" 2>/dev/null)" ]; then echo "$f is empty (not valid JSON); $fix"
  elif ! jq empty "$f" >/dev/null 2>&1; then echo "$f is not valid JSON; $fix"
  elif ! jq -e 'type == "object"' "$f" >/dev/null 2>&1; then echo "$f has a top level that is not an object; $fix"
  elif [ "$wd" = 1 ] && ! jq -e '(.permissions | type) as $t | $t == "null" or $t == "object"' "$f" >/dev/null 2>&1; then
    echo "$f has a permissions that is not an object; make it an object (or remove it), then run 'harness init' again"
  elif [ "$wd" = 1 ] && ! jq -e '(.permissions.deny | type) as $t | $t == "null" or $t == "array"' "$f" >/dev/null 2>&1; then
    echo "$f has a permissions.deny that is not an array; make it an array (or remove it), then run 'harness init' again"
  else return 1; fi
}

# HARNESS_ACW is the conductor's auto-compact window (#276, decision 0018); workers keep 160000 through
# CLAUDE_CODE_AUTO_COMPACT_WINDOW (lib/harness-headless.sh), which beats this key.
HARNESS_ACW=400000

# settings_merge FILE WANT_AGENT WANT_DENY [WANT_ACW] — one pass over FILE: set "agent": "conductor" (WANT_AGENT=1),
# "autoCompactWindow": HARNESS_ACW when absent (WANT_ACW=1; an existing value is kept), and append the missing HARNESS_DENY_RULES to .permissions.deny (WANT_DENY=1), never clobbering other
# keys. The file is read once, written only when its content changes, backed up once (.bak, never
# overwritten). An existing different agent is kept and noted. FILE must pass settings_problem (cmd_init checks first).
settings_merge() {
  local f=$1 wa=$2 wd=$3 wc=${4:-0} cur tmp n msgs=""
  if [ ! -e "$f" ]; then
    mkdir -p "${f%/*}" || { echo "harness init: cannot create ${f%/*}" >&2; return 0; }
    jq -n --argjson wa "$wa" --argjson wd "$wd" --argjson d "$HARNESS_DENY_RULES" \
      --argjson wc "$wc" --argjson acw "$HARNESS_ACW" \
      '(if $wa == 1 then {agent: "conductor"} else {} end) + (if $wc == 1 then {autoCompactWindow: $acw} else {} end) + (if $wd == 1 then {permissions: {deny: $d}} else {} end)' > "$f" || return 0
    [ "$wa" != 1 ] || msgs="agent: conductor"
    [ "$wc" != 1 ] || msgs="${msgs:+$msgs; }autoCompactWindow: $HARNESS_ACW"
    [ "$wd" != 1 ] || msgs="${msgs:+$msgs; }deny rules: $(jq -r 'join(", ")' <<<"$HARNESS_DENY_RULES")"
    echo "created $f ($msgs)"
    return 0
  fi
  if [ "$wc" = 1 ]; then
    cur=$(jq -r '.agent // empty' "$f")
    if [ -n "$cur" ] && [ "$cur" != conductor ]; then
      echo "note: $f sets agent \"$cur\"; autoCompactWindow not set (it is for the conductor session)"; wc=0
    fi
  fi
  if [ "$wa" = 1 ]; then
    cur=$(jq -r '.agent // empty' "$f")
    if [ "$cur" = conductor ]; then echo "$f: agent already conductor"; wa=0
    elif [ -n "$cur" ]; then echo "note: $f sets agent \"$cur\"; kept (use --no-agent to silence this)"; wa=0; fi
  fi
  if [ "$wc" = 1 ]; then
    cur=$(jq -r '.autoCompactWindow // empty' "$f")
    if [ -n "$cur" ]; then echo "$f: autoCompactWindow already $cur"; wc=0; fi
  fi
  if [ "$wd" = 1 ]; then
    n=$(jq -r --argjson d "$HARNESS_DENY_RULES" '$d - (.permissions.deny // []) | join(", ")' "$f")
    [ -n "$n" ] || { echo "$f: deny rules present"; wd=0; }
  fi
  [ "$wa" = 1 ] || [ "$wd" = 1 ] || [ "$wc" = 1 ] || return 0
  tmp=$(mktemp "${TMPDIR:-/tmp}/harness-settings.XXXXXX") || return 0
  [ "$wa" != 1 ] || msgs="agent: conductor"
  [ "$wc" != 1 ] || msgs="${msgs:+$msgs; }set autoCompactWindow $HARNESS_ACW"
  [ "$wd" != 1 ] || msgs="${msgs:+$msgs; }added deny rules: $n"
  if jq --argjson wa "$wa" --argjson wd "$wd" --argjson wc "$wc" --argjson acw "$HARNESS_ACW" --argjson d "$HARNESS_DENY_RULES" \
      '(if $wa == 1 then .agent = "conductor" else . end)
       | (if $wc == 1 then .autoCompactWindow = $acw else . end)
       | if $wd == 1 then .permissions.deny = ((.permissions.deny // []) + ($d - (.permissions.deny // []))) else . end' "$f" > "$tmp" \
     && settings_commit "$tmp" "$f"; then
    echo "updated $f ($msgs; backup $f.bak)"
  else
    echo "harness init: could not update $f" >&2
  fi
  rm -f "$tmp"
}

# --- harness rules block in AGENTS.md (decision 0016, #243) ---
# The block is the template claude/templates/agents-rules.md between two marker lines; text outside the
# markers is never changed. rules_problem: broken markers (checked in the preflight, nothing is changed).
RULES_BEGIN='<!-- harness:rules begin -->'
RULES_END='<!-- harness:rules end -->'

# rules_problem — return 0 (and print why) when AGENTS.md has a broken block: a begin without an end,
# an end first, or more than one begin or end. Marker lines match whole lines only; a trailing CR is ignored.
rules_has_begin() { [ -f AGENTS.md ] && awk -v b="$RULES_BEGIN" '{ sub(/\r$/, "") } $0 == b { f = 1; exit } END { exit !f }' AGENTS.md; }

rules_problem() {
  [ -f AGENTS.md ] || return 1
  awk -v b="$RULES_BEGIN" -v e="$RULES_END" '
    { l = $0; sub(/\r$/, "", l) }
    l == b { nb++; if (!bl) bl = NR }
    l == e { ne++; if (!el) el = NR }
    END { exit !(nb > 1 || ne > 1 || nb != ne || (nb == 1 && el < bl)) }' AGENTS.md || return 1
  echo "AGENTS.md has a broken harness:rules block; fix or remove the markers, then run 'harness init' again"
}

# rules_render TEMPLATE OUT — the new AGENTS.md content in OUT: the block replaced, appended after the
# existing text (one blank line between), or alone when the file is absent or empty.
rules_render() {
  local tpl=$1 out=$2
  if rules_has_begin; then
    # marker lines are printed as they are (a CR stays); the template text between them is written with LF
    awk -v b="$RULES_BEGIN" -v e="$RULES_END" -v tf="$tpl" '
      { m = $0; sub(/\r$/, "", m) }
      m == b { print; while ((getline l < tf) > 0) print l; s = 1; next }
      m == e { s = 0 }
      !s' AGENTS.md > "$out" || return 1
    # awk ends every line with LF: a file that did not end with one keeps its exact tail
    [ -z "$(tail -c1 AGENTS.md)" ] || { head -c "$(( $(wc -c < "$out") - 1 ))" "$out" > "$out.t" && cat "$out.t" > "$out"; rm -f "$out.t"; }
    return 0
  fi
  if [ -s AGENTS.md ]; then
    cat AGENTS.md > "$out"
    [ -z "$(tail -c1 "$out")" ] || echo >> "$out"
    awk 'END { exit !(NR > 0 && $0 == "") }' "$out" || echo >> "$out"
  else : > "$out"; fi
  { printf '%s\n' "$RULES_BEGIN"; cat "$tpl"; printf '%s\n' "$RULES_END"; } >> "$out"
}

# rules_claude_note — warn once when a CLAUDE.md-type file hides AGENTS.md from Claude Code (wiki: agents-md-ignored-when-claude-md-exists)
rules_claude_note() {
  local f first=""
  for f in CLAUDE.md .claude/CLAUDE.md CLAUDE.local.md; do
    [ -f "$f" ] || continue
    grep -qxF '@AGENTS.md' "$f" && return 0
    [ -n "$first" ] || first=$f
  done
  [ -z "$first" ] || echo "warning: $first exists, so Claude Code does not read AGENTS.md here; add this line to $first: @AGENTS.md" >&2
  return 0
}

# rules_apply SHARED — create or update the block in ./AGENTS.md (see the table in decision 0016).
# Sets rules_created=1 when it created the file. Never touches CLAUDE.md.
rules_created=0
rules_apply() {
  local shared=$1 hasblock tpl="$HARNESS_LIB/../claude/templates/agents-rules.md" tmp lane=0 tracked=0 existed=0
  rules_created=0
  if [ ! -f "$tpl" ]; then echo "note: harness rules template not found ($tpl); AGENTS.md skipped" >&2; return 0; fi
  if [ -L AGENTS.md ] && [ ! -e AGENTS.md ]; then echo "note: AGENTS.md is not a regular file; rules block skipped" >&2; return 0; fi
  if [ -e AGENTS.md ] && [ ! -f AGENTS.md ]; then echo "note: AGENTS.md is not a regular file; rules block skipped" >&2; return 0; fi
  [ -f AGENTS.md ] && existed=1
  if git rev-parse --git-dir >/dev/null 2>&1; then
    lane_in_primary || lane=1
    ! git ls-files --error-unmatch AGENTS.md >/dev/null 2>&1 || tracked=1
  fi
  if [ "$lane" = 1 ]; then
    # work folder: never leave a git-visible change (a lane that git does not ignore AGENTS.md in is left alone)
    if [ "$tracked" = 1 ]; then
      # a tracked file whose block already equals the template needs nothing from the primary: stay quiet
      tmp=$(mktemp "${TMPDIR:-/tmp}/harness-rules.XXXXXX") || tmp=""
      if [ -n "$tmp" ] && [ "$existed" = 1 ] && rules_has_begin && rules_render "$tpl" "$tmp" && cmp -s "$tmp" AGENTS.md; then
        rm -f "$tmp"; return 0
      fi
      rm -f "$tmp"
      echo "note: AGENTS.md is tracked; not changed in a work folder (commit the rules from the primary folder)"; return 0
    fi
    if [ "$existed" = 0 ] && ! git check-ignore -q AGENTS.md 2>/dev/null; then
      echo "note: AGENTS.md not created in a work folder; run 'harness init' in the primary folder (or commit AGENTS.md if shared)"; return 0
    fi
  fi
  hasblock=0; [ "$existed" = 1 ] && rules_has_begin && hasblock=1
  tmp=$(mktemp "${TMPDIR:-/tmp}/harness-rules.XXXXXX") || { echo "note: could not write AGENTS.md" >&2; return 0; }
  if ! rules_render "$tpl" "$tmp"; then rm -f "$tmp"; echo "note: could not render AGENTS.md" >&2; return 0; fi
  if [ "$existed" = 1 ] && cmp -s "$tmp" AGENTS.md; then
    echo "AGENTS.md: harness rules up to date"
  elif { cat "$tmp" > AGENTS.md; } 2>/dev/null; then
    if [ "$existed" = 0 ]; then
      rules_created=1
      echo "created AGENTS.md (harness rules)$([ "$shared" = 1 ] && echo '; commit it to share it')"
    elif [ "$hasblock" = 1 ]; then echo "AGENTS.md: updated the harness rules block"
    else echo "AGENTS.md: appended the harness rules block"; fi
    [ "$tracked" = 0 ] || echo "note: AGENTS.md is tracked; the rules change is uncommitted"
  else echo "note: could not write AGENTS.md" >&2; fi
  rm -f "$tmp"
  return 0
}

# cmd_init [--no-agent] [--shared] — make the current repo (git toplevel, else the cwd) a harness
# checkout: .harness/asks/, the default config, "agent": "conductor" and "autoCompactWindow": 400000 (an existing
# value is kept) in .claude/settings.local.json
# (per user, untracked; --shared: .claude/settings.json, committed, never excluded; --no-agent skips
# the key), the worker deny rules (HARNESS_DENY_RULES) in .claude/settings.local.json always, and every
# harness-made path (.harness/, settings.local.json(.bak), agent-memory, docs/superpowers)
# in .git/info/exclude when git does not already ignore it. AGENTS.md gets the harness rules block
# (rules_apply; the file it creates is excluded unless --shared; in a work folder it never leaves a git-visible
# change; CLAUDE.md is never edited). Idempotent. Fails (exit 1, nothing created or changed) when a settings
# file it must write is unmergeable (settings_problem) or AGENTS.md has a broken rules block (rules_problem).
cmd_init() {
  [ "${HARNESS_ROLE:-}" != worker ] || die "harness init is for the conductor; a worker (HARNESS_ROLE=worker) does not set up checkouts"
  local agent=1 shared=0 a p top ex target=.claude/settings.local.json
  for a in "$@"; do
    case "$a" in --no-agent) agent=0 ;; --shared) target=.claude/settings.json; shared=1 ;; *) usage ;; esac
  done
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
  cd "$top" || die "cannot enter $top"
  # check every settings file init must write before creating anything: an unmergeable one fails init
  local bad="" m
  if [ "$target" = .claude/settings.local.json ]; then m=$(settings_problem "$target" 1) && bad=$m
  else
    if [ "$agent" = 1 ] && m=$(settings_problem "$target" 0); then bad=$m; fi
    if m=$(settings_problem .claude/settings.local.json 1); then bad="${bad:+$bad
}$m"; fi
  fi
  if m=$(rules_problem); then bad="${bad:+$bad
}$m"; fi
  if [ -n "$bad" ]; then
    echo "harness init: $top: nothing changed" >&2
    printf 'harness init: %s\n' "$bad" >&2
    return 1
  fi
  echo "harness init: $top"
  if [ -d .harness/asks ]; then echo ".harness/asks exists"
  else mkdir -p .harness/asks || die "cannot create .harness/asks"; echo "created .harness/asks"; fi
  # autoCompactWindow (#276): only for the conductor session (settings_merge skips a foreign agent), and a
  # value in the tracked settings.json is respected: local outranks it, so nothing is written to local then.
  # In a work folder the tracked file is never given the window (decision 0018 D2); the local file gets it
  # unless the tracked file names a foreign agent and the local one does not name the conductor (#283).
  local acw_sh=$agent acw_loc=$agent acw_t acw_ta acw_la
  acw_t=$(jq -r '.autoCompactWindow // empty' .claude/settings.json 2>/dev/null)
  if [ "$shared" = 0 ]; then acw_sh=0
  elif git rev-parse --git-dir >/dev/null 2>&1 && ! lane_in_primary; then acw_sh=0; fi
  if [ "$acw_sh" = 1 ]; then acw_loc=0
  elif [ "$agent" = 1 ] && [ -n "$acw_t" ]; then echo ".claude/settings.json: autoCompactWindow already $acw_t"; acw_loc=0
  elif [ "$agent" = 1 ] && [ "$shared" = 1 ]; then
    acw_ta=$(jq -r '.agent // empty' .claude/settings.json 2>/dev/null)
    acw_la=$(jq -r '.agent // empty' .claude/settings.local.json 2>/dev/null)
    if [ -n "$acw_ta" ] && [ "$acw_ta" != conductor ] && [ "$acw_la" != conductor ]; then
      echo "note: .claude/settings.json sets agent \"$acw_ta\"; autoCompactWindow not set (it is for the conductor session)"; acw_loc=0
    fi
  fi
  if [ "$shared" = 0 ]; then settings_merge "$target" "$agent" 1 "$acw_loc"
  else
    [ "$agent" = 0 ] || settings_merge "$target" 1 0 "$acw_sh"
    settings_merge .claude/settings.local.json 0 1 "$acw_loc"
  fi
  rules_apply "$shared"
  [ ! -e AGENTS.md ] || rules_claude_note
  if git rev-parse --git-dir >/dev/null 2>&1; then
    ex=$(git rev-parse --git-path info/exclude 2>/dev/null)
    local list=".harness/ .claude/settings.local.json .claude/settings.local.json.bak .claude/agent-memory/ docs/superpowers/"
    [ "$rules_created" = 1 ] && [ "$shared" = 0 ] && list="$list AGENTS.md"
    for a in $list; do
      case "$a" in */) p=${a}x ;; *) p=$a ;; esac
      if git check-ignore -q "$p" 2>/dev/null; then echo "$a already ignored by git"
      elif [ -n "$ex" ] && mkdir -p "${ex%/*}" && printf '%s\n' "$a" >> "$ex"; then echo "added $a to $ex"
      else echo "note: could not add $a to git's exclude file" >&2; fi
    done
  fi
  echo "workers run as detached headless Claude sessions: watch a run with 'harness watch <role>'"
  return 0
}

need jq
# help: usage on stdout, exit 0 (reads and writes nothing); also after -C DIR below
case "${1:-}" in help|--help|-h) usage help ;; esac
# global -C DIR (like git -C): every subcommand then runs in DIR, whose .harness/ state is its own
if [ "${1:-}" = -C ]; then
  [ -n "${2:-}" ] || usage
  cd "$2" 2>/dev/null || die "cannot enter $2"
  shift 2
  case "${1:-}" in help|--help|-h) usage help ;; esac
fi
# _defaults prints the shared defaults as KEY=VALUE (tests: prose copies are checked against it)
if [ "${1:-}" = _defaults ]; then
  for k in $(compgen -v HARNESS_ | grep -E '^HARNESS_(ROLES|[A-Z_]+_(MS|DEFAULT))$' | sort); do eval "printf '%s=%s\n' \"$k\" \"\${$k}\""; done
  exit 0
fi
# init is file work: no checkout needed
if [ "${1:-}" = init ]; then shift; cmd_init "$@"; exit $?; fi
# lane works on git worktrees from anywhere
if [ "${1:-}" = lane ]; then shift; cmd_lane "$@"; exit $?; fi
# wiki-lint is pure file checking
if [ "${1:-}" = wiki-lint ]; then shift; cmd_wiki_lint "$@"; exit $?; fi
# metrics reads files only
if [ "${1:-}" = metrics ]; then shift; cmd_metrics "$@"; exit $?; fi

# ask acts only in an initialised checkout (decision 0010); status/report/close work anywhere
case "${1:-}" in
  ask) [ "${HARNESS_ROLE:-}" = worker ] || require_checkout ;;
esac
case "${1:-}" in
  ask)    shift; cmd_ask "$@" ;;
  report) shift; cmd_report "$@" ;;
  wait)   shift; cmd_wait "$@" ;;
  watch)  shift; cmd_watch "$@" ;;
  open-watch) shift; cmd_open_watch "$@" ;;
  status) cmd_status ;;
  close)  shift; cmd_close "$@" ;;
  *)      usage ;;
esac
exit $?
}
