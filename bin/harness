#!/bin/bash
# The body is one brace group: bash parses the whole file before running any of it, so a
# tool that rewrites this file in place cannot corrupt a run in progress (wiki: troubleshooting).
{
# harness — conductor-side wrapper for detached headless Claude workers (decision 0011).
#
#   harness ask    <agent> '<instruction>' [--timeout MS] [--fresh|--keep]
#     default --timeout = the role's headless run cap (a background ask returns when the run ends):
#     implementer 5400000, analyst/reviewer 3600000
#   harness report <agent>
#   harness wait   <agent> [--timeout MS]   block until the run ends (0 done, 3 no ask/gone, 4 timeout); does not collect
#   harness watch  <agent> [-n N]   human terminal only: follow a live run, or the last N lines of a finished one
#   harness status
#   harness init [--no-agent] [--shared]   make this repo a harness checkout (.harness/asks, config, agent=conductor in .claude/settings.local.json; --shared: settings.json)
#   harness close  <agent>|--all [--force]
#   harness metrics [--since YYYY-MM-DD] [--json]   health numbers from progress.jsonl + the wiki
#   harness wiki-lint [DIR]   check docs/wiki format and limits (0 = pass)
#
# Exit codes for `ask`: 0 report printed · 1 usage/setup error
#                       2 the run was denied a tool call and wrote no report (re-ask with a changed brief)
#                       3 worker finished without a report
#                       4 run still going / unknown (a background ask returns when the run ends)
#                       5 verification failed (implementer's checks gave up, or the
#                         reviewer's last line is `VERDICT: FAIL`); the report is
#                         still printed on stdout. A reviewer report without a
#                         final VERDICT line counts as no valid report (3).
# `report` prints .harness/reports/<agent>.md with the same exit codes as `ask`
#   (0 · 3 no report/no VERDICT · 5 verification failed), plus 4 while the run is
#   still going. It never sends a prompt.
# Workers (HARNESS_ROLE=worker) may not ask: skills are user-global and would otherwise nest.
# .harness/ lives in the checkout root: `harness init` creates it; ask refuses without it
# and, run from a subdir of the checkout, continues at the root.
# Every ask is logged to .harness/log/ and .harness/progress.jsonl, and
# .harness/progress.md is regenerated (log errors only warn on stderr).
# Config: .harness/config.json (`viewer`: auto|pane|none; a viewer is a herdr pane running
#   `harness watch <role>`; the harness never closes it). `harness close` refuses (exit 4) a
#   running ask or an uncollected report unless --force. Closes are logged to progress.jsonl.
# Output of `ask`: stdout = report on exit 0 and 5; diagnostics on stderr.
set -u

# lib/ is sourced eagerly, here, inside the brace group: bash 3.2 reads a sourced file whole,
# so an in-place edit cannot corrupt the run (a lazily sourced file would lose that protection).
# The symlinked $0 is resolved by hand (no readlink -f on old macOS).
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  case $src in */*) d=$(CDPATH= cd -P "${src%/*}" && pwd) ;; *) d=$PWD ;; esac
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$d/$src ;; esac
done
case $src in */*) d=${src%/*} ;; *) d=. ;; esac   # no dirname: PATH may be bare in hooks/tests
HARNESS_LIB=${HARNESS_LIB:-$(CDPATH= cd -P "$d/../lib" 2>/dev/null && pwd)}
# Explicit list, fixed order, no glob: a stray file in lib/ is never sourced. Definitions only.
for m in defaults root metrics headless dash; do
  . "$HARNESS_LIB/harness-$m.sh" 2>/dev/null || { echo "harness: cannot load lib/harness-$m.sh" >&2; exit 1; }
done
unset src d m
# end loader

AGENTS=$HARNESS_ROLES
REPORT_DIR=".harness/reports"
LOG_DIR=".harness/log"
JSONL=".harness/progress.jsonl"
PROGRESS_MD=".harness/progress.md"
DEFAULT_TIMEOUT=$HARNESS_DEFAULT_TIMEOUT_MS
IMPLEMENTER_TIMEOUT=$HARNESS_IMPLEMENTER_TIMEOUT_MS
ASK_DIR=".harness/asks"
# parsed once by ask_parse_args (cmd_ask); ask_inner only reads them
ASK_TIMEOUT=$DEFAULT_TIMEOUT; ASK_TIMEOUT_SET=0; ASK_FRESH=0; ASK_KEEP=0; ASK_BAD=0

usage() {
  cat >&2 <<EOF
usage:
  harness ask    <agent> '<instruction>' [--timeout MS (default: implementer $IMPLEMENTER_TIMEOUT, others $DEFAULT_TIMEOUT)] [--fresh|--keep]
  harness report <agent>
  harness wait   <agent> [--timeout MS]
  harness watch  <agent> [-n N]   (human terminal only)
  harness status
  harness init   [--no-agent] [--shared]   (once per repo: makes it a harness checkout; ask refuses without it)
  harness close  <agent>|--all [--force]
  harness wiki-lint [DIR]
  harness metrics [--since YYYY-MM-DD] [--json]
agents: $AGENTS
EOF
  exit 1
}

die() { echo "harness: $*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"; }

# herdr_env_ok — herdr can be talked to: HERDR_ENV=1 and the binary exists. Never execs herdr
# otherwise (a real herdr may be on the PATH of a test or a worker).
herdr_env_ok() { [ "${HERDR_ENV:-}" = 1 ] && command -v herdr >/dev/null 2>&1; }
# herdr_usable — herdr_env_ok, and not a worker: a run may be shown in a viewer pane
herdr_usable() { herdr_env_ok && [ "${HARNESS_ROLE:-}" != worker ]; }   # a viewer pane may be opened
valid_agent() {
  case " $AGENTS " in
    *" $1 "*) return 0 ;;
  esac
  die "unknown agent '$1' (expected one of: $AGENTS)"
}

# Terminal cells are roughly twice as tall as wide; a pane is "wide" when
# width >= 2.2 * height. Wide -> split right, otherwise down.
# Without HERDR_PANE_ID there is no pane to measure: default to right.
pick_direction() {
  local layout w h
  [ -n "${HERDR_PANE_ID:-}" ] || { echo right; return; }
  layout=$(herdr pane layout --pane "${HERDR_PANE_ID:-}" 2>/dev/null) || { echo right; return; }
  w=$(printf '%s' "$layout" | jq -r --arg p "${HERDR_PANE_ID:-}" '.result.layout.panes[] | select(.pane_id==$p) | .rect.width' 2>/dev/null)
  h=$(printf '%s' "$layout" | jq -r --arg p "${HERDR_PANE_ID:-}" '.result.layout.panes[] | select(.pane_id==$p) | .rect.height' 2>/dev/null)
  if [ -n "$w" ] && [ -n "$h" ] && [ "$w" -ge $((h * 22 / 10)) ]; then
    echo right
  else
    echo down
  fi
}

# fmt_ctx <tokens> — "137k", or "-" when unknown
fmt_ctx() {
  case "${1:-}" in
    ''|*[!0-9]*) echo - ;;
    *) echo "$(($1 / 1000))k" ;;
  esac
}

# last_ask_record <agent> [--where JQ] [--field JQ]
# The newest progress line of <agent> among the last 200 non-close lines that has no ask_id
# (old rows: the removed --worktree asks logged `agent: <role>` plus an ask_id and must never
# stand in for a plain ask) and matches the extra jq condition --where. Prints --field (default: the compact line); nothing = unknown.
# --where/--field are jq source from the caller's own literals.
last_ask_record() {
  local agent=$1 where=true field=. prog
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --where) where=$2; shift 2 ;;
      --field) field=$2; shift 2 ;;
      *) return 2 ;;
    esac
  done
  prog="fromjson? | select(type == \"object\" and .agent == \$a and (.ask_id // \"\") == \"\") | select($where) | $field"
  grep -v '"event":"close"' "$JSONL" 2>/dev/null | tail -n 200 \
    | jq -R -r -c --arg a "$agent" "$prog" 2>/dev/null | tail -n 1
}

# last_exit <agent> — exit code of the agent's last logged ask (old rows with an ask_id are skipped); nothing when unknown
last_exit() {
  last_ask_record "$1" --where '(.exit | type) == "number"' --field .exit
}

# --- progress log ----------------------------------------------------------------------

git_head() { git rev-parse --short HEAD 2>/dev/null || true; }
# file_sum <file> — cksum "crc-size" of a file (portable), empty if unreadable
file_sum() { cksum < "$1" 2>/dev/null | awk '{ print $1 "-" $2 }'; }
num_or_null() { case "${1:-}" in ''|*[!0-9]*) echo null ;; *) echo "$1" ;; esac; }

# record_progress <agent> <text> <rc> <t0> <head_before> <stdout-file>
# Writes the log file + jsonl line, rotates, regenerates progress.md.
record_progress() {
  local agent=$1 text=$2 rc=$3 t0=$4 hb=$5 out=$6 cb=
  local report="$REPORT_DIR/$agent.md" vj=.harness/verify/implementer.json rmt
  local now ts stamp ha sess ca status="" summary="" verify="" logf n brief sha="" va="" hl='{}'
  now=$(date +%s)
  # a report older than this ask is a previous ask's (this one died before archiving it)
  if [ -f "$report" ]; then rmt=$(file_mtime "$report") && [ "$rmt" -ge "$t0" ] || report=/dev/null.none; fi
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  stamp=$(date +%Y%m%d-%H%M%S)
  ha=$(git_head)
  # session and context come from the run's exit.json
  hl=$(hl_progress_obj "$agent" "$t0")
  sess=$(printf '%s' "$hl" | jq -r '.session // empty' 2>/dev/null)
  ca=$(printf '%s' "$hl" | jq -r '.ctx_after // empty' 2>/dev/null)
  cb=$(sed -n 's/^ctx_before=//p' "$ASK_DIR/$agent.run" 2>/dev/null | head -n 1)
  hl=$(printf '%s' "$hl" | jq -c 'del(.session, .ctx_after)' 2>/dev/null) || hl='{}'
  if [ -f "$report" ]; then
    status=$(sed -n 's/^status: *//p' "$report" | head -n 1)
    summary=$(sed -n 's/^# *//p' "$report" | head -n 1)
    sha=$(file_sum "$report")
  fi
  if [ "$agent" = implementer ]; then
    verify=$(jq -r '.status // empty' "$vj" 2>/dev/null)
    va=$(jq -r '.attempts // empty' "$vj" 2>/dev/null)
    grep -q '^verify: INTERRUPTED' "$out" 2>/dev/null && verify=interrupted
  fi

  mkdir -p "$LOG_DIR" || return 1
  logf="$LOG_DIR/$stamp-$agent.md"; n=1
  while [ -e "$logf" ]; do n=$((n + 1)); logf="$LOG_DIR/$stamp-$agent-$n.md"; done
  brief=$(printf '%s' "$text" | grep -o '\.harness/task-[A-Za-z0-9_.-]*\.md' | head -n 1)
  {
    printf '# %s ask %s (exit %s, %ss)\n\n## Instruction\n\n%s\n' "$agent" "$ts" "$rc" "$((now - t0))" "$text"
    if [ -n "$brief" ] && [ -f "$brief" ]; then
      printf '\n## Brief (%s)\n\n' "$brief"; cat "$brief"
    fi
    if [ -f "$report" ]; then
      printf '\n## Report\n\n'; cat "$report"
    else
      printf '\n## Screen / output (no report)\n\n'; cat "$out"
      if [ "$hl" != '{}' ]; then
        printf '\n## Run output (last 40 lines)\n\n'
        hl_view_tail "$agent" 40
      fi
    fi
    if [ -s "${ASK_ERR:-}" ]; then
      printf '\n## Errors\n\n'; cat "$ASK_ERR"
    fi
    if [ "$hl" != '{}' ]; then
      printf '\n## Run\n\n'
      printf '%s' "$hl" | jq -r '"result \(.result // "-"), turns \(.turns // "-"), cost $\(.cost_usd // "-"), stream \(.stream_log // "-")"' 2>/dev/null
    fi
  } > "$logf" || return 1

  # rotate the jsonl first so the new line lands in the fresh file
  if [ -f "$JSONL" ] && [ "$(wc -c < "$JSONL" | tr -d ' ')" -gt "${HARNESS_JSONL_MAX:-1048576}" ]; then
    mv "$JSONL" "$JSONL.$stamp" && gzip -f "$JSONL.$stamp"
  fi
  jq -n -c --arg ts "$ts" --arg agent "$agent" --arg session "$sess" \
    --arg instr "$(printf '%s' "$text" | tr '\n' ' ' | cut -c1-160)" \
    --argjson exit "$rc" --arg verify "$verify" --argjson dur "$((now - t0))" \
    --arg hb "$hb" --arg ha "$ha" --argjson cb "$(num_or_null "$cb")" --argjson ca "$(num_or_null "$ca")" \
    --arg status "$status" --arg summary "$summary" --arg sha "$sha" --argjson va "$(num_or_null "$va")" \
    --argjson hl "$hl" '
    def nz: if . == "" then null else . end;
    {ts: $ts, agent: $agent, session: ($session | nz), instr: $instr, exit: $exit,
     verify: ($verify | nz), verify_attempts: $va, dur_s: $dur, head_before: ($hb | nz), head_after: ($ha | nz),
     ctx_before: $cb, ctx_after: $ca, status: ($status | nz), summary: ($summary | nz), report_sha: ($sha | nz)} + $hl' >> "$JSONL" || return 1

  rotate_logs "$logf"
  write_progress_md
  return 0
}

# ask_parse_args <agent> <text> [opts...] — the one walk over an ask's options (called by cmd_ask
# after the agent and text checks). Sets ASK_TIMEOUT/FRESH/KEEP.
# The instruction text is positional, so an option-looking word inside it is never an option. A bad option,
# --timeout value or --fresh with --keep only sets ASK_BAD: ask_inner turns that into the usage
# error inside the logged subshell (exit 1 is recorded in progress).
ask_parse_args() {
  local agent=$1
  shift 2
  ASK_FRESH=0; ASK_KEEP=0; ASK_BAD=0
  ASK_TIMEOUT=$DEFAULT_TIMEOUT; ASK_TIMEOUT_SET=0
  [ "$agent" != implementer ] || ASK_TIMEOUT=$IMPLEMENTER_TIMEOUT
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout)
        case "${2:-}" in
          ''|*[!0-9]*|0) ASK_BAD=1; shift ;;     # missing/invalid value: usage (logged)
          *) ASK_TIMEOUT=$2; ASK_TIMEOUT_SET=1; shift 2 ;;
        esac ;;
      --fresh) ASK_FRESH=1; shift ;;
      --keep) ASK_KEEP=1; shift ;;
      *) ASK_BAD=1; shift ;;
    esac
  done
  [ "$ASK_FRESH$ASK_KEEP" != 11 ] || ASK_BAD=1
}

# rotate_logs <current-log> — newest N logs kept, older than D days deleted; raw headless
# streams are gzipped once a day old and dropped with the logs
rotate_logs() {
  local f
  ls -1t "$LOG_DIR"/*.md 2>/dev/null | grep -vxF -- "$1" | tail -n +"${HARNESS_LOG_KEEP:-200}" \
    | while IFS= read -r f; do rm -f "$f"; done
  find "$LOG_DIR" -name '*.md' -mtime "+${HARNESS_LOG_DAYS:-14}" 2>/dev/null \
    | grep -vxF -- "$1" | while IFS= read -r f; do rm -f "$f"; done
  find "$LOG_DIR" -name '*.jsonl' -mtime +0 2>/dev/null | while IFS= read -r f; do gzip -f "$f" 2>/dev/null; done
  find "$LOG_DIR" \( -name '*.jsonl' -o -name '*.jsonl.gz' \) -mtime "+${HARNESS_LOG_DAYS:-14}" 2>/dev/null \
    | while IFS= read -r f; do rm -f "$f"; done
  return 0
}

# write_progress_md — regenerate .harness/progress.md (<= 60 lines)
write_progress_md() {
  local tmp="$PROGRESS_MD.tmp.$$" branch goal a f q line=""
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
  goal="(unset)"
  if [ -s .harness/goal.md ]; then
    goal=$(tr '\n' ' ' < .harness/goal.md | sed 's/  */ /g; s/ $//' | cut -c1-400)
  fi
  {
    printf '# Progress — %s (%s)\n' "$(basename "$PWD")" "$branch"
    printf 'Goal: %s\n' "$goal"
    printf '## Recent asks (newest first, max 15)\n'
    grep -v '"event":"close"' "$JSONL" 2>/dev/null | tail -n 15 | jq -r -R 'fromjson? | "- \(.ts) \(.agent) \(if .late then "late report" else "exit \(.exit)" end) verify \(.verify // "-") \(.head_before // "")..\(.head_after // "") — \(.summary // "")"' 2>/dev/null \
      | awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) print a[i] }'
    q=$(grep '"event":"close"' "$JSONL" 2>/dev/null | tail -n 5 | jq -r -R 'fromjson? | "\(.ts) \(.role) (\(.reason // "?"))"' 2>/dev/null \
      | awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) printf "%s%s", (i == NR ? "" : "; "), a[i]; if (NR) print "" }')
    [ -z "$q" ] || printf 'Recent closes (max 5): %s\n' "$q"
    for f in $(ls -t .harness/reports/*.md 2>/dev/null); do
      q=$(awk '/^## Open questions/ { on = 1; next } /^## / { on = 0 } on && /^- / { if (tolower($0) !~ /^- *none *$/) print }' "$f" | head -n 10)
      if [ -n "$q" ]; then
        printf '## Open questions (from %s)\n%s\n' "$(basename "$f" .md)" "$q"
        break
      fi
    done
    printf '## Workers\n'
    for a in $AGENTS; do
      q=$(hl_status_line "$a" progress)
      if [ -z "$line" ]; then line=$q; else line="$line · $q"; fi
    done
    printf -- '- %s\n' "$line"
  } 2>/dev/null | head -n 60 > "$tmp" && mv "$tmp" "$PROGRESS_MD"
}

# verify_tool ARGS... — run harness-verify from PATH (installed by ./install.sh)
verify_tool() {
  command -v harness-verify >/dev/null 2>&1 || return 1
  harness-verify "$@"
}

# restore_interrupted <agent> <report> — implementer only: the Stop hook hides the
# report as <report>.pending while it verifies. If the hook was killed, only the
# .pending file is left: restore it and exit 5. Callers must have checked the agent
# is idle/done (a working agent may still be verifying; never restore then).
restore_interrupted() {
  [ "$1" = implementer ] && [ ! -f "$2" ] && [ -f "$2.pending" ] || return 0
  mv -f "$2.pending" "$2"
  stamp_finished "$1"
  cat "$2"
  echo "verify: INTERRUPTED"
  exit 5
}

# learned_has_evidence <text> — the bullet cites an ask-id, a commit (7-40 hex with a
# letter a-f and a digit, standalone), path/file.ext:line (path has a / or an extension),
# a .harness/ path or a .log file. `step:2`, `host:8080` and bare numbers do not count.
learned_has_evidence() {
  printf '%s\n' "$1" | grep -Eq '(^|[^0-9])[0-9]{9,}-[0-9]+-[0-9]+|[A-Za-z0-9_.-]*/[A-Za-z0-9_./-]*:[0-9]+|[A-Za-z0-9_-]+\.[A-Za-z][A-Za-z0-9]{0,4}:[0-9]+|\.harness/|\.log([^A-Za-z]|$)' && return 0
  printf '%s\n' "$1" | grep -Eo '(^|[^0-9A-Za-z])[0-9a-f]{7,40}($|[^0-9A-Za-z])' | grep '[0-9]' | grep -q '[a-f]' && return 0
  return 1
}

# queue_learned <agent> <report> — copy up to 2 evidence-backed bullets of the
# report's optional `## Notes` section (legacy `## Learned` is also accepted) to docs/wiki/inbox/<date>-<role>-<ask-id>.md,
# only when docs/wiki/ already exists at the repo top level. Indented continuation
# lines are joined to their bullet. Prints one stdout line when queued; bullets
# without evidence are dropped with a one-line stderr warning. Never fails the
# caller (idempotent per role+ask-id; no ask-id -> skipped with a warning).
queue_learned() {
  local agent=$1 report=$2 raw line kept="" n=0 dropped=0 askid date out top
  raw=$(awk '
    function flush() { if (cur != "") print cur; cur = "" }
    /^## (Learned|Notes)[ \t]*$/ { on = 1; next }
    on && (/^## / || /^VERDICT:/) { flush(); on = 0 }
    on && /^[ \t]*[-*] / { flush(); cur = $0; sub(/^[ \t]*[-*] +/, "- ", cur); next }
    on && cur != "" && /^[ \t]+[^ \t]/ { t = $0; sub(/^[ \t]+/, "", t); cur = cur " " t; next }
    on && /^[ \t]*$/ { flush() }
    END { flush() }
  ' "$report" 2>/dev/null) || return 0
  [ -n "$raw" ] || return 0
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
  [ -d "$top/docs/wiki" ] || return 0
  while IFS= read -r line; do
    case "$line" in "- none"|"- None"|"- none."|"- -") continue ;; esac
    if learned_has_evidence "$line"; then
      n=$((n + 1))
      [ "$n" -le 2 ] && kept="$kept$line
"
    else
      dropped=$((dropped + 1))
    fi
  done <<EOF_LEARNED
$raw
EOF_LEARNED
  [ "$dropped" -eq 0 ] || echo "harness: wiki: dropped $dropped Notes bullet(s) without evidence (ask-id, commit, file:line or log)" >&2
  [ -n "$kept" ] || return 0
  askid=$(awk 'NR == 1 { print $1 }' "$ASK_DIR/$agent.current" 2>/dev/null)
  if [ -z "$askid" ]; then
    echo "harness: wiki: no ask-id for $agent; Notes bullets not queued" >&2
    return 0
  fi
  date=$(date +%Y-%m-%d)
  # shellcheck disable=SC2144
  ls "$top"/docs/wiki/inbox/*-"$agent-$askid".md >/dev/null 2>&1 && return 0
  out="docs/wiki/inbox/$date-$agent-$askid.md"
  mkdir -p "$top/docs/wiki/inbox" 2>/dev/null || return 0
  { printf -- '---\nrole: %s\nask-id: %s\ndate: %s\n---\n' "$agent" "$askid" "$date"; printf '%s' "$kept"; } > "$top/$out" 2>/dev/null || return 0
  n=$(printf '%s' "$kept" | grep -c '^- ')
  echo "wiki: $n lesson$([ "$n" -eq 1 ] || echo s) queued in $out"
}

# finish_report <agent> <report> — print the report and exit with the
# verification-aware status (0 pass · 3 reviewer without VERDICT · 5 failed)
finish_report() {
  local agent=$1 report=$2 last vj st
  queue_learned "$agent" "$report"
  case "$agent" in
    implementer)
      vj=".harness/verify/implementer.json"
      st=$(jq -r '.status // empty' "$vj" 2>/dev/null)
      cat "$report"
      if [ "$st" = fail ]; then
        echo "verify: FAIL ($(jq -r '.step // "?"' "$vj" 2>/dev/null), $(jq -r '.attempts // 0' "$vj" 2>/dev/null) attempts)"
        exit 5
      fi
      exit 0 ;;
    reviewer)
      last=$(awk 'NF { l = $0 } END { print l }' "$report")
      case "$last" in
        "VERDICT: PASS") cat "$report"; exit 0 ;;
        "VERDICT: FAIL") cat "$report"; exit 5 ;;
      esac
      echo "harness: reviewer report has no final 'VERDICT: PASS|FAIL' line; ask it to rewrite the report." >&2
      exit 3 ;;
  esac
  cat "$report"
  exit 0
}

# kill_tree <pid> — TERM pid and all its descendants (macOS has no setsid)
kill_tree() {
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done
  kill "$1" 2>/dev/null
  return 0
}

# ask_finish [rc] — replay the buffered stdout, log the ask, remove the temp
# file, exit. Runs once: normally after the inner ask, or from the EXIT/TERM/INT
# trap when the wrapper is killed mid-wait (rc 143/130 then).
ask_finish() {
  [ "$ASK_DONE" = 0 ] || return 0
  ASK_DONE=1
  local rc=${1:-1}
  if [ -n "$ASK_PID" ] && kill -0 "$ASK_PID" 2>/dev/null; then
    kill_tree "$ASK_PID"
  fi
  cat "$ASK_TMP" 2>/dev/null
  if [ -n "${ASK_ERR:-}" ] && [ -f "$ASK_ERR" ]; then cat "$ASK_ERR" >&2; fi
  record_progress "$ASK_AGENT" "$ASK_TEXT" "$rc" "$ASK_T0" "$ASK_HB" "$ASK_TMP" \
    || echo "harness: could not write the progress log (ask result unchanged)" >&2
  rm -f "$ASK_TMP" "${ASK_ERR:-}"
  # a printed report (0, or 5 = failed verification/FAIL verdict) counts as collected
  case "$rc" in 0|5) stamp_finished "$ASK_AGENT" ;; esac
  exit "$rc"
}

# cmd_ask — runs ask_inner (which exits through many paths) in a background
# subshell and waits, then logs the outcome. Output and exit code are the inner
# ones; logging problems only warn on stderr.
cmd_ask() {
  [ "${HARNESS_ROLE:-}" != worker ] || die "harness ask is for the conductor; a worker (HARNESS_ROLE=worker) does its task itself"
  local agent=${1:-} text=${2:-}
  case " $AGENTS " in *" $agent "*) ;; *) ask_inner "$@" ;; esac
  [ -n "$text" ] || ask_inner "$@"
  ask_parse_args "$@"
  ASK_TMP=$(mktemp "${TMPDIR:-/tmp}/harness-ask.XXXXXX") || ask_inner "$@"
  ASK_AGENT=$agent ASK_TEXT=$text ASK_DONE=0 ASK_PID=""
  ASK_T0=$(date +%s); ASK_HB=$(git_head)
  trap 'ask_finish 143' TERM
  trap 'ask_finish 130' INT
  trap 'ask_finish 129' HUP
  trap 'ask_finish "$?"' EXIT
  ASK_ERR=$(mktemp "${TMPDIR:-/tmp}/harness-err.XXXXXX") || ASK_ERR=   # not harness-ask.*: tests glob that prefix
  ( ask_inner "$@" ) > "$ASK_TMP" 2> "${ASK_ERR:-/dev/null}" &
  ASK_PID=$!
  wait "$ASK_PID"
  ask_finish "$?"
}

ask_inner() {
  local agent=${1:-} text=${2:-} timeout=$ASK_TIMEOUT fresh=$ASK_FRESH keep=$ASK_KEEP
  [ -n "$agent" ] && [ -n "$text" ] || usage
  valid_agent "$agent"
  [ "$ASK_BAD" = 0 ] || usage      # a bad option found by ask_parse_args: usage error, logged

  if [ "$agent" = implementer ] && ! command -v harness-verify >/dev/null 2>&1; then
    die "harness-verify not found on PATH; run ./install.sh (the implementer's checks would silently not run)"
  fi

  ask_headless "$agent" "$text" "$timeout" "$fresh" "$keep"
}

# digits_only <string> — succeed only for a non-empty all-digit string
digits_only() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
}

# file_mtime <file> — epoch seconds. GNU `stat -c %Y` first (BSD/macOS stat has no
# -c and fails); `stat -f %m` second (on GNU, -f is filesystem mode and prints junk,
# so every result is validated as all digits).
file_mtime() {
  local mt
  mt=$(stat -c %Y "$1" 2>/dev/null) && digits_only "$mt" && { echo "$mt"; return 0; }
  mt=$(stat -f %m "$1" 2>/dev/null) && digits_only "$mt" && { echo "$mt"; return 0; }
  return 1
}

cmd_report() {
  local agent=${1:-}
  [ -n "$agent" ] || usage
  valid_agent "$agent"
  report_headless "$agent"
}

cmd_status() {
  local a
  for a in $AGENTS; do hl_status_line "$a" status; done
}

# --- config, close -----------------------------------------------------------------------
CONFIG_FILE=".harness/config.json"

# config_template — the documented default config (what ensure_config writes)
config_template() {
  cat <<'EOC'
{
  "_doc": "viewer: auto | pane | none. Where a run is shown: a herdr pane running `harness watch <role>` (auto = a pane when herdr is usable, else none). Env override: HARNESS_VIEWER.",
  "viewer": "auto"
}
EOC
}

# ensure_config — create the documented default config when absent (never fatal); an existing
# file is never touched.
ensure_config() {
  # Never creates .harness/ (stray dirs break harness-verify's root lookup): `harness init`
  # does that. Workers and anything outside an initialised checkout (no .harness/asks) skip.
  [ "${HARNESS_ROLE:-}" != worker ] || return 0
  [ -d .harness/asks ] || return 0
  [ -e "$CONFIG_FILE" ] || config_template > "$CONFIG_FILE" 2>/dev/null
  return 0
}

# stamp_finished <agent> — mark the agent's report as collected now;
# .harness/asks/<agent>.finished mtime = idle-since
stamp_finished() {
  mkdir -p .harness/asks 2>/dev/null && : > ".harness/asks/$1.finished" 2>/dev/null
  return 0
}

# has_uncollected <agent> — 0 when the agent has a report nobody collected: a
# .pending file, or a report that no collected-stamp covers (missing stamp, report
# newer than the stamp, or a newer ask in flight)
has_uncollected() {
  local r="$REPORT_DIR/$1.md" f=".harness/asks/$1.finished" c=".harness/asks/$1.current"
  [ -f "$r.pending" ] && return 0
  [ -f "$r" ] || return 1
  [ -f "$f" ] || return 0
  [ "$r" -nt "$f" ] && return 0
  [ -f "$c" ] && [ "$f" -ot "$c" ] && return 0
  return 1
}

# log_close <role> <pane> <reason> [runner] — event line in progress.jsonl (key `role`, not
# `agent`, so per-agent ask lookups never match it) + progress.md refresh
log_close() {
  [ -n "$3" ] || return 0
  # no marker side effects: create .harness/ only at a checkout root (an existing one is used as is)
  [ -d .harness/asks ] || [ "$(harness_root "$PWD" 2>/dev/null)" = "$(pwd -P)" ] || return 0
  mkdir -p .harness 2>/dev/null || return 0
  jq -n -c --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg role "$1" --arg pane "$2" --arg reason "$3" --arg runner "${4:-}" \
    '{ts: $ts, event: "close", role: $role, pane: $pane, reason: $reason}
     + (if $runner != "" then {runner: $runner} else {} end)' >> "$JSONL" 2>/dev/null
  write_progress_md
  return 0
}

cmd_close() {
  local target="" force=0 a rc=0 r
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --all) [ -z "$target" ] || usage; target=$1 ;;
      -*) usage ;;
      *) [ -z "$target" ] || usage; target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || usage
  case "$target" in
    --all)
      for a in $AGENTS; do
        ( close_headless "$a" "$force" 1 ); r=$?
        # keep the most significant failure: 4 (refused) > 1
        case "$r" in 0) ;; 4) rc=4 ;; *) [ "$rc" != 0 ] || rc=$r ;; esac
      done
      exit "$rc" ;;
  esac
  valid_agent "$target"
  close_headless "$target" "$force" 0
  exit $?
}

# --- harness checkout: init (decision 0010) -----------------------------------------
# require_checkout — ask acts only in an initialised checkout; run from a subdir,
# they continue at the checkout root (the conductor cannot cd), so .harness/ stays in one place
require_checkout() {
  local root
  root=$(harness_root "$PWD") || die "not a harness checkout (no .harness/asks); run 'harness init' here first"
  [ "$root" = "$(pwd -P)" ] || cd "$root" || die "cannot enter $root"
}

# settings_commit TMP FILE — write TMP into FILE through the file (a symlinked FILE stays a
# symlink, as install.sh does) after one .bak copy of the original (never overwritten)
settings_commit() {
  local tmp=$1 f=$2
  [ -e "$f.bak" ] || cp "$f" "$f.bak" 2>/dev/null || return 1
  cat "$tmp" > "$f"
}

# settings_set_agent FILE — create FILE with {"agent":"conductor"}, or merge the key into it
# (never clobbering other keys; .bak first); an existing different agent is kept and noted.
settings_set_agent() {
  local f=$1 cur tmp
  if [ ! -e "$f" ]; then
    mkdir -p "${f%/*}" || { echo "harness init: cannot create ${f%/*}" >&2; return 0; }
    jq -n '{agent: "conductor"}' > "$f" && echo "created $f (agent: conductor)"
    return 0
  fi
  if ! jq -e 'type == "object"' "$f" >/dev/null 2>&1; then
    echo "note: $f is not a JSON object; left alone (set \"agent\": \"conductor\" yourself)" >&2
    return 0
  fi
  cur=$(jq -r '.agent // empty' "$f")
  if [ "$cur" = conductor ]; then echo "$f: agent already conductor"; return 0; fi
  if [ -n "$cur" ]; then
    echo "note: $f sets agent \"$cur\"; kept (use --no-agent to silence this)"
    return 0
  fi
  tmp=$(mktemp "${TMPDIR:-/tmp}/harness-settings.XXXXXX") || return 0
  if jq '.agent = "conductor"' "$f" > "$tmp" && settings_commit "$tmp" "$f"; then
    echo "updated $f (agent: conductor; backup $f.bak)"
  else
    echo "harness init: could not update $f" >&2
  fi
  rm -f "$tmp"
}

# cmd_init [--no-agent] [--shared] — make the current repo (git toplevel, else the cwd) a harness
# checkout: .harness/asks/, the default config, "agent": "conductor" in .claude/settings.local.json
# (per user, untracked; --shared: .claude/settings.json, committed), and .harness/ in
# .git/info/exclude when git does not already ignore it. Idempotent.
cmd_init() {
  [ "${HARNESS_ROLE:-}" != worker ] || die "harness init is for the conductor; a worker (HARNESS_ROLE=worker) does not set up checkouts"
  local agent=1 a top ex target=.claude/settings.local.json
  for a in "$@"; do
    case "$a" in --no-agent) agent=0 ;; --shared) target=.claude/settings.json ;; *) usage ;; esac
  done
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
  cd "$top" || die "cannot enter $top"
  echo "harness init: $top"
  if [ -d .harness/asks ]; then echo ".harness/asks exists"
  else mkdir -p .harness/asks || die "cannot create .harness/asks"; echo "created .harness/asks"; fi
  if [ -e "$CONFIG_FILE" ]; then echo "$CONFIG_FILE exists"
  else ensure_config init; [ -e "$CONFIG_FILE" ] && echo "created $CONFIG_FILE"; fi
  if [ "$agent" = 1 ]; then settings_set_agent "$target"
  else echo "$target untouched (--no-agent)"; fi
  if git rev-parse --git-dir >/dev/null 2>&1; then
    if git check-ignore -q .harness/asks/x 2>/dev/null; then echo ".harness/ already ignored by git"
    else
      ex=$(git rev-parse --git-path info/exclude 2>/dev/null)
      if [ -n "$ex" ] && mkdir -p "${ex%/*}" && printf '.harness/\n' >> "$ex"; then echo "added .harness/ to $ex"
      else echo "note: could not add .harness/ to git's exclude file" >&2; fi
    fi
  fi
  echo "workers run as detached headless Claude sessions: no herdr needed (herdr is an optional viewer)"
  return 0
}

need jq
# _mtime prints a file's epoch mtime (tests: fake GNU/BSD stat on PATH)
if [ "${1:-}" = _mtime ]; then file_mtime "${2:-}"; exit $?; fi
# _defaults prints the shared defaults as KEY=VALUE (tests: prose copies are checked against it)
if [ "${1:-}" = _defaults ]; then
  for k in $(compgen -v HARNESS_ | grep -E '^HARNESS_(ROLES|[A-Z_]+_(MS|DEFAULT))$' | sort); do eval "printf '%s=%s\n' \"$k\" \"\${$k}\""; done
  exit 0
fi
# init is file work: no herdr, no checkout needed
if [ "${1:-}" = init ]; then shift; cmd_init "$@"; exit $?; fi
# wiki-lint is pure file checking: no herdr needed
if [ "${1:-}" = wiki-lint ]; then shift; cmd_wiki_lint "$@"; exit $?; fi
# metrics reads files only
if [ "${1:-}" = metrics ]; then shift; cmd_metrics "$@"; exit $?; fi

# ask acts only in an initialised checkout (decision 0010); status/report/close work anywhere
case "${1:-}" in
  ask) [ "${HARNESS_ROLE:-}" = worker ] || require_checkout ;;
esac
case "${1:-}" in
  ask|status) ensure_config "$1" ;;
esac
case "${1:-}" in
  ask)    shift; cmd_ask "$@" ;;
  report) shift; cmd_report "$@" ;;
  wait)   shift; cmd_wait "$@" ;;
  watch)  shift; cmd_watch "$@" ;;
  status) cmd_status ;;
  close)  shift; cmd_close "$@" ;;
  *)      usage ;;
esac
exit $?
}
