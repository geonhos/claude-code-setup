#!/bin/bash
# The body is one brace group: bash parses the whole file before running any of it, so a
# tool that rewrites this file in place cannot corrupt a run in progress (wiki: troubleshooting).
{
# harness — conductor-side wrapper around herdr for named Claude workers.
# Spec: docs/superpowers/specs/2026-10-12-herdr-conductor-setup-design.md
#
#   harness spawn  <agent> [--direction right|down]
#   harness ask    <agent> '<instruction>' [--timeout MS] [--fresh|--keep] [--via skill|conductor]
#     default --timeout: implementer 1740000, analyst/reviewer 600000
#   harness ask    <analyst|reviewer> '<instruction>' --worktree [--base REF]
#     headless roles only: the ask runs in its own detached git worktree under
#     ~/.cache/harness/wt/<repo8>/<role>-<id8> (decision 0008); the ask-id is printed on stderr.
#   harness report <agent>|<ask-id>
#   harness status
#   harness init [--no-agent]   make this repo a harness checkout (.harness/asks, config, agent=conductor)
#   harness doctor [--fix] [DIR...]   clean pollution left by older versions (strays, global agent key)
#   harness close  <agent>|<ask-id>|--all|--legacy [--force]
#   harness route-log '<json>'   append one line to .harness/routing.jsonl (never fails)
#   harness retro [--dry-run]    one batched analyst ask over the queued failure candidates
#   harness metrics [--since YYYY-MM-DD] [--json]   health numbers from progress.jsonl + the wiki
#
# Exit codes for `ask`: 0 report printed · 1 usage/setup error · 2 worker blocked
#                       6 worker runs outside this repo (cwd check); nothing was sent
#                       3 worker finished without a report
#                       4 worker still working / unknown (including busy with a
#                         previous instruction: nothing sent), or prompt not
#                         accepted
#                       5 verification failed (implementer's checks gave up, or the
#                         reviewer's last line is `VERDICT: FAIL`); the report is
#                         still printed on stdout. A reviewer report without a
#                         final VERDICT line counts as no valid report (3).
# `report` prints .harness/reports/<agent>.md with the same exit codes as `ask`
#   (0 · 3 no report/no VERDICT · 5 verification failed), plus 4 while the agent
#   is still working. It never sends a prompt.
# Worker herdr names are repo-scoped: <role>-<repo8> (see wname).
# Workers (HARNESS_ROLE=worker) may not ask or spawn: skills are user-global and would otherwise nest.
# .harness/ lives in the checkout root: `harness init` creates it; ask/spawn refuse without it
# and, run from a subdir of the checkout, continue at the root.
# Every ask is logged to .harness/log/ and .harness/progress.jsonl, and
# .harness/progress.md is regenerated (log errors only warn on stderr).
# Every ask also appends a `delegate` line to .harness/routing.jsonl (source =
# --via, default conductor; the /analyze /implement /review skills pass skill).
# Context reset before an ask on a live worker: implementer always, analyst/
# reviewer when ctx > HARNESS_CTX_RESET (default 120000) or with --fresh;
# --keep skips it. Reset = /clear, else close + respawn.
# Pane lifecycle (config: .harness/config.json, created on first use; env overrides):
#   close_after_ask.<role> never|on_success (default never for all roles);
#     env HARNESS_CLOSE_AFTER_ASK_<ROLE>. on_success = ask exit 0 (reviewer: 0 or 5).
#   idle_ttl_minutes (default 30, 0 = off; env HARNESS_IDLE_TTL_MINUTES): at the start
#     of ask|spawn|status, scoped workers of this repo idle longer than that since
#     their last collected report (.harness/asks/<role>.finished) are closed.
#   HARNESS_NO_AUTOCLOSE=1 disables both. `harness close` refuses (exit 4) a working/
#   blocked worker or an uncollected report unless --force. Closes are logged to
#   progress.jsonl (event close, role, reason manual|after_ask|ttl|legacy).
# Failure retros: a failed/late/retried ask queues .harness/retro/<ask-id>.json (paths and
#   numbers only, never screen or prompt text) and prints `retro: candidate queued (...)`.
#   Triggers: ask exit other than 0 (a reviewer exit 5 = FAIL verdict is normal: never a
#   trigger), implementer verify attempts >= 2, a late report collected by `harness report`.
#   `harness retro` batches the pending ones into one analyst ask (--via retro, which
#   itself never queues a candidate).
# Output of `ask`: stdout = report on exit 0 and 5; screen text on 2/3/4;
#                  diagnostics on stderr.
set -u

# lib/ is sourced eagerly, here, inside the brace group: bash 3.2 reads a sourced file whole,
# so an in-place edit cannot corrupt the run (a lazily sourced file would lose that protection).
# The symlinked $0 is resolved by hand (no readlink -f on old macOS).
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  case $src in */*) d=$(CDPATH= cd -P "${src%/*}" && pwd) ;; *) d=$PWD ;; esac
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$d/$src ;; esac
done
case $src in */*) d=${src%/*} ;; *) d=. ;; esac   # no dirname: PATH may be bare in hooks/tests
HARNESS_LIB=${HARNESS_LIB:-$(CDPATH= cd -P "$d/../lib" 2>/dev/null && pwd)}
# Explicit list, fixed order, no glob: a stray file in lib/ is never sourced. Definitions only.
for m in defaults metrics worktree headless; do
  . "$HARNESS_LIB/harness-$m.sh" 2>/dev/null || { echo "harness: cannot load lib/harness-$m.sh" >&2; exit 1; }
done
unset src d m
# end loader

AGENTS=$HARNESS_ROLES
REPORT_DIR=".harness/reports"
PANES_FILE=".harness/panes"
LOG_DIR=".harness/log"
JSONL=".harness/progress.jsonl"
PROGRESS_MD=".harness/progress.md"
ROUTE_JSONL=".harness/routing.jsonl"
DEFAULT_TIMEOUT=$HARNESS_DEFAULT_TIMEOUT_MS
IMPLEMENTER_TIMEOUT=$HARNESS_IMPLEMENTER_TIMEOUT_MS
TAB=$(printf '\t')
# Per-ask state (decision 0008). A plain ask uses the main checkout's .harness/asks and reports; a
# `--worktree` ask (headless analyst/reviewer, detached checkout) points ASK_DIR/REPORT_DIR into
# its worktree, so same-role asks never share a slot. Everything shared (progress.jsonl, logs,
# routing, retro, panes, config) stays in the main root.
ASK_DIR=".harness/asks"
ASK_KEY=""        # pane-registry key of a worktree ask: <role>@<id8> (empty = the role)
ASK_WT=""         # worktree path of this ask (empty = plain ask)
ASK_ID=""; ASK_ID8=""; ASK_BASE=""; ASK_WT_WANT=0
# parsed once by ask_parse_args (cmd_ask); ask_inner only reads them
ASK_VIA=conductor; ASK_TIMEOUT=$DEFAULT_TIMEOUT; ASK_FRESH=0; ASK_KEEP=0; ASK_BAD=0
ASK_HAS_BASE=0; ASK_BASE_REF=""; ASK_BASE_NOVAL=0
WT_HOME=${HARNESS_WT_ROOT:-$HOME/.cache/harness/wt}
WT_DIR=".harness/wt"

usage() {
  cat >&2 <<EOF
usage:
  harness spawn  <agent> [--direction right|down]
  harness ask    <agent> '<instruction>' [--timeout MS (default: implementer $IMPLEMENTER_TIMEOUT, others $DEFAULT_TIMEOUT)] [--fresh|--keep] [--via skill|conductor|retro]
  harness ask    <analyst|reviewer> '<instruction>' --worktree [--base REF] ...   (headless roles only; --base needs --worktree)
  harness report <agent>|<ask-id>
  harness status
  harness init   [--no-agent]   (once per repo: makes it a harness checkout; ask/spawn refuse without it)
  harness doctor [--fix] [DIR...]   (find/remove stray .harness/ dirs and the old global agent key)
  harness close  <agent>|<ask-id>|--all|--legacy [--force]
  harness wiki-lint [DIR]
  harness route-log '<json>'
  harness retro [--dry-run]
  harness metrics [--since YYYY-MM-DD] [--json]
agents: $AGENTS
EOF
  exit 1
}

die() { echo "harness: $*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"; }

# herdr_env_ok — herdr can be talked to: HERDR_ENV=1 and the binary exists. Never execs herdr
# otherwise (a real herdr may be on the PATH of a test or a worker).
herdr_env_ok() { [ "${HERDR_ENV:-}" = 1 ] && command -v herdr >/dev/null 2>&1; }
# herdr_usable — herdr_env_ok, and not a worker: a headless run may be hosted in a viewer pane
herdr_usable() { herdr_env_ok && [ "${HARNESS_ROLE:-}" != worker ]; }
# need_herdr — the pane-only paths (spawn, pane-mode ask/report/close/status): headless asks run without herdr
need_herdr() {
  need herdr
  [ "${HERDR_ENV:-}" = 1 ] || die "run Claude inside a herdr pane (HERDR_ENV is not 1)"
}

valid_agent() {
  case " $AGENTS " in
    *" $1 "*) return 0 ;;
  esac
  die "unknown agent '$1' (expected one of: $AGENTS)"
}

# --- repo-scoped worker names ------------------------------------------------------------
# A worker's herdr name is <role>-<repo8>: repo8 = first 8 hex of a hash of the
# repo top-level (git rev-parse --show-toplevel, else $PWD; symlinks resolved).
# CLI/role names (analyst, implementer, reviewer) are unchanged; wname is the
# only place that maps role -> herdr name. Exit 6 = worker belongs to another dir.
repo_top() {
  local t
  t=$(git rev-parse --show-toplevel 2>/dev/null) || t=""
  [ -n "$t" ] || t=$PWD
  ( cd "$t" 2>/dev/null && pwd -P ) || printf '%s\n' "$t"
}
repo_hash8() {
  local h
  if command -v sha1sum >/dev/null 2>&1; then h=$(printf %s "$1" | sha1sum)
  elif command -v shasum >/dev/null 2>&1; then h=$(printf %s "$1" | shasum -a 1)
  else h=$(printf %s "$1" | cksum | awk '{ printf "%08x", $1 }'); fi
  printf %s "${h%% *}" | cut -c1-8
}
REPO_TOP=$(repo_top)
REPO8=$(repo_hash8 "$REPO_TOP")
wname() { printf '%s-%s' "$1" "$REPO8"; }

# cwd_in_repo <dir> — 0 when dir (symlinks resolved) is the repo top-level or inside it
cwd_in_repo() {
  local d=$1 rest=""
  # a vanished path: resolve the deepest existing ancestor, re-append the rest,
  # so /link/gone and /repo/gone behave the same
  while [ ! -d "$d" ] && [ "$d" != "/" ] && [ "$d" != "." ] && [ -n "$d" ]; do
    rest="/${d##*/}$rest"; d=${d%/*}; [ -n "$d" ] || d=/
  done
  d=$( cd "$d" 2>/dev/null && pwd -P ) || d=$1
  [ "$d" = "/" ] && d=""
  d="$d$rest"
  [ -n "$d" ] || d=/
  case "$d" in "$REPO_TOP"|"$REPO_TOP"/*) return 0 ;; esac
  return 1
}

# check_worker_cwd <role> <agent-get-json> — exit 6 when the worker runs outside
# this repo. A worker whose cwd herdr does not report is not refused.
check_worker_cwd() {
  local c
  c=$(printf '%s' "$2" | jq -r '.result.agent.cwd // empty' 2>/dev/null)
  if [ -z "$c" ]; then
    echo "harness: warning: herdr did not report cwd for $(wname "$1"); repo check skipped" >&2
    return 0
  fi
  cwd_in_repo "$c" && return 0
  echo "harness: worker $(wname "$1") runs in $c, outside this repo ($REPO_TOP); refusing to use it. Close that pane or run harness from the right directory." >&2
  exit 6
}

# migration_hint <role> — one line when an old unscoped worker of this repo is still live
migration_hint() {
  local j c
  j=$(herdr agent get "$1" 2>/dev/null) || return 0
  c=$(printf '%s' "$j" | jq -r '.result.agent.cwd // empty' 2>/dev/null)
  [ -n "$c" ] && cwd_in_repo "$c" || return 0
  echo "harness: note: old unscoped worker '$1' is still running for this repo and is no longer used; close it with: harness close --legacy (harness now uses $(wname "$1"))." >&2
}

agent_json()   { herdr agent get "$(wname "$1")" 2>/dev/null; }
agent_pane()   { agent_json "$1" | jq -r '.result.agent.pane_id // empty'; }

# agent_fields <agent> — one `agent get`, prints "status<TAB>pane".
# Prints "unknown<TAB>-" and returns 1 when the agent is not live.
agent_fields() {
  local j f
  j=$(agent_json "$1") || { printf 'unknown\t-\n'; return 1; }
  f=$(printf '%s' "$j" | jq -r '[(.result.agent.agent_status // "unknown"), (.result.agent.pane_id // "-")] | @tsv' 2>/dev/null)
  [ -n "$f" ] || f=$(printf 'unknown\t-')
  printf '%s\n' "$f"
}
agent_status() {
  local st
  st=$(agent_json "$1" | jq -r '.result.agent.agent_status // "unknown"' 2>/dev/null)
  [ -n "$st" ] || st=unknown
  echo "$st"
}

# show_pane_screen <pane> — screen text of a pane (works whether or not an
# agent is still live in it)
show_pane_screen() {
  echo "--- $1 screen (last 60 lines) ---"
  herdr pane read "$1" --source recent-unwrapped --lines 60 2>/dev/null
  echo "--- end ---"
}

# show_agent_diag <agent> — raw `agent get` JSON (or "agent not found") on stderr
show_agent_diag() {
  local j
  if j=$(agent_json "$1"); then
    echo "harness: agent get $(wname "$1"): $j" >&2
  else
    echo "harness: agent get $(wname "$1"): agent not found" >&2
  fi
}

# lock_stale <dir> — the lock's owner is gone: its pid is dead, or alive but not a harness process
# (the pid was reused; `grep harness` is a deliberate loose match: a reused pid whose command line
# merely contains "harness" is honoured until the ceiling, never wrongly stolen), or the owner file
# never appeared and the dir is older than HARNESS_LOCK_STALE_S (default 10 s: an owner that died
# between mkdir and writing its pid). A live owner is overridden, with a warning, only once the LOCK
# is older than HARNESS_LOCK_MAX_S (default 120 s; age = owner file mtime, i.e. since it was taken):
# how long this waiter has waited does not count, so a lock just acquired is never stolen.
lock_stale() {
  local d=$1 own mt age
  own=$(cat "$d/owner" 2>/dev/null)
  if digits_only "$own"; then
    kill -0 "$own" 2>/dev/null || return 0
    ps -p "$own" -o command= 2>/dev/null | grep -q 'harness' || return 0
    mt=$(file_mtime "$d/owner") || return 1
    age=$(( $(date +%s) - mt ))
    [ "$age" -ge "${HARNESS_LOCK_MAX_S:-120}" ] || return 1
    echo "harness: lock $d held by pid $own for over ${HARNESS_LOCK_MAX_S:-120}s; taking it over" >&2
    return 0
  fi
  mt=$(file_mtime "$d") || return 1
  [ $(( $(date +%s) - mt )) -gt "${HARNESS_LOCK_STALE_S:-10}" ]
}

# lock_take <dir> — mkdir lock (portable) with an owner pid file inside.
# Takeover invariant: a lock dir is only ever removed by a waiter that holds the takeover mutex
# "<dir>.take" and re-judged the lock stale while holding it. Nothing is renamed or put back, so a
# fresh lock can never be moved away or nested; while the stale dir exists nobody can mkdir over it,
# and the other waiters sit in the mutex or retry the mkdir. (Only a live-owner override after
# HARNESS_LOCK_MAX_S can race the owner's own lock_drop; that is the last resort by design.)
# A taker that died holding "<dir>.take" is cleared by age (HARNESS_LOCK_STALE_S).
lock_take() {
  local d=$1 i=0 mt
  while ! mkdir "$d" 2>/dev/null; do
    i=$((i + 1))
    if [ $((i % 10)) -eq 0 ] && lock_stale "$d"; then
      if mkdir "$d.take" 2>/dev/null; then
        if lock_stale "$d"; then rm -rf "$d"; fi
        rmdir "$d.take" 2>/dev/null
      elif mt=$(file_mtime "$d.take") && [ $(( $(date +%s) - mt )) -gt "${HARNESS_LOCK_STALE_S:-10}" ]; then
        rmdir "$d.take" 2>/dev/null
      fi
    fi
    sleep 0.05
  done
  echo $$ > "$d/owner" 2>/dev/null
  return 0
}
lock_drop() { rmdir "$1" 2>/dev/null || rm -rf "$1"; }

# unregister <agent> <pane> — drop that line from the pane registry (under the registry lock:
# parallel worktree asks register and unregister at the same time)
unregister() {
  local tmp rc lock="$PANES_FILE.lock"
  [ -f "$PANES_FILE" ] || return 0
  lock_take "$lock"
  tmp=$(mktemp "$PANES_FILE.XXXXXX") || { lock_drop "$lock"; die "cannot create temp file next to $PANES_FILE"; }
  grep -Fxv -- "$1 $2" "$PANES_FILE" > "$tmp"
  rc=$?
  if [ "$rc" -gt 1 ]; then
    rm -f "$tmp"; lock_drop "$lock"
    die "cannot rewrite $PANES_FILE"
  fi
  mv "$tmp" "$PANES_FILE"
  lock_drop "$lock"
}

# register <agent> <pane> — append that line to the pane registry (under the same lock)
register() {
  local lock="$PANES_FILE.lock"
  mkdir -p "$(dirname "$PANES_FILE")"
  lock_take "$lock"
  printf '%s %s\n' "$1" "$2" >> "$PANES_FILE"
  lock_drop "$lock"
}

# Terminal cells are roughly twice as tall as wide; a pane is "wide" when
# width >= 2.2 * height. Wide -> split right, otherwise down.
# Without HERDR_PANE_ID there is no pane to measure: default to right.
pick_direction() {
  local layout w h
  [ -n "${HERDR_PANE_ID:-}" ] || { echo right; return; }
  layout=$(herdr pane layout --pane "${HERDR_PANE_ID:-}" 2>/dev/null) || { echo right; return; }
  w=$(printf '%s' "$layout" | jq -r --arg p "${HERDR_PANE_ID:-}" '.result.layout.panes[] | select(.pane_id==$p) | .rect.width' 2>/dev/null)
  h=$(printf '%s' "$layout" | jq -r --arg p "${HERDR_PANE_ID:-}" '.result.layout.panes[] | select(.pane_id==$p) | .rect.height' 2>/dev/null)
  if [ -n "$w" ] && [ -n "$h" ] && [ "$w" -ge $((h * 22 / 10)) ]; then
    echo right
  else
    echo down
  fi
}

cmd_spawn() {
  [ "${HARNESS_ROLE:-}" != worker ] || die "harness ask/spawn is for the conductor; a worker (HARNESS_ROLE=worker) does its task itself"
  need_herdr
  local agent=${1:-} dir=""
  [ -n "$agent" ] || usage
  valid_agent "$agent"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --direction)
        [ $# -ge 2 ] || usage
        case "$2" in right|down) dir=$2 ;; *) usage ;; esac
        shift 2 ;;
      *) usage ;;
    esac
  done

  local fields
  if fields=$(agent_fields "$agent"); then
    check_worker_cwd "$agent" "$(agent_json "$agent")"
    printf '%s\n' "${fields#*$TAB}"
    return 0
  fi
  migration_hint "$agent"

  [ -n "$dir" ] || dir=$(pick_direction)

  local out pane
  if ! out=$(herdr pane split --current --direction "$dir" --cwd "$PWD" --env HARNESS_ROLE=worker --env CLAUDE_CODE_AUTO_COMPACT_WINDOW=160000 --no-focus 2>&1); then
    die "pane split failed: $out"
  fi
  pane=$(printf '%s' "$out" | jq -r '.result.pane.pane_id // empty' 2>/dev/null)
  [ -n "$pane" ] || die "pane split returned no pane id: $out"

  register "$agent" "$pane"
  rm -f ".harness/asks/$agent.finished"

  # a fresh pane's shell may still be loading (agent_pane_busy): retry only that error
  local try=0 started=0
  while :; do
    if out=$(herdr agent start "$(wname "$agent")" --kind claude --pane "$pane" -- --agent "$agent" 2>&1); then started=1; break; fi
    case "$out" in *agent_pane_busy*) ;; *) break ;; esac
    [ "$try" -lt "${HARNESS_SPAWN_RETRIES:-20}" ] || break
    try=$((try + 1)); sleep "${HARNESS_SPAWN_RETRY_S:-0.5}"
  done
  if [ "$started" = 0 ]; then
    echo "harness: agent start failed for $agent in $pane: $out" >&2
    show_pane_screen "$pane" >&2
    herdr pane close "$pane" >/dev/null 2>&1 \
      || echo "harness: could not close orphan pane $pane" >&2
    unregister "$agent" "$pane"
    exit 1
  fi
  echo "$pane"
}

# agent_session <agent> — Claude session id herdr reports for the agent
agent_session() { agent_json "$1" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null; }

# project_dir_name <path> — the directory name Claude Code uses under
# ~/.claude/projects for a cwd. Observed with `claude -p` in dirs named a_b,
# "c d", "é한x" and p.q-r: every character outside [A-Za-z0-9] becomes "-", one
# per character (not per byte), on the real path (/tmp -> /private/tmp).
project_dir_name() { printf %s "$1" | perl -CS -pe 's/[^A-Za-z0-9]/-/g'; }

# ctx_tokens <agent> — context size from the last main-thread assistant usage in
# the transcript (~/.claude/projects/<project_dir_name>/<session>.jsonl);
# prints nothing when unknown
ctx_tokens() {
  local sid f
  sid=$(agent_session "$1")
  [ -n "$sid" ] || return 0
  f="${HARNESS_PROJECTS_DIR:-$HOME/.claude/projects}/$(project_dir_name "$(pwd -P)")/$sid.jsonl"
  [ -r "$f" ] || return 0
  grep '"type":"assistant"' "$f" 2>/dev/null | grep -v '"isSidechain":true' | tail -n 1 \
    | jq -R 'fromjson? | select(type == "object" and .type == "assistant" and ((.message.usage | type) == "object")) | .message.usage | (.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0)' 2>/dev/null
}

# fmt_ctx <tokens> — "137k", or "-" when unknown
fmt_ctx() {
  case "${1:-}" in
    ''|*[!0-9]*) echo - ;;
    *) echo "$(($1 / 1000))k" ;;
  esac
}

# do_clear <agent> — send /clear (no --wait: herdr would stall) and poll until herdr
# reports a new session id (status is not required: CC may clear while herdr still
# shows the old status). Window: HARNESS_CLEAR_POLLS (default 60) x
# HARNESS_CLEAR_INTERVAL (0.5 s) ~ 30 s. If the id did not change and the pane is
# idle/done, /clear is sent once more with a shorter window (HARNESS_CLEAR_RETRY_POLLS,
# default 20 ~ 10 s); otherwise the caller respawns. After a change, wait briefly for idle (bounded, never fails the
# clear). Sets CLEAR_HOW=ok|retry. 0 = cleared, 1 = not cleared (caller respawns).
do_clear() {
  local old new st i attempt=1 j polls
  CLEAR_HOW=""
  old=$(agent_session "$1")
  while [ "$attempt" -le 2 ]; do
    herdr agent prompt "$(wname "$1")" /clear >/dev/null 2>&1 || return 1
    i=0
    polls=${HARNESS_CLEAR_POLLS:-60}
    [ "$attempt" = 1 ] || polls=${HARNESS_CLEAR_RETRY_POLLS:-20}
    while [ "$i" -lt "$polls" ]; do
      sleep "${HARNESS_CLEAR_INTERVAL:-0.5}"
      j=$(agent_json "$1") || return 1
      new=$(printf '%s' "$j" | jq -r '.result.agent.agent_session.value // empty' 2>/dev/null)
      if [ -n "$new" ] && [ "$new" != "$old" ]; then
        i=0
        while [ "$i" -lt "${HARNESS_CLEAR_IDLE_POLLS:-20}" ]; do
          st=$(agent_status "$1")
          case "$st" in idle|done) break ;; esac
          sleep "${HARNESS_CLEAR_INTERVAL:-0.5}"
          i=$((i + 1))
        done
        if [ "$attempt" = 1 ]; then CLEAR_HOW=ok; else CLEAR_HOW=retry; fi
        return 0
      fi
      i=$((i + 1))
    done
    attempt=$((attempt + 1))
    st=$(agent_status "$1")
    case "$st" in idle|done) ;; *) return 1 ;; esac
  done
  return 1
}

# note_clear <agent> <ok|retry|respawn> — the ask's /clear outcome for record_progress
# (maybe_reset runs in the ask's subshell, so it travels through a file)
note_clear() {
  mkdir -p .harness/asks 2>/dev/null && printf '%s\n' "$2" > ".harness/asks/$1.clear" 2>/dev/null
  return 0
}

# last_ask_record <agent> [--ask-id ID|--any-id] [--where JQ] [--field JQ]
# The newest progress line of <agent> among the last 200 non-close lines that matches the
# ask-id (default: $ASK_ID, "" = plain asks: a --worktree ask logs `agent: <role>` plus an
# ask_id, and must never stand in for a plain ask; --any-id reads every line) and the extra
# jq condition --where. Prints --field (default: the compact line); nothing = unknown.
# The ids are passed with --arg; --where/--field are jq source from the caller's own literals.
last_ask_record() {
  local agent=$1 id=${ASK_ID:-} any=0 where=true field=. prog
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --ask-id) id=$2; any=0; shift 2 ;;
      --any-id) any=1; shift ;;
      --where) where=$2; shift 2 ;;
      --field) field=$2; shift 2 ;;
      *) return 2 ;;
    esac
  done
  prog="fromjson? | select(type == \"object\" and .agent == \$a and (\$any == 1 or (.ask_id // \"\") == \$id)) | select($where) | $field"
  grep -v '"event":"close"' "$JSONL" 2>/dev/null | tail -n 200 \
    | jq -R -r -c --arg a "$agent" --arg id "$id" --argjson any "$any" "$prog" 2>/dev/null | tail -n 1
}

# last_exit <agent> — exit code of the agent's last logged plain ask (late archives
# have no exit and are skipped; worktree asks are not plain asks); nothing when unknown
last_exit() {
  last_ask_record "$1" --where '(.exit | type) == "number"' --field .exit
}

# maybe_reset <agent> <fresh> <keep> <existed> <ctx> — clear a live worker's
# context before a new task, falling back to close + respawn. Sets RESET_PANE
# when it respawned. Skipped (unless --fresh) when the agent's last logged ask
# did not end cleanly: reset runs when that exit is 0 (reviewer: 0 or 5, a FAIL
# verdict is a complete outcome) or when no exit is logged (first ask after
# spawn, rotated/empty jsonl); any other exit keeps the worker's context.
maybe_reset() {
  local agent=$1 fresh=$2 keep=$3 existed=$4 ctx=${5:-} need=0 st last
  RESET_PANE=""
  [ "$existed" = 1 ] && [ "$keep" = 0 ] || return 0
  case "$agent" in
    implementer) need=1 ;;
    *)
      case "$ctx" in
        ''|*[!0-9]*) ;;
        *) [ "$ctx" -gt "${HARNESS_CTX_RESET:-$HARNESS_CTX_RESET_DEFAULT}" ] && need=1 ;;
      esac ;;
  esac
  [ "$fresh" = 1 ] && need=1
  [ "$need" = 1 ] || return 0
  if [ "$fresh" = 0 ]; then
    last=$(last_exit "$agent")
    case "$last" in
      ''|0) ;;
      5) if [ "$agent" != reviewer ]; then
           echo "keeping context (last ask exit $last)" >&2
           return 0
         fi ;;
      *)
        echo "keeping context (last ask exit $last)" >&2
        return 0 ;;
    esac
  fi
  st=$(agent_status "$agent")
  case "$st" in idle|done) ;; *) return 0 ;; esac
  if do_clear "$agent"; then note_clear "$agent" "$CLEAR_HOW"; return 0; fi
  note_clear "$agent" respawn
  echo "harness: /clear did not take effect for $agent; respawning it" >&2
  if ! ( preflight_close "$agent"; finish_close "$agent" "$C_PANE" "" ) >&2; then
    echo "harness: could not close $agent; continuing without a reset" >&2
    return 0
  fi
  RESET_PANE=$(cmd_spawn "$agent") || exit $?
}

# --- progress log ----------------------------------------------------------------------

git_head() { git rev-parse --short HEAD 2>/dev/null || true; }
# file_sum <file> — cksum "crc-size" of a file (portable), empty if unreadable
file_sum() { cksum < "$1" 2>/dev/null | awk '{ print $1 "-" $2 }'; }
num_or_null() { case "${1:-}" in ''|*[!0-9]*) echo null ;; *) echo "$1" ;; esac; }

# record_progress <agent> <text> <rc> <t0> <head_before> <stdout-file> <ctx_before>
# Writes the log file + jsonl line, rotates, regenerates progress.md.
record_progress() {
  local agent=$1 text=$2 rc=$3 t0=$4 hb=$5 out=$6 cb=${7:-}
  local report="$REPORT_DIR/$agent.md" vj=.harness/verify/implementer.json rmt
  local now ts stamp ha sess ca status="" summary="" verify="" logf n brief sha="" va="" clr=none hl='{}'
  now=$(date +%s)
  # a report older than this ask is a previous ask's (this one died before archiving it)
  if [ -f "$report" ]; then rmt=$(file_mtime "$report") && [ "$rmt" -ge "$t0" ] || report=/dev/null.none; fi
  [ ! -s "$ASK_DIR/$agent.clear" ] || clr=$(sed -n 1p "$ASK_DIR/$agent.clear")
  case "$clr" in ok|retry|respawn|none) ;; *) clr=none ;; esac
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  stamp=$(date +%Y%m%d-%H%M%S)
  ha=$(git_head)
  if use_hl "$agent"; then
    # headless: session and context come from the run's exit.json, not herdr
    hl=$(hl_progress_obj "$agent" "$t0")
    sess=$(printf '%s' "$hl" | jq -r '.session // empty' 2>/dev/null)
    ca=$(printf '%s' "$hl" | jq -r '.ctx_after // empty' 2>/dev/null)
    cb=$(sed -n 's/^ctx_before=//p' "$ASK_DIR/$agent.run" 2>/dev/null | head -n 1)
    clr=none
    hl=$(printf '%s' "$hl" | jq -c 'del(.session, .ctx_after)' 2>/dev/null) || hl='{}'
    if [ -n "$ASK_WT" ]; then
      hl=$(printf '%s' "$hl" | jq -c --arg wt "$ASK_WT" --arg base "$ASK_BASE" --arg id "$ASK_ID" '. + {ask_id: $id, wt: $wt, base: $base}' 2>/dev/null) || hl='{}'
    fi
  else
    sess=$(agent_session "$agent"); ca=$(ctx_tokens "$agent")
  fi
  if [ -f "$report" ]; then
    status=$(sed -n 's/^status: *//p' "$report" | head -n 1)
    summary=$(sed -n 's/^# *//p' "$report" | head -n 1)
    sha=$(file_sum "$report")
  fi
  if [ "$agent" = implementer ]; then
    verify=$(jq -r '.status // empty' "$vj" 2>/dev/null)
    va=$(jq -r '.attempts // empty' "$vj" 2>/dev/null)
    grep -q '^verify: INTERRUPTED' "$out" 2>/dev/null && verify=interrupted
  fi

  mkdir -p "$LOG_DIR" || return 1
  logf="$LOG_DIR/$stamp-$agent${ASK_WT:+-$ASK_ID8}.md"; n=1
  while [ -e "$logf" ]; do n=$((n + 1)); logf="$LOG_DIR/$stamp-$agent${ASK_WT:+-$ASK_ID8}-$n.md"; done
  brief=$(printf '%s' "$text" | grep -o '\.harness/task-[A-Za-z0-9_.-]*\.md' | head -n 1)
  {
    printf '# %s ask %s (exit %s, %ss)\n\n## Instruction\n\n%s\n' "$agent" "$ts" "$rc" "$((now - t0))" "$text"
    if [ -n "$brief" ] && [ -f "$brief" ]; then
      printf '\n## Brief (%s)\n\n' "$brief"; cat "$brief"
    fi
    if [ -f "$report" ]; then
      printf '\n## Report\n\n'; cat "$report"
    else
      printf '\n## Screen / output (no report)\n\n'; cat "$out"
      if [ "$hl" != '{}' ]; then
        printf '\n## Viewer pane (last 40 lines)\n\n'
        hl_view_tail "$agent" 40
      fi
    fi
    if [ -s "${ASK_ERR:-}" ]; then
      printf '\n## Errors\n\n'; cat "$ASK_ERR"
    fi
    if [ "$hl" != '{}' ]; then
      printf '\n## Run\n\n'
      printf '%s' "$hl" | jq -r '"result \(.result // "-"), turns \(.turns // "-"), cost $\(.cost_usd // "-"), stream \(.stream_log // "-")"' 2>/dev/null
    fi
  } > "$logf" || return 1

  # rotate the jsonl first so the new line lands in the fresh file
  if [ -f "$JSONL" ] && [ "$(wc -c < "$JSONL" | tr -d ' ')" -gt "${HARNESS_JSONL_MAX:-1048576}" ]; then
    mv "$JSONL" "$JSONL.$stamp" && gzip -f "$JSONL.$stamp"
  fi
  jq -n -c --arg ts "$ts" --arg agent "$agent" --arg session "$sess" \
    --arg instr "$(printf '%s' "$text" | tr '\n' ' ' | cut -c1-160)" \
    --argjson exit "$rc" --arg verify "$verify" --argjson dur "$((now - t0))" \
    --arg hb "$hb" --arg ha "$ha" --argjson cb "$(num_or_null "$cb")" --argjson ca "$(num_or_null "$ca")" \
    --arg status "$status" --arg summary "$summary" --arg sha "$sha" --argjson va "$(num_or_null "$va")" --arg clr "$clr" \
    --argjson hl "$hl" '
    def nz: if . == "" then null else . end;
    {ts: $ts, agent: $agent, session: ($session | nz), instr: $instr, exit: $exit,
     verify: ($verify | nz), verify_attempts: $va, dur_s: $dur, head_before: ($hb | nz), head_after: ($ha | nz),
     ctx_before: $cb, ctx_after: $ca, clear: $clr, status: ($status | nz), summary: ($summary | nz), report_sha: ($sha | nz)} + $hl' >> "$JSONL" || return 1

  LAST_LOG=$logf LAST_BRIEF=$brief
  rotate_logs "$logf"
  write_progress_md "$agent" "$ca"
  return 0
}

# --- failure retro candidates ---------------------------------------------------------
RETRO_DIR=".harness/retro"

# retro_write <ask-id> <role> <reason> <exit> <attempts> <dur> <brief> <log> <report> [late]
# One candidate file per ask-id: paths and numbers only (no screen or prompt text).
# An existing candidate is updated in place (a late report adds itself to it).
retro_write() {
  local f="$RETRO_DIR/$1.json" late=${10:-}
  mkdir -p "$RETRO_DIR" 2>/dev/null || return 1
  [ ! -e "$RETRO_DIR/done/$1.json" ] || return 1
  if [ -f "$f" ]; then
    [ -z "$late" ] || [ "$(jq -r '.late // false' "$f" 2>/dev/null)" != true ] || return 1
    jq -c --arg reason "$3" --arg report "$9" --argjson late "$([ -n "$late" ] && echo true || echo false)" '
      (if $late then .late = true | .reason = $reason else . end)
      | (if $report != "" and (.report // "") == "" then .report = $report else . end)' "$f" > "$f.tmp.$$" 2>/dev/null \
      && mv -f "$f.tmp.$$" "$f" || { rm -f "$f.tmp.$$"; return 1; }
    return 0
  fi
  jq -n -c --arg id "$1" --arg role "$2" --arg reason "$3" --argjson exit "$(num_or_null "$4")" \
    --argjson va "$(num_or_null "$5")" --argjson dur "$(num_or_null "$6")" --arg brief "$7" --arg log "$8" \
    --arg report "$9" --argjson late "$([ -n "$late" ] && echo true || echo false)" \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg stream "${RETRO_STREAM:-}" '
    def nz: if . == "" then null else . end;
    {ask_id: $id, role: $role, reason: $reason, exit: $exit, verify_attempts: $va, duration_s: $dur,
     brief: ($brief | nz), log: ($log | nz), report: ($report | nz), late: $late, ts: $ts}
    + (if $stream != "" then {stream_log: $stream} else {} end)' > "$f.tmp.$$" 2>/dev/null \
    && mv -f "$f.tmp.$$" "$f" || { rm -f "$f.tmp.$$"; return 1; }
}

# retro_snapshot <ask-id> <report> — copy a report to .harness/retro/reports/<ask-id>.md
# (the live report is archived and deleted by the next ask) and print that path.
retro_snapshot() {
  local d="$RETRO_DIR/reports"
  mkdir -p "$d" 2>/dev/null && cp -f "$2" "$d/$1.md" 2>/dev/null && { printf '%s' "$d/$1.md"; return 0; }
  printf '%s' "$2"
}

# retro_to_done <candidate-file> — move a processed candidate to done/ and drop its report snapshot
retro_to_done() {
  local id
  id=$(basename "$1" .json)
  mv -f "$1" "$RETRO_DIR/done/" || return 1
  rm -f "$RETRO_DIR/reports/$id.md"
}

# retro_pending_logs — log paths referenced by pending candidates (rotate_logs keeps them)
retro_pending_logs() {
  ls "$RETRO_DIR"/*.json >/dev/null 2>&1 || return 0
  jq -r '.log // empty, .stream_log // empty' "$RETRO_DIR"/*.json 2>/dev/null
}

# retro_on_ask <agent> <rc> — after an ask is logged: queue a candidate when it is a
# trigger, print the one-line notice. Never fails; the retro ask itself never queues.
retro_on_ask() {
  local agent=$1 rc=$2 reason="" va dur id cur ts rep="" bsnap mt
  [ "${ASK_VIA:-}" != retro ] || return 0
  dur=$(( $(date +%s) - ASK_T0 ))
  va=$(jq -r '.attempts // empty' .harness/verify/implementer.json 2>/dev/null)
  case "$rc" in
    0) ;;
    5) [ "$agent" = reviewer ] || reason="exit 5" ;;
    1) # a usage error before pre-flight ran nothing; after it (spawn, split, send) it is a failure
       if [ -n "${ASK_PF:-}" ] && [ -e "$ASK_PF" ]; then reason="exit 1"; fi ;;
    129|130|143) ;; # ask wrapper hung up, interrupted or terminated by the caller, not a harness failure
    *) reason="exit $rc" ;;
  esac
  if [ -z "$reason" ] && [ "$agent" = implementer ] && digits_only "$va" && [ "$va" -ge 2 ]; then
    reason="$va verify attempts"
  fi
  [ -n "$reason" ] || return 0
  [ "$agent" = implementer ] || va=""
  cur="$ASK_DIR/$agent.current"
  id=$(awk 'NR == 1 { print $1 }' "$cur" 2>/dev/null); ts=$(awk 'NR == 1 { print $2 }' "$cur" 2>/dev/null)
  if [ -z "$id" ] || ! digits_only "$ts" || [ "$ts" -lt "$ASK_T0" ]; then id="$ASK_T0-$$-noid"; fi
  if [ -f "$REPORT_DIR/$agent.md" ] && mt=$(file_mtime "$REPORT_DIR/$agent.md") && [ "$mt" -ge "$ASK_T0" ]; then
    rep=$(retro_snapshot "$id" "$REPORT_DIR/$agent.md")
  fi
  # the live .harness/task-<role>.md is overwritten by the next ask: point at the log's copy
  bsnap=""; [ -z "${LAST_BRIEF:-}" ] || [ -z "${LAST_LOG:-}" ] || bsnap="$LAST_LOG#brief"
  RETRO_STREAM=""; ! use_hl "$agent" || RETRO_STREAM=$(jq -r '.stream_log // empty' "$ASK_DIR/$agent.exit.json" 2>/dev/null)
  retro_write "$id" "$agent" "$reason" "$rc" "$va" "$dur" "$bsnap" "${LAST_LOG:-}" "$rep" \
    || { [ -f "$RETRO_DIR/$id.json" ] || rm -f "$RETRO_DIR/reports/$id.md"; return 0; }
  echo "retro: candidate queued ($reason) — run 'harness retro' when the task is done"
}

# cmd_route_log <json> — append one routing event to .harness/routing.jsonl
# (the UserPromptSubmit hook's `prompt` lines and `harness ask`'s `delegate`
# lines). Same rotation as progress.jsonl. Never fails: bad input or a write
# error only warns. HARNESS_ROUTE_LOG=0 disables it.
cmd_route_log() {
  local line=${1:-} stamp
  [ "${HARNESS_ROUTE_LOG:-1}" != 0 ] || return 0
  if [ -z "$line" ]; then
    echo "harness: route-log: empty line (ignored)" >&2; return 0
  fi
  # exactly one JSON object (a stream like '{} {}' or '{} junk' is refused)
  line=$(printf '%s' "$line" | jq -s -c 'if length == 1 and (.[0] | type) == "object" then .[0] else empty end' 2>/dev/null)
  if [ -z "$line" ]; then
    echo "harness: route-log: not a single JSON object (ignored)" >&2; return 0
  fi
  # workers never create .harness/ (a conductor's first prompt still may)
  if [ ! -d .harness ] && [ "${HARNESS_ROLE:-}" = worker ]; then
    echo "harness: route-log: no .harness/ in $PWD (ignored)" >&2; return 0
  fi
  mkdir -p .harness 2>/dev/null || { echo "harness: route-log: cannot create .harness/" >&2; return 0; }
  stamp=$(date +%Y%m%d-%H%M%S)
  if [ -f "$ROUTE_JSONL" ] && [ -r "$ROUTE_JSONL" ] && [ "$(wc -c < "$ROUTE_JSONL" | tr -d ' ')" -gt "${HARNESS_JSONL_MAX:-1048576}" ]; then
    mv "$ROUTE_JSONL" "$ROUTE_JSONL.$stamp" && gzip -f "$ROUTE_JSONL.$stamp"
  fi
  printf '%s\n' "$line" 2>/dev/null >> "$ROUTE_JSONL" \
    || echo "harness: route-log: could not write $ROUTE_JSONL" >&2
  return 0
}

# ask_parse_args <agent> <text> [opts...] — the one walk over an ask's options (called by cmd_ask
# after the agent and text checks). Sets ASK_VIA/TIMEOUT/FRESH/KEEP/WT_WANT/HAS_BASE/BASE_REF.
# The instruction text is positional, so a "--via" inside it is never an option. A bad option,
# --timeout value or --fresh with --keep only sets ASK_BAD: ask_inner turns that into the usage
# error inside the logged subshell (exit 1 is recorded in progress/routing). The errors that die
# in cmd_ask before any log (--via, --base, --worktree) are raised by ask_via_check/ask_wt_check.
ask_parse_args() {
  local agent=$1
  shift 2
  ASK_VIA=conductor; ASK_FRESH=0; ASK_KEEP=0; ASK_BAD=0
  ASK_WT_WANT=0; ASK_HAS_BASE=0; ASK_BASE_REF=""; ASK_BASE_NOVAL=0
  ASK_TIMEOUT=$DEFAULT_TIMEOUT
  [ "$agent" != implementer ] || ASK_TIMEOUT=$IMPLEMENTER_TIMEOUT
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout)
        case "${2:-}" in
          ''|*[!0-9]*|0) ASK_BAD=1; shift ;;     # missing/invalid value: usage (logged)
          *) ASK_TIMEOUT=$2; shift 2 ;;
        esac ;;
      --fresh) ASK_FRESH=1; shift ;;
      --keep) ASK_KEEP=1; shift ;;
      --worktree) ASK_WT_WANT=1; shift ;;
      --base)
        ASK_HAS_BASE=1
        if [ $# -ge 2 ]; then ASK_BASE_REF=$2; shift 2; else ASK_BASE_NOVAL=1; shift; fi ;;
      --via)
        if [ $# -ge 2 ]; then ASK_VIA=$2; shift 2; else ASK_VIA=''; shift; fi ;;
      *) ASK_BAD=1; shift ;;
    esac
  done
  [ "$ASK_FRESH$ASK_KEEP" != 11 ] || ASK_BAD=1
}

# ask_via_check — refuse a bad --via before any log
ask_via_check() {
  case "$ASK_VIA" in
    skill|conductor|retro) ;;
    '') die "--via needs a value: skill, conductor or retro" ;;
    *) die "--via expects skill, conductor or retro (got '$ASK_VIA')" ;;
  esac
}

# record_route_delegate <agent> <source> <rc> — one `delegate` line in
# .harness/routing.jsonl; session from CLAUDE_CODE_SESSION_ID (null if unset)
record_route_delegate() {
  local line
  line=$(jq -n -c --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg worker "$1" --arg source "$2" \
    --argjson exit "$(num_or_null "$3")" --arg session "${CLAUDE_CODE_SESSION_ID:-}" '
    def nz: if . == "" then null else . end;
    {ts: $ts, event: "delegate", session: ($session | nz), worker: $worker, source: $source, exit: $exit}' 2>/dev/null) || return 0
  cmd_route_log "$line"
}

# archive_late <agent> <report> — a report still on disk that no logged ask
# carries (it appeared after an exit-4 ask): copy it into the log, with a jsonl
# line (exit null, late true), before the next ask deletes it. A report already
# logged (same checksum on the agent's last line) is not archived twice.
archive_late() {
  local agent=$1 report=$2 sha last ts stamp logf n status summary
  sha=$(file_sum "$report")
  # keyed by role + ask: a worktree ask is compared with its own ask-id only, a plain one with plain lines
  last=$(last_ask_record "$agent" --field '.report_sha // ""')
  [ -z "$sha" ] || [ "$sha" != "$last" ] || return 0
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ); stamp=$(date +%Y%m%d-%H%M%S)
  status=$(sed -n 's/^status: *//p' "$report" | head -n 1)
  summary=$(sed -n 's/^# *//p' "$report" | head -n 1)
  mkdir -p "$LOG_DIR" || return 1
  logf="$LOG_DIR/$stamp-$agent${ASK_WT:+-$ASK_ID8}-late.md"; n=1
  while [ -e "$logf" ]; do n=$((n + 1)); logf="$LOG_DIR/$stamp-$agent${ASK_WT:+-$ASK_ID8}-late-$n.md"; done
  { printf '# %s late report %s (not logged by any ask)\n\n## Report\n\n' "$agent" "$ts"; cat "$report"; } > "$logf" || return 1
  local hl='{}'
  if use_hl "$agent"; then hl=$(hl_progress_obj "$agent" "" | jq -c 'del(.session, .ctx_after)' 2>/dev/null) || hl='{}'; fi
  jq -n -c --arg ts "$ts" --arg agent "$agent" --arg status "$status" --arg summary "$summary" --arg sha "$sha" --arg askid "${ASK_ID:-}" --argjson hl "$hl" '
    def nz: if . == "" then null else . end;
    {ts: $ts, agent: $agent, exit: null, late: true, status: ($status | nz),
     summary: ($summary | nz), report_sha: ($sha | nz), ask_id: ($askid | nz)} + $hl' >> "$JSONL" || return 1
  write_progress_md
  return 0
}

# rotate_logs <current-log> — newest N logs kept, older than D days deleted
rotate_logs() {
  local f
  local keep
  keep=$(mktemp "${TMPDIR:-/tmp}/harness-keep.XXXXXX") || keep=""
  { printf '%s\n' "$1"; retro_pending_logs; } > "${keep:-/dev/null}" 2>/dev/null
  ls -1t "$LOG_DIR"/*.md 2>/dev/null | grep -vxFf "${keep:-/dev/null}" | tail -n +"${HARNESS_LOG_KEEP:-200}" \
    | while IFS= read -r f; do rm -f "$f"; done
  find "$LOG_DIR" -name '*.md' -mtime "+${HARNESS_LOG_DAYS:-14}" 2>/dev/null \
    | grep -vxFf "${keep:-/dev/null}" | while IFS= read -r f; do rm -f "$f"; done
  # leftover report snapshots (no pending candidate points at them) past the log retention
  find "$RETRO_DIR/reports" -name '*.md' -mtime "+${HARNESS_LOG_DAYS:-14}" 2>/dev/null | while IFS= read -r f; do
    [ ! -f "$RETRO_DIR/$(basename "$f" .md).json" ] && rm -f "$f"
  done
  [ -z "$keep" ] || rm -f "$keep"
  # raw headless streams: gzip once a day old (the run is long over), drop with the logs.
  # A stream a pending retro candidate names is never gzipped or deleted (compared by base
  # name without .gz: the candidate says X.jsonl, the file may already be X.jsonl.gz).
  local stems
  stems=$(mktemp "${TMPDIR:-/tmp}/harness-stems.XXXXXX") || stems=""
  retro_pending_logs | sed 's/\.gz$//; s|.*/||' > "${stems:-/dev/null}" 2>/dev/null
  find "$LOG_DIR" -name '*.jsonl' -mtime +0 2>/dev/null | while IFS= read -r f; do
    grep -qxF -- "$(basename "$f")" "${stems:-/dev/null}" || gzip -f "$f" 2>/dev/null
  done
  find "$LOG_DIR" \( -name '*.jsonl' -o -name '*.jsonl.gz' \) -mtime "+${HARNESS_LOG_DAYS:-14}" 2>/dev/null \
    | while IFS= read -r f; do
        grep -qxF -- "$(basename "$f" .gz)" "${stems:-/dev/null}" || rm -f "$f"
      done
  [ -z "$stems" ] || rm -f "$stems"
  return 0
}

# write_progress_md [agent ctx] — regenerate .harness/progress.md (<= 60 lines);
# a given agent/ctx pair saves reading that transcript twice
write_progress_md() {
  local known=${1:-} knownctx=${2:-} c
  local ASK_DIR=.harness/asks ASK_KEY="" ASK_WT=""   # the Workers line describes the main root, even from a worktree ask
  local tmp="$PROGRESS_MD.tmp.$$" branch goal a f q fields line=""
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
  goal="(unset)"
  if [ -s .harness/goal.md ]; then
    goal=$(tr '\n' ' ' < .harness/goal.md | sed 's/  */ /g; s/ $//' | cut -c1-400)
  fi
  {
    printf '# Progress — %s (%s)\n' "$(basename "$PWD")" "$branch"
    printf 'Goal: %s\n' "$goal"
    printf '## Recent asks (newest first, max 15)\n'
    grep -v '"event":"close"' "$JSONL" 2>/dev/null | tail -n 15 | jq -r -R 'fromjson? | "- \(.ts) \(.agent) \(if .late then "late report" else "exit \(.exit)" end) verify \(.verify // "-") \(.head_before // "")..\(.head_after // "") — \(.summary // "")"' 2>/dev/null \
      | awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) print a[i] }'
    q=$(grep '"event":"close"' "$JSONL" 2>/dev/null | tail -n 5 | jq -r -R 'fromjson? | "\(.ts) \(.role) (\(.reason // "?"))"' 2>/dev/null \
      | awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) printf "%s%s", (i == NR ? "" : "; "), a[i]; if (NR) print "" }')
    [ -z "$q" ] || printf 'Recent closes (max 5): %s\n' "$q"
    for f in $(ls -t .harness/reports/*.md 2>/dev/null); do
      q=$(awk '/^## Open questions/ { on = 1; next } /^## / { on = 0 } on && /^- / { if (tolower($0) !~ /^- *none *$/) print }' "$f" | head -n 10)
      if [ -n "$q" ]; then
        printf '## Open questions (from %s)\n%s\n' "$(basename "$f" .md)" "$q"
        break
      fi
    done
    printf '## Workers\n'
    for a in $AGENTS; do
      if use_hl "$a"; then
        q=$(hl_status_line "$a" progress)
      elif ! herdr_env_ok; then
        q="$a -"
      elif fields=$(agent_fields "$a"); then
        if [ "$a" = "$known" ]; then c=$knownctx; else c=$(ctx_tokens "$a"); fi
        q="$a ${fields%%$TAB*} ctx $(fmt_ctx "$c")"
      else
        q="$a -"
      fi
      if [ -z "$line" ]; then line=$q; else line="$line · $q"; fi
    done
    printf -- '- %s\n' "$line"
  } 2>/dev/null | head -n 60 > "$tmp" && mv "$tmp" "$PROGRESS_MD"
}

# verify_tool ARGS... — run harness-verify from PATH (installed by ./install.sh)
verify_tool() {
  command -v harness-verify >/dev/null 2>&1 || return 1
  harness-verify "$@"
}

# restore_interrupted <agent> <report> — implementer only: the Stop hook hides the
# report as <report>.pending while it verifies. If the hook was killed, only the
# .pending file is left: restore it and exit 5. Callers must have checked the agent
# is idle/done (a working agent may still be verifying; never restore then).
restore_interrupted() {
  [ "$1" = implementer ] && [ ! -f "$2" ] && [ -f "$2.pending" ] || return 0
  mv -f "$2.pending" "$2"
  stamp_finished "$1"
  cat "$2"
  echo "verify: INTERRUPTED"
  exit 5
}

# learned_has_evidence <text> — the bullet cites an ask-id, a commit (7-40 hex with a
# letter a-f and a digit, standalone), path/file.ext:line (path has a / or an extension),
# a .harness/ path or a .log file. `step:2`, `host:8080` and bare numbers do not count.
learned_has_evidence() {
  printf '%s\n' "$1" | grep -Eq '(^|[^0-9])[0-9]{9,}-[0-9]+-[0-9]+|[A-Za-z0-9_.-]*/[A-Za-z0-9_./-]*:[0-9]+|[A-Za-z0-9_-]+\.[A-Za-z][A-Za-z0-9]{0,4}:[0-9]+|\.harness/|\.log([^A-Za-z]|$)' && return 0
  printf '%s\n' "$1" | grep -Eo '(^|[^0-9A-Za-z])[0-9a-f]{7,40}($|[^0-9A-Za-z])' | grep '[0-9]' | grep -q '[a-f]' && return 0
  return 1
}

# queue_learned <agent> <report> — copy up to 2 evidence-backed bullets of the
# report's optional `## Notes` section (legacy `## Learned` is also accepted) to docs/wiki/inbox/<date>-<role>-<ask-id>.md,
# only when docs/wiki/ already exists at the repo top level. Indented continuation
# lines are joined to their bullet. Prints one stdout line when queued; bullets
# without evidence are dropped with a one-line stderr warning. Never fails the
# caller (idempotent per role+ask-id; no ask-id -> skipped with a warning).
queue_learned() {
  local agent=$1 report=$2 raw line kept="" n=0 dropped=0 askid date out top
  raw=$(awk '
    function flush() { if (cur != "") print cur; cur = "" }
    /^## (Learned|Notes)[ \t]*$/ { on = 1; next }
    on && (/^## / || /^VERDICT:/) { flush(); on = 0 }
    on && /^[ \t]*[-*] / { flush(); cur = $0; sub(/^[ \t]*[-*] +/, "- ", cur); next }
    on && cur != "" && /^[ \t]+[^ \t]/ { t = $0; sub(/^[ \t]+/, "", t); cur = cur " " t; next }
    on && /^[ \t]*$/ { flush() }
    END { flush() }
  ' "$report" 2>/dev/null) || return 0
  [ -n "$raw" ] || return 0
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
  [ -d "$top/docs/wiki" ] || return 0
  while IFS= read -r line; do
    case "$line" in "- none"|"- None"|"- none."|"- -") continue ;; esac
    if learned_has_evidence "$line"; then
      n=$((n + 1))
      [ "$n" -le 2 ] && kept="$kept$line
"
    else
      dropped=$((dropped + 1))
    fi
  done <<EOF_LEARNED
$raw
EOF_LEARNED
  [ "$dropped" -eq 0 ] || echo "harness: wiki: dropped $dropped Notes bullet(s) without evidence (ask-id, commit, file:line or log)" >&2
  [ -n "$kept" ] || return 0
  askid=$(awk 'NR == 1 { print $1 }' "$ASK_DIR/$agent.current" 2>/dev/null)
  if [ -z "$askid" ]; then
    echo "harness: wiki: no ask-id for $agent; Notes bullets not queued" >&2
    return 0
  fi
  date=$(date +%Y-%m-%d)
  # shellcheck disable=SC2144
  ls "$top"/docs/wiki/inbox/*-"$agent-$askid".md >/dev/null 2>&1 && return 0
  out="docs/wiki/inbox/$date-$agent-$askid.md"
  mkdir -p "$top/docs/wiki/inbox" 2>/dev/null || return 0
  { printf -- '---\nrole: %s\nask-id: %s\ndate: %s\n---\n' "$agent" "$askid" "$date"; printf '%s' "$kept"; } > "$top/$out" 2>/dev/null || return 0
  n=$(printf '%s' "$kept" | grep -c '^- ')
  echo "wiki: $n lesson$([ "$n" -eq 1 ] || echo s) queued in $out"
}

# finish_report <agent> <report> <pane> — print the report and exit with the
# verification-aware status (0 pass · 3 reviewer without VERDICT · 5 failed)
finish_report() {
  local agent=$1 report=$2 pane=$3 last vj st
  queue_learned "$agent" "$report"
  case "$agent" in
    implementer)
      vj=".harness/verify/implementer.json"
      st=$(jq -r '.status // empty' "$vj" 2>/dev/null)
      cat "$report"
      if [ "$st" = fail ]; then
        echo "verify: FAIL ($(jq -r '.step // "?"' "$vj" 2>/dev/null), $(jq -r '.attempts // 0' "$vj" 2>/dev/null) attempts)"
        exit 5
      fi
      exit 0 ;;
    reviewer)
      last=$(awk 'NF { l = $0 } END { print l }' "$report")
      case "$last" in
        "VERDICT: PASS") cat "$report"; exit 0 ;;
        "VERDICT: FAIL") cat "$report"; exit 5 ;;
      esac
      echo "harness: reviewer report has no final 'VERDICT: PASS|FAIL' line; ask it to rewrite the report." >&2
      case "$pane" in ''|-) ;; *) show_pane_screen "$pane" ;; esac
      exit 3 ;;
  esac
  cat "$report"
  exit 0
}

# kill_tree <pid> — TERM pid and all its descendants (macOS has no setsid)
kill_tree() {
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done
  kill "$1" 2>/dev/null
  return 0
}

# ask_finish [rc] — replay the buffered stdout, log the ask, remove the temp
# file, exit. Runs once: normally after the inner ask, or from the EXIT/TERM/INT
# trap when the wrapper is killed mid-wait (rc 143/130 then).
ask_finish() {
  [ "$ASK_DONE" = 0 ] || return 0
  ASK_DONE=1
  local rc=${1:-1}
  if [ -n "$ASK_PID" ] && kill -0 "$ASK_PID" 2>/dev/null; then
    kill_tree "$ASK_PID"
  fi
  cat "$ASK_TMP" 2>/dev/null
  if [ -n "${ASK_ERR:-}" ] && [ -f "$ASK_ERR" ]; then cat "$ASK_ERR" >&2; fi
  record_progress "$ASK_AGENT" "$ASK_TEXT" "$rc" "$ASK_T0" "$ASK_HB" "$ASK_TMP" "$CTX_BEFORE" \
    || echo "harness: could not write the progress log (ask result unchanged)" >&2
  record_route_delegate "$ASK_AGENT" "${ASK_VIA:-conductor}" "$rc"
  retro_on_ask "$ASK_AGENT" "$rc" || true
  rm -f "$ASK_TMP" "${ASK_ERR:-}" "${ASK_PF:-}" "$ASK_DIR/$ASK_AGENT.clear"
  if [ -n "$ASK_WT" ]; then
    # a worktree ask has no role slot to stamp or close: collect, then remove the checkout when clean
    ( wt_after_ask "$rc" ) || true
    exit "$rc"
  fi
  # a printed report (0, or 5 = failed verification/FAIL verdict) counts as collected
  case "$rc" in 0|5) stamp_finished "$ASK_AGENT" ;; esac
  maybe_close_after_ask "$ASK_AGENT" "$rc"
  exit "$rc"
}

# cmd_ask — runs ask_inner (which exits through many paths) in a background
# subshell and waits, then logs the outcome. Output and exit code are the inner
# ones; logging problems only warn on stderr.
cmd_ask() {
  [ "${HARNESS_ROLE:-}" != worker ] || die "harness ask/spawn is for the conductor; a worker (HARNESS_ROLE=worker) does its task itself"
  local agent=${1:-} text=${2:-} cb
  case " $AGENTS " in *" $agent "*) ;; *) ask_inner "$@" ;; esac
  [ -n "$text" ] || ask_inner "$@"
  ask_parse_args "$@"
  ask_via_check
  ask_wt_check "$agent"
  ASK_PF=".harness/asks/$agent.preflight"
  if [ "$ASK_WT_WANT" = 1 ]; then
    wt_capacity_check
    ASK_ID="$(date +%s)-$$-$RANDOM"; ASK_ID8=$(repo_hash8 "$ASK_ID")
    ASK_WT="$WT_HOME/$REPO8/$agent-$ASK_ID8"; ASK_KEY="$agent@$ASK_ID8"
    ASK_DIR="$ASK_WT/.harness/asks"; REPORT_DIR="$ASK_WT/.harness/reports"
    ASK_PF=".harness/asks/$agent@$ASK_ID8.preflight"
  fi
  use_hl "$agent" || need_herdr
  ASK_TMP=$(mktemp "${TMPDIR:-/tmp}/harness-ask.XXXXXX") || ask_inner "$@"
  ASK_AGENT=$agent ASK_TEXT=$text ASK_DONE=0 ASK_PID=""
  rm -f "$ASK_PF" "$ASK_DIR/$agent.clear"
  ASK_T0=$(date +%s); ASK_HB=$(git_head); cb=""
  use_hl "$agent" || cb=$(ctx_tokens "$agent" 2>/dev/null) || cb=""
  CTX_BEFORE=$cb
  trap 'ask_finish 143' TERM
  trap 'ask_finish 130' INT
  trap 'ask_finish 129' HUP
  trap 'ask_finish "$?"' EXIT
  ASK_ERR=$(mktemp "${TMPDIR:-/tmp}/harness-err.XXXXXX") || ASK_ERR=   # not harness-ask.*: tests glob that prefix
  ( ask_inner "$@" ) > "$ASK_TMP" 2> "${ASK_ERR:-/dev/null}" &
  ASK_PID=$!
  wait "$ASK_PID"
  ask_finish "$?"
}

ask_inner() {
  local agent=${1:-} text=${2:-} timeout=$ASK_TIMEOUT fresh=$ASK_FRESH keep=$ASK_KEEP
  [ -n "$agent" ] && [ -n "$text" ] || usage
  valid_agent "$agent"
  [ "$ASK_BAD" = 0 ] || usage      # a bad option found by ask_parse_args: usage error, logged

  # pre-flight passed: an exit 1 from here on is an infrastructure failure, not a usage
  # error, and queues a retro candidate (retro_on_ask looks for this marker file; the ask
  # runs in a subshell, so a variable would not reach the wrapper)
  if [ -n "${ASK_PF:-}" ]; then mkdir -p .harness/asks 2>/dev/null; : > "$ASK_PF" 2>/dev/null; fi

  if [ "$agent" = implementer ] && ! command -v harness-verify >/dev/null 2>&1; then
    die "harness-verify not found on PATH; run ./install.sh (the implementer's checks would silently not run)"
  fi

  if [ -n "$ASK_WT" ]; then wt_create || exit 1; fi

  # headless roles (decision 0007) never touch herdr agents: run claude -p in a viewer pane
  if is_headless "$agent"; then ask_headless "$agent" "$text" "$timeout" "$fresh" "$keep"; fi

  local pane existed=0
  agent_fields "$agent" >/dev/null && existed=1
  pane=$(cmd_spawn "$agent") || exit $?

  local report="$REPORT_DIR/$agent.md"

  # A worker still busy with a previous instruction (e.g. the caller's own
  # timeout fired) keeps its pending report; do not prompt it again.
  if [ "$(agent_status "$agent")" = working ]; then
    echo "harness: $agent is still working on the previous instruction; wait (harness status) then collect with: harness report $agent" >&2
    show_pane_screen "$pane"
    exit 4
  fi

  # a live worker starts the task with a cleared context (never a fresh spawn)
  maybe_reset "$agent" "$fresh" "$keep" "$existed" "${CTX_BEFORE:-}"
  [ -z "$RESET_PANE" ] || pane=$RESET_PANE

  # --keep after a close/reap: the old conversation is gone (note is consumed by any ask)
  if [ -f ".harness/asks/$agent.closed" ]; then
    if [ "$keep" = 1 ]; then
      echo "harness: note: $agent was closed ($(awk 'NR==1 { print $2 }' ".harness/asks/$agent.closed")) — previous context is gone; running on a fresh worker"
    fi
    rm -f ".harness/asks/$agent.closed"
  fi

  mkdir -p "$REPORT_DIR"
  if [ -f "$report" ]; then
    archive_late "$agent" "$report" || {
      echo "harness: could not archive the leftover report; kept as $report.unlogged" >&2
      mv -f "$report" "$report.unlogged"
    }
  fi
  rm -f "$report"

  # implementer: record the start state so the Stop hook can tell "no changes"
  # from "changes to verify" (never fatal)
  if [ "$agent" = implementer ]; then
    # baseline reads the last result (keeps the base after a fail) and clears it;
    # if it cannot run, clear the stale result ourselves
    verify_tool baseline implementer 2>/dev/null || rm -f .harness/verify/implementer.json
  fi

  if [ "$(agent_status "$agent")" = blocked ]; then
    echo "harness: $agent is blocked on a prompt; answer it before sending work." >&2
    show_pane_screen "$pane"
    exit 2
  fi

  # Completion = the worker's Stop hook wrote .harness/done/<agent>.<ask-id>
  # AND the report is newer than this ask. herdr's idle/done is only a hint.
  local ask_id ask_start
  ask_id="$(date +%s)-$$-$RANDOM"
  rm -f ".harness/done/$agent".* 2>/dev/null
  mkdir -p .harness/asks .harness/done
  ask_start=$(date +%s)
  rm -f ".harness/asks/$agent.finished"
  printf '%s %s\n' "$ask_id" "$ask_start" > ".harness/asks/$agent.current"

  # The instruction goes in herdr's positional text slot, which is what keeps
  # dash-leading text from being parsed as an option. Do not add `--`: real
  # herdr rejects it.
  local out prompt_failed=0
  if ! out=$(herdr agent prompt "$(wname "$agent")" "$text" --wait --timeout "$timeout" 2>&1); then
    prompt_failed=1
    echo "harness: prompt did not settle: $out" >&2
  fi

  local has_marker has_pending st grace=${HARNESS_IDLE_GRACE:-30} poll=${HARNESS_POLL_SEC:-2}
  local deadline=$((ask_start + (timeout + 999) / 1000)) idle_since="" now
  case "$grace" in ''|*[!0-9]*) grace=30 ;; esac
  while :; do
    if ask_complete "$agent" "$ask_id" "$report"; then
      finish_report "$agent" "$report" "$pane"
    fi
    st=$(agent_status "$agent")
    now=$(date +%s)
    case "$st" in
      blocked)
        echo "harness: $agent is blocked (needs an answer)." >&2
        show_pane_screen "$pane"
        exit 2 ;;
      idle|done)
        # Idle grace applies only to a worker whose Stop hook never fired.
        # has_marker has_pending:
        #   10 turn ended (maybe waiting on background tasks): keep waiting.
        #   01 verify running (or the hook was killed): keep waiting.
        #   11 earlier-turn marker + verify running now (bg-wait resume): keep waiting.
        #   00 no signal at all: grace, then give up.
        # While .pending exists the only ways out are completion or the deadline
        # (which restores the interrupted report: exit 5).
        has_marker=0; has_pending=0
        [ -f ".harness/done/$agent.$ask_id" ] && has_marker=1
        [ "$agent" = implementer ] && [ -f "$report.pending" ] && has_pending=1
        if [ "$has_marker" = 1 ] || [ "$has_pending" = 1 ]; then
          idle_since=""
        else
          [ -n "$idle_since" ] || idle_since=$now
          if [ $((now - idle_since)) -ge "$grace" ]; then
            ask_idle_giveup "$agent" "$report" "$pane" "$prompt_failed" "$out"
          fi
        fi ;;
      working) idle_since="" ;;
      *)
        echo "harness: $agent status is '$st' (still working or unknown); check 'harness status' before re-prompting." >&2
        show_agent_diag "$agent"
        show_pane_screen "$pane"
        exit 4 ;;
    esac
    if [ "$now" -ge "$deadline" ]; then
      if [ -f ".harness/done/$agent.$ask_id" ] && [ ! -f "$report.pending" ]; then
        if [ -f "$report" ]; then
          echo "harness: $agent has a report but its Stop hook has not signalled yet (earlier-turn marker only); check harness status / harness report $agent" >&2
        else
          echo "harness: $agent's turn ended without a report (maybe waiting on background tasks); check harness status / harness report $agent" >&2
        fi
        show_pane_screen "$pane"
        exit 4
      fi
      if [ "$agent" = implementer ] && [ -f "$report.pending" ] && [ ! -f "$report" ]; then
        case "$st" in
          idle|done) restore_interrupted "$agent" "$report" ;;
          *)
            echo "harness: $agent is still verifying (Stop hook running); run harness status, then harness report $agent when idle" >&2
            show_pane_screen "$pane"
            exit 4 ;;
        esac
      fi
      echo "harness: $agent status is '$st' (still working or unknown) after $((timeout / 1000))s; check 'harness status' before re-prompting." >&2
      show_agent_diag "$agent"
      show_pane_screen "$pane"
      exit 4
    fi
    sleep "$poll"
  done
}

# digits_only <string> — succeed only for a non-empty all-digit string
digits_only() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
}

# file_mtime <file> — epoch seconds. GNU `stat -c %Y` first (BSD/macOS stat has no
# -c and fails); `stat -f %m` second (on GNU, -f is filesystem mode and prints junk,
# so every result is validated as all digits).
file_mtime() {
  local mt
  mt=$(stat -c %Y "$1" 2>/dev/null) && digits_only "$mt" && { echo "$mt"; return 0; }
  mt=$(stat -f %m "$1" 2>/dev/null) && digits_only "$mt" && { echo "$mt"; return 0; }
  return 1
}

# ask_complete <agent> <ask-id> <report> — the worker's Stop hook marked this ask
# done AFTER the report was last written (marker epoch >= report mtime, so a marker
# from an earlier turn never completes a later report), and the report is not older
# than this ask's start (.harness/asks/<agent>.current).
ask_complete() {
  local marker=".harness/done/$1.$2" cur=".harness/asks/$1.current" mt me
  [ -f "$marker" ] && [ -f "$3" ] || return 1
  [ -f "$cur" ] && [ ! "$3" -ot "$cur" ] || return 1
  mt=$(file_mtime "$3") || return 1
  me=$(awk 'NR==1 { print $2 }' "$marker" 2>/dev/null)
  digits_only "$me" || return 1
  [ "$me" -ge "$mt" ]
}

# ask_idle_giveup — herdr says idle/done and the worker's Stop hook never signalled
# this ask (an old worker without the hook): no marker showed up within the grace
ask_idle_giveup() {
  local agent=$1 report=$2 pane=$3 prompt_failed=$4 out=$5
  restore_interrupted "$agent" "$report"
  if [ "$prompt_failed" = 1 ]; then
    echo "harness: prompt was not accepted by herdr: $out" >&2
    show_agent_diag "$agent"
    show_pane_screen "$pane"
    exit 4
  fi
  local hint="its Stop hook never signalled completion (a worker started before the hook needs a respawn: harness close $agent, or close the pane; or the Stop hook ran from a directory without .harness: check the worker's cwd)"
  if [ -f "$report" ]; then
    echo "harness: $agent is idle but $hint; a report exists. Collect it with: harness report $agent; respawn with: harness close $agent to load the Stop hook"
  else
    echo "harness: $agent finished but wrote no report at $report; $hint"
  fi
  show_pane_screen "$pane"
  exit 3
}

cmd_report() {
  local agent=${1:-}
  [ -n "$agent" ] || usage
  case " $AGENTS " in *" $agent "*) ;; *) wt_lookup "$agent" >/dev/null && report_wt "$(wt_lookup "$agent")" ;; esac
  valid_agent "$agent"
  local report="$REPORT_DIR/$agent.md" fields
  if use_hl "$agent"; then report_headless "$agent"; fi
  need_herdr
  fields=$(agent_fields "$agent")
  ! agent_fields "$agent" >/dev/null || check_worker_cwd "$agent" "$(agent_json "$agent")"
  if [ "${fields%%$TAB*}" = working ]; then
    echo "harness: $agent is still working; wait for it to finish (harness status), then run: harness report $agent" >&2
    exit 4
  fi
  restore_interrupted "$agent" "$report"
  if [ -f "$report" ]; then
    retro_on_report "$agent" "$report" || true
    # collecting a finished worker's report restarts its idle clock
    case "${fields%%$TAB*}" in idle|done) stamp_finished "$agent" ;; esac
    finish_report "$agent" "$report" "${fields#*$TAB}"
  fi
  echo "harness: no report for $agent at $report" >&2
  exit 3
}

cmd_status() {
  local a fields
  for a in $AGENTS; do
    if use_hl "$a"; then
      hl_status_line "$a" status
    elif ! herdr_env_ok; then
      printf '%-12s %s\n' "$a" "-"   # a pane-mode role needs herdr; nothing to ask
    elif fields=$(agent_fields "$a"); then
      printf '%-12s %-8s %-8s %s\n' "$a" "${fields%%$TAB*}" "${fields#*$TAB}" "$(fmt_ctx "$(ctx_tokens "$a")")"
    else
      printf '%-12s %s\n' "$a" "-"
    fi
  done
  wt_status_lines
}

# --- pane lifecycle: close, after-ask policy, idle TTL ------------------------------------
CONFIG_FILE=".harness/config.json"

# config_template — the documented default config (what ensure_config writes)
config_template() {
  cat <<'EOC'
{
  "_doc": "close_after_ask.<role>: never | on_success (close the worker after `harness ask` exits 0; reviewer: 0 or 5). idle_ttl_minutes: close this repo's workers idle longer than N minutes after their last collected report (0 = off). HARNESS_NO_AUTOCLOSE=1 disables both. Env overrides: HARNESS_CLOSE_AFTER_ASK_<ROLE>, HARNESS_IDLE_TTL_MINUTES.",
  "close_after_ask": { "analyst": "never", "implementer": "never", "reviewer": "never" },
  "idle_ttl_minutes": 30,
  "viewer": "auto"
}
EOC
}

# ensure_config — create the documented default config when absent (never fatal).
# An existing file that is byte-for-byte the pre-decision-0006 template (implementer
# on_success) is rewritten once with the current one; any edited file is left alone.
ensure_config() {
  # Never creates .harness/ (stray dirs break harness-verify's root lookup): `harness init`
  # does that. Workers and anything outside an initialised checkout (no .harness/asks) skip.
  [ "${HARNESS_ROLE:-}" != worker ] || return 0
  [ -d .harness/asks ] || return 0
  if [ -e "$CONFIG_FILE" ]; then
    local old
    old=$(config_template | sed '/"viewer":/d; s/"implementer": "never"/"implementer": "on_success"/; s/"idle_ttl_minutes": 30,$/"idle_ttl_minutes": 30/')
    [ "$(cat "$CONFIG_FILE" 2>/dev/null)" = "$old" ] && config_template > "$CONFIG_FILE" 2>/dev/null
    return 0
  fi
  config_template > "$CONFIG_FILE" 2>/dev/null
  return 0
}

# close_after_policy <role> — never|on_success (env, then config, then default)
close_after_policy() {
  local up v def=$HARNESS_CLOSE_AFTER_DEFAULT
  up=$(printf %s "$1" | tr 'a-z' 'A-Z')
  eval "v=\${HARNESS_CLOSE_AFTER_ASK_$up:-}"
  [ -n "$v" ] || v=$(jq -r --arg r "$1" '.close_after_ask[$r] // empty' "$CONFIG_FILE" 2>/dev/null)
  case "$v" in never|on_success) echo "$v" ;; *) echo "$def" ;; esac
}

# idle_ttl_minutes — non-negative integer (0 = off)
idle_ttl_minutes() {
  local v=${HARNESS_IDLE_TTL_MINUTES:-}
  [ -n "$v" ] || v=$(jq -r '.idle_ttl_minutes // empty' "$CONFIG_FILE" 2>/dev/null)
  digits_only "$v" || v=$HARNESS_IDLE_TTL_DEFAULT
  echo "$v"
}

# stamp_finished <agent> — mark the agent's report as collected now;
# .harness/asks/<agent>.finished mtime = idle-since
stamp_finished() {
  [ -z "$ASK_WT" ] || return 0
  mkdir -p .harness/asks 2>/dev/null && : > ".harness/asks/$1.finished" 2>/dev/null
  return 0
}

# has_uncollected <agent> — 0 when the agent has a report nobody collected: a
# .pending file, or a report that no collected-stamp covers (missing stamp, report
# newer than the stamp, or a newer ask in flight)
has_uncollected() {
  local r="$REPORT_DIR/$1.md" f=".harness/asks/$1.finished" c=".harness/asks/$1.current"
  [ -f "$r.pending" ] && return 0
  [ -f "$r" ] || return 1
  [ -f "$f" ] || return 0
  [ "$r" -nt "$f" ] && return 0
  [ -f "$c" ] && [ "$f" -ot "$c" ] && return 0
  return 1
}

# log_close <role> <pane> <reason> [runner] [ask-id] — event line in progress.jsonl (key `role`, not
# `agent`, so per-agent ask lookups never match it) + progress.md refresh
log_close() {
  [ -n "$3" ] || return 0
  mkdir -p .harness 2>/dev/null || return 0
  jq -n -c --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg role "$1" --arg pane "$2" --arg reason "$3" --arg runner "${4:-}" --arg aid "${5:-}" \
    '{ts: $ts, event: "close", role: $role, pane: $pane, reason: $reason, ask_id: (if $aid == "" then null else $aid end)}
     + (if $runner != "" then {runner: $runner} else {} end)' >> "$JSONL" 2>/dev/null
  write_progress_md
  return 0
}

# preflight_close <agent> — sets C_PANE; dies when not running / not harness-made,
# exits 6 for a worker outside this repo
preflight_close() {
  local agent=$1
  C_PANE=$(agent_pane "$agent")
  [ -n "$C_PANE" ] || die "$agent is not running"
  check_worker_cwd "$agent" "$(agent_json "$agent")"
  grep -Fxq -- "$agent $C_PANE" "$PANES_FILE" 2>/dev/null \
    || die "pane $C_PANE was not created by harness; close it yourself"
}

# pane_gone <pane> — poll `herdr pane get` until it reports pane_not_found (any other
# failure, e.g. a socket error, is not proof the pane is gone)
pane_gone() {
  local i=0 out
  while [ "$i" -lt "${HARNESS_CLOSE_POLLS:-10}" ]; do
    out=$(herdr pane get "$1" 2>&1) || case "$out" in *pane_not_found*) return 0 ;; esac
    sleep "${HARNESS_CLOSE_INTERVAL:-0.2}"
    i=$((i + 1))
  done
  return 1
}

# finish_close <agent> <pane> <reason> — herdr pane close (ends the claude process
# in it), drop the registry line, log. Empty reason = not logged (context reset).
finish_close() {
  herdr pane close "$2" >/dev/null || die "pane close failed for $2"
  pane_gone "$2" || die "pane $2 is still present after close; registry entry kept"
  unregister "$1" "$2"
  rm -f ".harness/asks/$1.finished"
  if [ -n "$3" ]; then
    mkdir -p .harness/asks 2>/dev/null && printf '%s %s\n' "$(date +%s)" "$3" > ".harness/asks/$1.closed" 2>/dev/null
  fi
  log_close "$1" "$2" "$3"
  echo "closed $1 ($2)"
}

# close_refusal <agent> <status> — message + 0 when closing now would lose work
close_refusal() {
  case "$2" in
    working|blocked)
      echo "harness: $1 is $2; not closing (use --force to close anyway)" >&2; return 0 ;;
  esac
  if has_uncollected "$1"; then
    echo "harness: $1 has a report that was not collected (harness report $1); not closing (use --force to close anyway)" >&2
    return 0
  fi
  return 1
}

# close_one <agent> <force> <skip-missing> — one scoped worker; rc 0 closed/skipped,
# 4 refused (exits 1/6 through die/check_worker_cwd like the single-agent form)
close_one() {
  local agent=$1 force=$2 skip=$3 fields
  if use_hl "$agent"; then close_headless "$agent" "$force" "$skip"; return $?; fi
  if [ "$skip" = 1 ] && ! herdr_env_ok; then return 0; fi
  need_herdr
  if ! fields=$(agent_fields "$agent"); then
    [ "$skip" = 1 ] && return 0
    die "$agent is not running"
  fi
  preflight_close "$agent"
  if [ "$force" != 1 ] && close_refusal "$agent" "${fields%%$TAB*}"; then return 4; fi
  finish_close "$agent" "$C_PANE" "${CLOSE_REASON:-manual}"
}

# close_legacy <force> — close old unscoped workers (herdr name = role) whose cwd is this repo
close_legacy() {
  local force=$1 a j c pane st rc=0 found=0
  need_herdr
  for a in $AGENTS; do
    j=$(herdr agent get "$a" 2>/dev/null) || continue
    c=$(printf '%s' "$j" | jq -r '.result.agent.cwd // empty' 2>/dev/null)
    if [ -z "$c" ] || ! cwd_in_repo "$c"; then
      echo "harness: unscoped '$a' is not in this repo; left alone" >&2; continue
    fi
    pane=$(printf '%s' "$j" | jq -r '.result.agent.pane_id // empty' 2>/dev/null)
    st=$(printf '%s' "$j" | jq -r '.result.agent.agent_status // "unknown"' 2>/dev/null)
    [ -n "$pane" ] || continue
    found=1
    case "$st" in working|blocked)
      if [ "$force" != 1 ]; then
        echo "harness: legacy $a is $st; not closing (use --force to close anyway)" >&2; rc=4; continue
      fi ;;
    esac
    herdr pane close "$pane" >/dev/null || { echo "harness: pane close failed for $pane" >&2; rc=1; continue; }
    pane_gone "$pane" || { echo "harness: pane $pane is still present after close" >&2; rc=1; continue; }
    unregister "$a" "$pane"
    log_close "$a" "$pane" legacy
    echo "closed legacy $a ($pane)"
  done
  [ "$found" = 1 ] || echo "harness: no legacy unscoped workers for this repo"
  return "$rc"
}

cmd_close() {
  local target="" force=0 a rc=0 r
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --all|--legacy) [ -z "$target" ] || usage; target=$1 ;;
      -*) usage ;;
      *) [ -z "$target" ] || usage; target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || usage
  case "$target" in
    --legacy) close_legacy "$force"; exit $? ;;
    --all)
      for a in $AGENTS; do
        ( close_one "$a" "$force" 1 ); r=$?
        # keep the most significant failure: 6 (other repo) > 4 (refused) > 1
        case "$r" in 0) ;; 6) rc=6 ;; 4) [ "$rc" = 6 ] || rc=4 ;; *) [ "$rc" != 0 ] || rc=$r ;; esac
      done
      # worktree asks too (a live run is refused unless --force, like a plain worker)
      for a in $WT_DIR/*.json; do
        [ -f "$a" ] || continue
        case "$(jq -r '.state // empty' "$a" 2>/dev/null)" in running|kept|creating) ;; *) continue ;; esac
        ( close_wt "$a" "$force" ); r=$?
        case "$r" in 0) ;; 6) rc=6 ;; 4) [ "$rc" = 6 ] || rc=4 ;; *) [ "$rc" != 0 ] || rc=$r ;; esac
      done
      exit "$rc" ;;
  esac
  case " $AGENTS " in
    *" $target "*) ;;
    *) if r=$(wt_lookup "$target"); then ( close_wt "$r" "$force" ); exit $?; fi ;;
  esac
  valid_agent "$target"
  close_one "$target" "$force" 0
  exit $?
}

# maybe_close_after_ask <agent> <rc> — close_after_ask policy, after the ask is logged
maybe_close_after_ask() {
  [ "${HARNESS_NO_AUTOCLOSE:-}" != 1 ] || return 0
  [ "${HARNESS_ROLE:-}" != worker ] || return 0
  local agent=$1 rc=$2 pol pane
  pol=$(close_after_policy "$agent")
  [ "$pol" = on_success ] || return 0
  case "$rc" in
    0) ;;
    5) [ "$agent" = reviewer ] || return 0 ;;
    *) return 0 ;;
  esac
  if use_hl "$agent"; then
    ( CLOSE_REASON=after_ask; close_headless "$agent" 0 1 ) >&2 || true
    return 0
  fi
  # a pane harness did not create is never closed automatically (no noise either)
  herdr_env_ok || return 0
  pane=$(agent_pane "$agent")
  [ -n "$pane" ] && grep -Fxq -- "$agent $pane" "$PANES_FILE" 2>/dev/null || return 0
  # best effort: never changes the ask's exit code; messages go to stderr
  ( CLOSE_REASON=after_ask; close_one "$agent" 0 1 ) >&2 || true
}

# reap_idle — close this repo's scoped workers that are idle/done, have no
# uncollected report and no .pending, and whose last collected report is older than
# idle_ttl_minutes. Workers without a collected-stamp (never asked / unknown) stay.
reap_idle() {
  [ "${HARNESS_NO_AUTOCLOSE:-}" != 1 ] || return 0
  [ "${HARNESS_ROLE:-}" != worker ] || return 0
  local ttl a f mt now st j c pane
  ttl=$(idle_ttl_minutes)
  [ "$ttl" -gt 0 ] || return 0
  now=$(date +%s)
  wt_reap "$ttl" "$now"
  for a in $AGENTS; do
    f=".harness/asks/$a.finished"
    [ -f "$f" ] || continue
    mt=$(file_mtime "$f") || continue
    [ $((now - mt)) -ge $((ttl * 60)) ] || continue
    if use_hl "$a"; then
      hl_alive "$a" && continue
      has_uncollected "$a" && continue
      pane=$(hl_registered_pane "$a")
      # a registered pane cannot be checked or closed while herdr is unusable: leave it alone
      if [ -n "$pane" ] && ! herdr_env_ok; then continue; fi
      ( hl_finish_close "$a" "$pane" ttl ) >&2 || true
      continue
    fi
    herdr_env_ok || continue
    j=$(agent_json "$a") || continue
    c=$(printf '%s' "$j" | jq -r '.result.agent.cwd // empty' 2>/dev/null)
    [ -n "$c" ] && cwd_in_repo "$c" || continue
    st=$(printf '%s' "$j" | jq -r '.result.agent.agent_status // "unknown"' 2>/dev/null)
    case "$st" in idle|done) ;; *) continue ;; esac
    has_uncollected "$a" && continue
    pane=$(printf '%s' "$j" | jq -r '.result.agent.pane_id // empty' 2>/dev/null)
    [ -n "$pane" ] || continue
    grep -Fxq -- "$a $pane" "$PANES_FILE" 2>/dev/null || continue
    ( finish_close "$a" "$pane" ttl ) >&2 || true
  done
  return 0
}

# retro_on_report <agent> <report> — `harness report` collecting the report of an ask that
# ended with an exit other than 0/5 (a late report): queue/extend its candidate. Never fails.
retro_on_report() {
  local agent=$1 report=$2 last rc instr id
  [ -f "$report" ] && [ -f "$JSONL" ] || return 0
  last=$(last_ask_record "$agent" --where '.late != true' --field '"\(.exit)\t\(.instr // "")"')
  rc=${last%%$TAB*}; instr=${last#*$TAB}
  digits_only "$rc" || return 0
  case "$rc" in 0|5) return 0 ;; esac
  case "$instr" in *task-retro.md*) retro_done_from_brief "$report"; return 0 ;; esac
  id=$(awk 'NR == 1 { print $1 }' "$ASK_DIR/$agent.current" 2>/dev/null)
  [ -n "$id" ] || return 0
  [ ! -e "$RETRO_DIR/done/$id.json" ] || return 0
  retro_write "$id" "$agent" "late report" "$rc" "" "" "" "" "$(retro_snapshot "$id" "$report")" late \
    || { [ -f "$RETRO_DIR/$id.json" ] || rm -f "$RETRO_DIR/reports/$id.md"; return 0; }
  echo "retro: candidate queued (late report) — run 'harness retro' when the task is done"
}

# retro_done_from_brief <report> — a retro ask that timed out but whose report later says
# `status: done`: move the candidates named in .harness/task-retro.md to done/ so the next
# `harness retro` does not write the same inbox notes again.
retro_done_from_brief() {
  local id n=0
  [ "$(sed -n 's/^status: *//p' "$1" | head -n 1)" = done ] || return 0
  [ -f .harness/task-retro.md ] || return 0
  mkdir -p "$RETRO_DIR/done" 2>/dev/null || return 0
  for id in $(sed -n 's/^### \([^ ]*\) .*/\1/p' .harness/task-retro.md); do
    [ -f "$RETRO_DIR/$id.json" ] || continue
    retro_to_done "$RETRO_DIR/$id.json" && n=$((n + 1))
  done
  [ "$n" -eq 0 ] || echo "retro: $n candidate$([ "$n" -eq 1 ] || echo s) processed (late retro report)"
}

# retro_brief <n> <candidate-files> <toplevel> — the retro brief on stdout: ask-ids,
# reasons, numbers and file paths only.
retro_brief() {
  local n=$1 files=$2 top=$3 f sl
  printf '# Task: failure retro (%s candidate%s)\n\n' "$n" "$([ "$n" -eq 1 ] || echo s)"
  printf 'Read-only analysis of failed asks. Evidence lives in the files listed per candidate; open only those.\n\n'
  printf '## Candidates\n\n'
  printf '%s' "$files" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    sl=$(jq -r '.stream_log // empty' "$f" 2>/dev/null)
    # rotate_logs gzips old streams: point at the .gz when only that exists
    if [ -n "$sl" ] && [ ! -e "$sl" ] && [ -e "$sl.gz" ]; then sl="$sl.gz"; fi
    jq -r --arg sl "$sl" '"### \(.ask_id) — \(.role), \(.reason)\n- exit: \(.exit // "?") · verify attempts: \(.verify_attempts // "-") · duration: \(.duration_s // "?")s · late: \(.late)\n- log: \(.log // "-")\(if $sl != "" then "\n- stream: \($sl) (raw claude -p stream-json\(if $sl | endswith(".gz") then ", gzip: use gzip -dc" else "" end); read only the lines you need)" else "" end)\n- brief: \(.brief // "-" | if endswith("#brief") then "\(.[:-6]) (its `## Brief` section; the live task file was overwritten since)" else . end)\n- report: \(.report // "-")\n"' "$f" 2>/dev/null
  done
  printf '## What to write\n\n'
  printf 'For each candidate (or one note per group of candidates with the same cause) write at most 120 words as:\n\n'
  printf -- '- **Symptom:** what failed, observable.\n- **Cause:** the verified cause, or "unknown" with what was ruled out.\n- **Next time:** one concrete action.\n- **Evidence:** ask-id plus file:line (code, test, commit). Log and report paths under `.harness/` rotate away, so never cite only those. Mandatory; a note without it is dropped.\n\n'
  printf 'Before writing, read `docs/wiki/index.md`. If an existing troubleshooting page already covers the cause, write only a one-line note "recurrence of <page>" (with the Evidence line) instead of a new lesson; this feeds the 2+ recurrence promotion rule in AGENTS.md.\n\n'
  printf '## Output\n\n'
  if [ -d "$top/docs/wiki" ]; then
    printf 'One file per note: `docs/wiki/inbox/<YYYY-MM-DD>-retro-<ask-id>.md` (the first ask-id of the group), starting with the header lines `role: retro`, `ask-id: <id>`, `date: <YYYY-MM-DD>` between `---` lines.\n'
  else
    printf 'This repo has no docs/wiki: one file per note in `.harness/retro/inbox/<YYYY-MM-DD>-retro-<ask-id>.md`. Do not create docs/wiki.\n'
  fi
  printf 'Skip any ask-id that already has a retro note in the inbox (a file named `*-retro-<ask-id>.md`; a previous retro may have finished after its ask timed out). Other inbox files, such as a role'"'"'s late Notes harvest, do not count.\n'
  printf 'Do not edit wiki pages, index.md or log.md. No fluff, no success stories.\n'
  printf 'Inbox files are committed to git: never copy prompt text, screen text, secrets, tokens, keys or URLs with credentials from the logs; paraphrase the observable symptom.\n'
}

# --- harness retro ---------------------------------------------------------------------------
# cmd_retro [--dry-run] — one analyst ask over every pending candidate. The brief
# (.harness/task-retro.md) holds ask-ids, reasons, numbers and file paths only.
cmd_retro() {
  local dry=0 f n=0 top brief=.harness/task-retro.md rc files=""
  case "${1:-}" in '') ;; --dry-run) dry=1 ;; *) usage ;; esac
  [ $# -le 1 ] || usage
  for f in "$RETRO_DIR"/*.json; do
    [ -f "$f" ] || continue
    files="$files$f
"
    n=$((n + 1))
  done
  if [ "$n" -eq 0 ]; then echo "retro: nothing pending"; return 0; fi
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
  if [ "$dry" = 1 ]; then
    printf '%s' "$files" | while IFS= read -r f; do
      [ -n "$f" ] || continue
      jq -r '"\(.ask_id)\t\(.role)\t\(.reason)"' "$f" 2>/dev/null
    done
    echo "retro: $n candidate$([ "$n" -eq 1 ] || echo s) pending (dry run: no ask sent, nothing written); brief follows"
    echo
    retro_brief "$n" "$files" "$top"
    return 0
  fi
  mkdir -p .harness || die "cannot create .harness/"
  retro_brief "$n" "$files" "$top" > "$brief" || die "cannot write $brief"
  "$BASH" "$0" ask analyst 'Read .harness/task-retro.md and do it.' --via retro --fresh
  rc=$?
  if [ "$rc" -eq 0 ]; then
    mkdir -p "$RETRO_DIR/done"
    printf '%s' "$files" | while IFS= read -r f; do
      [ -n "$f" ] && retro_to_done "$f"
    done
    echo "retro: $n candidate$([ "$n" -eq 1 ] || echo s) processed"
  else
    echo "retro: analyst ask exited $rc; $n candidate$([ "$n" -eq 1 ] || echo s) stay pending" >&2
  fi
  return "$rc"
}

# --- harness checkout: init, doctor (decision 0010) -----------------------------------------
# harness_root DIR -> prints the harness checkout root and returns 0, or returns 1.
# The root is the nearest dir at or above DIR with .harness/asks/, searched up to
# the dir holding .git (file or dir) inclusive; outside git only DIR counts. Same
# rule as enter_root in bin/harness-verify and the body in the three claude/hooks.
harness_root() {
  local start=${1%/} d hit=""
  [ -n "$start" ] || start=/
  d=$start
  while :; do
    if [ -z "$hit" ] && [ -d "$d/.harness/asks" ]; then hit=$d; fi
    if [ -e "$d/.git" ]; then
      [ -n "$hit" ] || return 1
      printf '%s' "$hit"
      return 0
    fi
    [ "$d" = / ] && break
    d=${d%/*}
    [ -n "$d" ] || d=/
  done
  [ -d "$start/.harness/asks" ] || return 1
  printf '%s' "$start"
}

# require_checkout — ask/spawn act only in an initialised checkout; run from a subdir,
# they continue at the checkout root (the conductor cannot cd), so .harness/ stays in one place
require_checkout() {
  local root
  root=$(harness_root "$PWD") || die "not a harness checkout (no .harness/asks); run 'harness init' here first"
  [ "$root" = "$PWD" ] || cd "$root" || die "cannot enter $root"
}

# settings_set_agent FILE — create FILE with {"agent":"conductor"}, or merge the key into it
# (never clobbering other keys); an existing different agent is kept and noted.
settings_set_agent() {
  local f=$1 cur tmp
  if [ ! -e "$f" ]; then
    mkdir -p "${f%/*}" || { echo "harness init: cannot create ${f%/*}" >&2; return 0; }
    jq -n '{agent: "conductor"}' > "$f" && echo "created $f (agent: conductor)"
    return 0
  fi
  if ! jq -e 'type == "object"' "$f" >/dev/null 2>&1; then
    echo "note: $f is not a JSON object; left alone (set \"agent\": \"conductor\" yourself)" >&2
    return 0
  fi
  cur=$(jq -r '.agent // empty' "$f")
  if [ "$cur" = conductor ]; then echo "$f: agent already conductor"; return 0; fi
  if [ -n "$cur" ]; then
    echo "note: $f sets agent \"$cur\"; kept (use --no-agent to silence this)"
    return 0
  fi
  tmp=$(mktemp "${TMPDIR:-/tmp}/harness-settings.XXXXXX") || return 0
  if jq '.agent = "conductor"' "$f" > "$tmp" && mv "$tmp" "$f"; then
    echo "updated $f (agent: conductor)"
  else
    rm -f "$tmp"
    echo "harness init: could not update $f" >&2
  fi
}

# cmd_init [--no-agent] — make the current repo (git toplevel, else the cwd) a harness checkout:
# .harness/asks/, the default config, .claude/settings.json agent=conductor, and .harness/ in
# .git/info/exclude when git does not already ignore it. Idempotent.
cmd_init() {
  [ "${HARNESS_ROLE:-}" != worker ] || die "harness init is for the conductor; a worker (HARNESS_ROLE=worker) does not set up checkouts"
  local agent=1 a top ex
  for a in "$@"; do
    case "$a" in --no-agent) agent=0 ;; *) usage ;; esac
  done
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
  cd "$top" || die "cannot enter $top"
  echo "harness init: $top"
  if [ -d .harness/asks ]; then echo ".harness/asks exists"
  else mkdir -p .harness/asks || die "cannot create .harness/asks"; echo "created .harness/asks"; fi
  if [ -e "$CONFIG_FILE" ]; then echo "$CONFIG_FILE exists"
  else ensure_config init; [ -e "$CONFIG_FILE" ] && echo "created $CONFIG_FILE"; fi
  if [ "$agent" = 1 ]; then settings_set_agent .claude/settings.json
  else echo ".claude/settings.json untouched (--no-agent)"; fi
  if git rev-parse --git-dir >/dev/null 2>&1; then
    if git check-ignore -q .harness/asks/x 2>/dev/null; then echo ".harness/ already ignored by git"
    else
      ex=$(git rev-parse --git-path info/exclude 2>/dev/null)
      if [ -n "$ex" ] && mkdir -p "${ex%/*}" && printf '.harness/\n' >> "$ex"; then echo "added .harness/ to $ex"
      else echo "note: could not add .harness/ to git's exclude file" >&2; fi
    fi
  fi
  return 0
}

# doctor_stray_ok DIR — 0 when a stray .harness/ holds only files this harness wrote itself
# (prints the first other file on stdout and returns 1 otherwise)
doctor_stray_ok() {
  local h=$1 f rel
  while IFS= read -r f; do
    rel=${f#"$h"/}
    case "$rel" in
      config.json|verify.local.json|panes|progress.md|progress.jsonl|routing.jsonl|.DS_Store) ;;
      log/*|reports/*|done/*|retro/*)
        case "$rel" in */*.md|*/*.jsonl|*/*.jsonl.*|*/*.json|*/*.log) ;; *) printf '%s' "$rel"; return 1 ;; esac ;;
      *) printf '%s' "$rel"; return 1 ;;
    esac
  done <<EOF
$(find "$h" -mindepth 1 ! -type d 2>/dev/null)
EOF
  return 0
}

# cmd_doctor [--fix] [DIR...] — find (and with --fix remove) pollution left by older versions:
# stray .harness/ dirs without asks/ (DIR and its children, default: the parent of this repo
# plus the cwd) and the global agent=conductor key in ~/.claude/settings.json. Exit 0.
cmd_doctor() {
  local fix=0 dirs="" d c h seen="" first sf tmp n=0
  for d in "$@"; do
    case "$d" in
      --fix) fix=1 ;;
      -*) usage ;;
      *) dirs="$dirs
$d" ;;
    esac
  done
  if [ -z "$dirs" ]; then
    dirs="${REPO_TOP%/*}
$PWD"
  fi
  while IFS= read -r d; do
    [ -n "$d" ] && [ -d "$d" ] || continue
    d=$(cd "$d" && pwd -P)
    for c in "$d" "$d"/*/; do
      c=${c%/}
      [ -d "$c" ] || continue
      case "$seen" in *"|$c|"*) continue ;; esac
      seen="$seen|$c|"
      h=$c/.harness
      [ -d "$h" ] && [ ! -L "$h" ] && [ ! -d "$h/asks" ] || continue
      n=$((n + 1))
      if first=$(doctor_stray_ok "$h"); then
        if [ "$fix" = 1 ]; then rm -rf "$h" && echo "removed: $h (stray, no asks/)"
        else echo "stray: $h (no asks/)"; fi
      else
        if [ "$fix" = 1 ]; then echo "skipped (unknown files): $h (e.g. $first)"
        else echo "stray: $h (no asks/; has unknown files, e.g. $first; --fix would skip it)"; fi
      fi
    done
  done <<EOF
$dirs
EOF
  sf=${CLAUDE_SETTINGS:-$HOME/.claude/settings.json}
  if [ -f "$sf" ] && [ "$(jq -r '.agent // empty' "$sf" 2>/dev/null)" = conductor ]; then
    n=$((n + 1))
    if [ "$fix" = 1 ]; then
      tmp=$(mktemp "${TMPDIR:-/tmp}/harness-settings.XXXXXX") || return 0
      if jq 'del(.agent)' "$sf" > "$tmp" && mv "$tmp" "$sf"; then echo "removed: agent key from $sf"
      else rm -f "$tmp"; echo "harness doctor: could not update $sf" >&2; fi
    else
      echo "global: $sf sets agent conductor (harness init sets it per repo; --fix removes it)"
    fi
  fi
  [ "$n" -gt 0 ] || echo "doctor: nothing to clean"
  return 0
}

need jq
# route-log is called by the UserPromptSubmit hook: no herdr needed
if [ "${1:-}" = route-log ]; then shift; cmd_route_log "$@"; exit 0; fi
# _mtime prints a file's epoch mtime (tests: fake GNU/BSD stat on PATH)
if [ "${1:-}" = _mtime ]; then file_mtime "${2:-}"; exit $?; fi
# _defaults prints the shared defaults as KEY=VALUE (tests: prose copies are checked against it)
if [ "${1:-}" = _defaults ]; then
  for k in $(compgen -v HARNESS_ | grep -E '^HARNESS_(ROLES|WT_ROLES|[A-Z_]+_(MS|DEFAULT))$' | sort); do eval "printf '%s=%s\n' \"$k\" \"\${$k}\""; done
  exit 0
fi
# _wname prints the scoped herdr name for a role (tests, debugging): no herdr needed
if [ "${1:-}" = _wname ]; then valid_agent "${2:-}"; wname "$2"; echo; exit 0; fi
# init and doctor are file work: no herdr, no checkout needed
if [ "${1:-}" = init ]; then shift; cmd_init "$@"; exit $?; fi
if [ "${1:-}" = doctor ]; then shift; cmd_doctor "$@"; exit $?; fi
# wiki-lint is pure file checking: no herdr needed
if [ "${1:-}" = wiki-lint ]; then shift; cmd_wiki_lint "$@"; exit $?; fi
# retro and metrics read files only; retro's ask is a separate `harness ask` process
if [ "${1:-}" = retro ]; then shift; cmd_retro "$@"; exit $?; fi
if [ "${1:-}" = metrics ]; then shift; cmd_metrics "$@"; exit $?; fi

# ask/spawn act only in an initialised checkout (decision 0010); status/report/close work anywhere
case "${1:-}" in
  spawn|ask) [ "${HARNESS_ROLE:-}" = worker ] || require_checkout ;;
esac
case "${1:-}" in
  spawn|ask|status) ensure_config "$1"; reap_idle ;;
esac
case "${1:-}" in
  spawn)  shift; cmd_spawn "$@" ;;
  ask)    shift; cmd_ask "$@" ;;
  report) shift; cmd_report "$@" ;;
  status) cmd_status ;;
  _projdir) shift; project_dir_name "${1:-$(pwd -P)}"; echo ;;
  close)  shift; cmd_close "$@" ;;
  *)      usage ;;
esac
exit $?
}
