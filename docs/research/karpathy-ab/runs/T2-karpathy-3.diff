diff --git a/install.sh b/install.sh
index f32afa1..c8ecb81 100755
--- a/install.sh
+++ b/install.sh
@@ -25,17 +25,39 @@ die() { echo "install: $*" >&2; exit 1; }
 need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not on PATH"; }
 
 if [ "${1:-}" = "--test" ]; then
-  rc=0
-  /bin/bash "$REPO/tests/gate.test.sh"    || rc=1
-  /bin/bash "$REPO/tests/harness.test.sh" || rc=1
-  /bin/bash "$REPO/tests/verify.test.sh"  || rc=1
-  /bin/bash "$REPO/tests/progress.test.sh" || rc=1
-  /bin/bash "$REPO/tests/route.test.sh"   || rc=1
-  /bin/bash "$REPO/tests/install.test.sh" || rc=1
-  /bin/bash "$REPO/tests/wiki.test.sh"    || rc=1
-  /bin/bash "$REPO/tests/retro.test.sh"   || rc=1
+  rc=0; failed=""
+  # Suites run in parallel (each has its own mktemp dirs); output is buffered per
+  # suite and printed as one block when the suite finishes. HARNESS_TEST_SERIAL=1
+  # runs them one after another, streaming output, for debugging.
+  SUITES="gate harness verify progress route install wiki retro"
+  if [ "${HARNESS_TEST_SERIAL:-0}" = 1 ]; then
+    for s in $SUITES; do
+      /bin/bash "$REPO/tests/$s.test.sh" || { rc=1; failed="$failed $s"; }
+    done
+  else
+    TD=$(mktemp -d); trap 'rm -rf "$TD"' EXIT
+    for s in $SUITES; do
+      ( /bin/bash "$REPO/tests/$s.test.sh" >"$TD/$s.out" 2>&1; echo $? >"$TD/$s.rc"; : >"$TD/$s.done" ) &
+    done
+    left="$SUITES"
+    while [ -n "$left" ]; do
+      rest=""
+      for s in $left; do
+        if [ -e "$TD/$s.done" ]; then
+          echo "=== tests/$s.test.sh ==="; cat "$TD/$s.out"
+          [ "$(cat "$TD/$s.rc")" = 0 ] || { rc=1; failed="$failed $s"; }
+        else
+          rest="$rest $s"
+        fi
+      done
+      left="$rest"
+      [ -n "$left" ] && sleep 0.2
+    done
+    wait
+  fi
   # lint the real wiki so a bad page fails CI
-  /bin/bash "$REPO/bin/harness" wiki-lint "$REPO/docs/wiki" || { echo "wiki-lint FAILED"; rc=1; }
+  /bin/bash "$REPO/bin/harness" wiki-lint "$REPO/docs/wiki" || { echo "wiki-lint FAILED"; rc=1; failed="$failed wiki-lint"; }
+  [ -z "$failed" ] || echo "FAILED suites:$failed"
   exit $rc
 fi
 
