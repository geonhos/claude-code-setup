diff --git a/install.sh b/install.sh
index f32afa1..97b8a22 100755
--- a/install.sh
+++ b/install.sh
@@ -26,14 +26,34 @@ need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not on PATH"
 
 if [ "${1:-}" = "--test" ]; then
   rc=0
-  /bin/bash "$REPO/tests/gate.test.sh"    || rc=1
-  /bin/bash "$REPO/tests/harness.test.sh" || rc=1
-  /bin/bash "$REPO/tests/verify.test.sh"  || rc=1
-  /bin/bash "$REPO/tests/progress.test.sh" || rc=1
-  /bin/bash "$REPO/tests/route.test.sh"   || rc=1
-  /bin/bash "$REPO/tests/install.test.sh" || rc=1
-  /bin/bash "$REPO/tests/wiki.test.sh"    || rc=1
-  /bin/bash "$REPO/tests/retro.test.sh"   || rc=1
+  SUITES="gate harness verify progress route install wiki retro"
+  if [ "${HARNESS_TEST_SERIAL:-0}" = 1 ]; then
+    for s in $SUITES; do /bin/bash "$REPO/tests/$s.test.sh" || rc=1; done
+  else
+    # parallel: one background job per suite, output buffered and printed per suite
+    # in finish order (bash 3.2: no wait -n, so poll the .done markers)
+    OUTD=$(mktemp -d) || die "cannot create temp dir"
+    trap 'rm -rf "$OUTD"' EXIT
+    for s in $SUITES; do
+      ( /bin/bash "$REPO/tests/$s.test.sh" > "$OUTD/$s.out" 2>&1; echo $? > "$OUTD/$s.rc"; : > "$OUTD/$s.done" ) &
+    done
+    failed=""; pending="$SUITES"
+    while [ -n "$pending" ]; do
+      left=""
+      for s in $pending; do
+        if [ -f "$OUTD/$s.done" ]; then
+          src=$(cat "$OUTD/$s.rc")
+          echo "=== tests/$s.test.sh (exit $src) ==="
+          cat "$OUTD/$s.out"
+          [ "$src" = 0 ] || { rc=1; failed="$failed $s"; }
+        else left="$left $s"; fi
+      done
+      pending="$left"
+      [ -z "$pending" ] || sleep 0.2
+    done
+    wait
+    [ -z "$failed" ] || echo "FAILED suites:$failed"
+  fi
   # lint the real wiki so a bad page fails CI
   /bin/bash "$REPO/bin/harness" wiki-lint "$REPO/docs/wiki" || { echo "wiki-lint FAILED"; rc=1; }
   exit $rc
