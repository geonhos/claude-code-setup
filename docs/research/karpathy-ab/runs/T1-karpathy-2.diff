diff --git a/docs/wiki/inbox/2026-10-22-retro-1792643421-12588-9450.md b/docs/wiki/inbox/2026-10-22-retro-1792643421-12588-9450.md
new file mode 100644
index 0000000..60d3d1f
--- /dev/null
+++ b/docs/wiki/inbox/2026-10-22-retro-1792643421-12588-9450.md
@@ -0,0 +1,11 @@
+---
+role: retro
+ask-id: 1792643421-12588-9450
+date: 2026-10-22
+---
+# Stop hook writes no done marker when the worker's cwd is a repo subdirectory
+
+- **Symptom:** two analyst asks exited 3 although a full report existed. The Stop hook ran cleanly (about 30 ms), but no `.harness/done/analyst.<ask-id>` appeared, so the 30 s idle grace gave up. The hint ("respawn") is wrong here.
+- **Cause:** the worker ran `cd <subdir> && …` in Bash, and Claude Code kept that in-repo cwd. The hook's `cwd` was the subdir, `enter_root` changed into it, and `mark_done` read the relative `.harness/asks/<role>.current`, found none and returned 0 silently. This is not a stale-hook respawn case.
+- **Next time:** `enter_root` should go to `git rev-parse --show-toplevel`, and `mark_done` should warn on stderr. `cmd_stop` shares this path.
+- **Evidence:** asks 1792643421-12588-9450, 1792644961-69735-4647; bin/harness-verify:32-34, :243, :258; bin/harness:1083. In transcripts 8884b1fc and b7ce5751 the cwd at `stop_hook_summary` is the subdir.
diff --git a/tests/verify.test.sh b/tests/verify.test.sh
index 13e54ab..128ba89 100644
--- a/tests/verify.test.sh
+++ b/tests/verify.test.sh
@@ -445,5 +445,31 @@ check "done: unsafe ask-id ignored" [ ! -d "$R/.harness/done" ]
 hvw '{"cwd":"'"$R"'"}' done bogus
 check "done: unknown role ignored" [ "$RC" -eq 0 ]
 
+# Stop hook cwd = a repo subdir (worker did `cd .harness`): marker lands at the repo root
+newrepo; doneset
+mkdir -p "$R/.harness/reports" "$R/pkg"
+hvw '{"agent_type":"analyst","session_id":"S3","cwd":"'"$R"'/.harness"}' done analyst
+check "root: no current ask yet -> no marker" [ ! -d "$R/.harness/done" ]
+echo "ask7 5" > "$R/.harness/asks/analyst.current"
+hvw '{"agent_type":"analyst","session_id":"S3","cwd":"'"$R"'/.harness"}' done analyst
+check "root: done from .harness subdir marks at toplevel" [ -f "$R/.harness/done/analyst.ask7" ]
+check "root: no nested .harness/.harness" [ ! -e "$R/.harness/.harness" ]
+hvw '{"agent_type":"analyst","session_id":"S3","cwd":"'"$R"'/pkg"}' done analyst
+check "root: done from plain subdir leaves no stray .harness" [ ! -e "$R/pkg/.harness" ]
+rm -rf "$R/.harness/done"
+hvw "$(stopj false | jq -c --arg c "$R/pkg" '.cwd=$c')" stop
+check "root: stop from subdir marks at toplevel" marker
+check "root: stop from subdir keeps state at toplevel" [ ! -e "$R/pkg/.harness" ]
+
+# missing .current in a worker session: one warning on stderr, exit 0, no marker
+newrepo
+ERR=$(cd "$R" && printf '%s' '{"cwd":"'"$R"'"}' | HARNESS_ROLE=worker /bin/bash "$VERIFY" done reviewer 2>&1 >/dev/null); RC=$?
+OUT=$ERR
+check "warn: missing .current warns on stderr" grep -q 'no current ask' <<<"$ERR"
+check "warn: exactly one line" [ "$(printf '%s\n' "$ERR" | wc -l | tr -d ' ')" = 1 ]
+check "warn: still exit 0" [ "$RC" -eq 0 ]
+ERR=$(cd "$R" && printf '%s' '{"cwd":"'"$R"'"}' | env -u HARNESS_ROLE /bin/bash "$VERIFY" done reviewer 2>&1 >/dev/null)
+check "warn: non-worker stays silent" [ -z "$ERR" ]
+
 echo "PASS $pass / FAIL $fail"
 [ "$fail" -eq 0 ]
