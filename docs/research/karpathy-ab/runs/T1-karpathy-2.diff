diff --git a/bin/harness-verify b/bin/harness-verify
index 50f1563..c36bf7e 100755
--- a/bin/harness-verify
+++ b/bin/harness-verify
@@ -28,9 +28,18 @@ STEP_OUT=""
 RAN=0
 
 # enter_root [dir] — the root is the cwd (hook stdin cwd, else the process cwd);
-# every .harness/ path is relative to it, like bin/harness. Never the git toplevel.
+# every .harness/ path is relative to it, like bin/harness. Hook callers (a cwd
+# argument) whose cwd has no .harness/ move to the git toplevel: a worker that ended
+# its turn after `cd .harness` must still find .harness/asks. A cwd that already
+# holds .harness/ (a deliberate subdir root) stays; run/baseline/detect never hop.
 enter_root() {
-  [ -z "${1:-}" ] || cd "$1" 2>/dev/null || true
+  local top
+  if [ -n "${1:-}" ]; then
+    cd "$1" 2>/dev/null || true
+    if [ ! -d .harness ] && top=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ]; then
+      cd "$top" 2>/dev/null || true
+    fi
+  fi
   ROOT=$(pwd -P)
   if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
     IS_GIT=1
@@ -240,6 +249,10 @@ mark_done() {
   local role=$1 input=$2 id sid tmp
   [ "${HARNESS_ROLE:-}" = worker ] || return 0
   case "$role" in analyst|implementer|reviewer) ;; *) return 0 ;; esac
+  if [ ! -f ".harness/asks/$role.current" ]; then
+    echo "harness-verify: no current ask for $role at $PWD/.harness/asks (no done marker written; check the worker's cwd)" >&2
+    return 0
+  fi
   id=$(awk 'NR==1 { print $1 }' ".harness/asks/$role.current" 2>/dev/null)
   case "$id" in ''|*[!A-Za-z0-9_-]*) return 0 ;; esac
   sid=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)
