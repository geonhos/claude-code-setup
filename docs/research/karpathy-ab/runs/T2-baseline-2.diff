diff --git a/install.sh b/install.sh
index f32afa1..7413dbf 100755
--- a/install.sh
+++ b/install.sh
@@ -6,7 +6,7 @@
 # Idempotent. Re-run after pulling changes.
 #
 #   ./install.sh          install
-#   ./install.sh --test   run the test suites and exit
+#   ./install.sh --test   run the test suites (parallel; HARNESS_TEST_SERIAL=1 for serial) and exit
 #
 # Overridable for tests: CLAUDE_DIR, BIN_DIR, GIT_IGNORE, SKIP_HERDR_INTEGRATION=1
 set -eu
@@ -26,16 +26,41 @@ need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not on PATH"
 
 if [ "${1:-}" = "--test" ]; then
   rc=0
-  /bin/bash "$REPO/tests/gate.test.sh"    || rc=1
-  /bin/bash "$REPO/tests/harness.test.sh" || rc=1
-  /bin/bash "$REPO/tests/verify.test.sh"  || rc=1
-  /bin/bash "$REPO/tests/progress.test.sh" || rc=1
-  /bin/bash "$REPO/tests/route.test.sh"   || rc=1
-  /bin/bash "$REPO/tests/install.test.sh" || rc=1
-  /bin/bash "$REPO/tests/wiki.test.sh"    || rc=1
-  /bin/bash "$REPO/tests/retro.test.sh"   || rc=1
+  SUITES=$(cd "$REPO/tests" && ls ./*.test.sh | sed 's|^\./||')
+  if [ "${HARNESS_TEST_SERIAL:-0}" = 1 ]; then
+    for s in $SUITES; do
+      echo "=== $s ==="
+      /bin/bash "$REPO/tests/$s" || { rc=1; FAILED="${FAILED:-} $s"; }
+    done
+  else
+    # parallel: each suite buffers into its own file; blocks print in finish order
+    TD=$(mktemp -d)
+    trap 'rm -rf "$TD"' EXIT
+    PIDS=""
+    for s in $SUITES; do
+      ( /bin/bash "$REPO/tests/$s" > "$TD/$s.out" 2>&1; echo $? > "$TD/$s.rc.tmp"; mv "$TD/$s.rc.tmp" "$TD/$s.rc" ) &
+      PIDS="$PIDS $!"
+    done
+    left=$SUITES
+    while [ -n "$left" ]; do
+      rest=""
+      for s in $left; do
+        if [ -f "$TD/$s.rc" ]; then
+          echo "=== $s (exit $(cat "$TD/$s.rc")) ==="
+          cat "$TD/$s.out"
+          [ "$(cat "$TD/$s.rc")" = 0 ] || { rc=1; FAILED="${FAILED:-} $s"; }
+        else
+          rest="$rest $s"
+        fi
+      done
+      left=$rest
+      [ -n "$left" ] && sleep 0.2
+    done
+    for p in $PIDS; do wait "$p" 2>/dev/null; done
+  fi
   # lint the real wiki so a bad page fails CI
-  /bin/bash "$REPO/bin/harness" wiki-lint "$REPO/docs/wiki" || { echo "wiki-lint FAILED"; rc=1; }
+  /bin/bash "$REPO/bin/harness" wiki-lint "$REPO/docs/wiki" || { echo "wiki-lint FAILED"; rc=1; FAILED="${FAILED:-} wiki-lint"; }
+  [ "$rc" = 0 ] || echo "FAILED suites:${FAILED:-}"
   exit $rc
 fi
 
