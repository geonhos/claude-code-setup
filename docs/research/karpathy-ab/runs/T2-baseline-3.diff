diff --git a/install.sh b/install.sh
index f32afa1..c47a715 100755
--- a/install.sh
+++ b/install.sh
@@ -6,7 +6,8 @@
 # Idempotent. Re-run after pulling changes.
 #
 #   ./install.sh          install
-#   ./install.sh --test   run the test suites and exit
+#   ./install.sh --test   run the test suites (parallel) and exit;
+#                         HARNESS_TEST_SERIAL=1 runs them one at a time
 #
 # Overridable for tests: CLAUDE_DIR, BIN_DIR, GIT_IGNORE, SKIP_HERDR_INTEGRATION=1
 set -eu
@@ -25,17 +26,44 @@ die() { echo "install: $*" >&2; exit 1; }
 need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not on PATH"; }
 
 if [ "${1:-}" = "--test" ]; then
+  # Suites run in parallel by default (each buffers its output to a temp file and
+  # is printed as one block, in finish order). HARNESS_TEST_SERIAL=1 runs them one
+  # at a time with live output, for debugging.
+  SUITES="gate harness verify progress route install wiki retro"
   rc=0
-  /bin/bash "$REPO/tests/gate.test.sh"    || rc=1
-  /bin/bash "$REPO/tests/harness.test.sh" || rc=1
-  /bin/bash "$REPO/tests/verify.test.sh"  || rc=1
-  /bin/bash "$REPO/tests/progress.test.sh" || rc=1
-  /bin/bash "$REPO/tests/route.test.sh"   || rc=1
-  /bin/bash "$REPO/tests/install.test.sh" || rc=1
-  /bin/bash "$REPO/tests/wiki.test.sh"    || rc=1
-  /bin/bash "$REPO/tests/retro.test.sh"   || rc=1
+  failed=""
+  if [ "${HARNESS_TEST_SERIAL:-0}" = 1 ]; then
+    for s in $SUITES; do
+      echo "=== tests/$s.test.sh ==="
+      /bin/bash "$REPO/tests/$s.test.sh" || { rc=1; failed="$failed $s"; }
+    done
+  else
+    TD=$(mktemp -d)
+    trap 'rm -rf "$TD"' EXIT
+    for s in $SUITES; do
+      ( /bin/bash "$REPO/tests/$s.test.sh" > "$TD/$s.out" 2>&1; echo $? > "$TD/$s.rc.tmp"; mv "$TD/$s.rc.tmp" "$TD/$s.rc" ) &
+    done
+    pending=$SUITES
+    while [ -n "$pending" ]; do
+      left=""
+      for s in $pending; do
+        if [ -f "$TD/$s.rc" ]; then
+          src=$(cat "$TD/$s.rc")
+          echo "=== tests/$s.test.sh (exit $src) ==="
+          cat "$TD/$s.out"
+          [ "$src" = 0 ] || { rc=1; failed="$failed $s"; }
+        else
+          left="$left $s"
+        fi
+      done
+      pending=${left# }
+      [ -z "$pending" ] || sleep 0.2
+    done
+    wait
+  fi
   # lint the real wiki so a bad page fails CI
-  /bin/bash "$REPO/bin/harness" wiki-lint "$REPO/docs/wiki" || { echo "wiki-lint FAILED"; rc=1; }
+  /bin/bash "$REPO/bin/harness" wiki-lint "$REPO/docs/wiki" || { echo "wiki-lint FAILED"; rc=1; failed="$failed wiki-lint"; }
+  [ -z "$failed" ] || echo "FAILED suites:$failed"
   exit $rc
 fi
 
