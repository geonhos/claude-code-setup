diff --git a/docs/wiki/inbox/2026-10-22-retro-1792643421-12588-9450.md b/docs/wiki/inbox/2026-10-22-retro-1792643421-12588-9450.md
new file mode 100644
index 0000000..60d3d1f
--- /dev/null
+++ b/docs/wiki/inbox/2026-10-22-retro-1792643421-12588-9450.md
@@ -0,0 +1,11 @@
+---
+role: retro
+ask-id: 1792643421-12588-9450
+date: 2026-10-22
+---
+# Stop hook writes no done marker when the worker's cwd is a repo subdirectory
+
+- **Symptom:** two analyst asks exited 3 although a full report existed. The Stop hook ran cleanly (about 30 ms), but no `.harness/done/analyst.<ask-id>` appeared, so the 30 s idle grace gave up. The hint ("respawn") is wrong here.
+- **Cause:** the worker ran `cd <subdir> && …` in Bash, and Claude Code kept that in-repo cwd. The hook's `cwd` was the subdir, `enter_root` changed into it, and `mark_done` read the relative `.harness/asks/<role>.current`, found none and returned 0 silently. This is not a stale-hook respawn case.
+- **Next time:** `enter_root` should go to `git rev-parse --show-toplevel`, and `mark_done` should warn on stderr. `cmd_stop` shares this path.
+- **Evidence:** asks 1792643421-12588-9450, 1792644961-69735-4647; bin/harness-verify:32-34, :243, :258; bin/harness:1083. In transcripts 8884b1fc and b7ce5751 the cwd at `stop_hook_summary` is the subdir.
diff --git a/tests/verify.test.sh b/tests/verify.test.sh
index 13e54ab..0213101 100644
--- a/tests/verify.test.sh
+++ b/tests/verify.test.sh
@@ -445,5 +445,28 @@ check "done: unsafe ask-id ignored" [ ! -d "$R/.harness/done" ]
 hvw '{"cwd":"'"$R"'"}' done bogus
 check "done: unknown role ignored" [ "$RC" -eq 0 ]
 
+# hook cwd = a repo subdir without its own .harness (e.g. the worker cd'd into .harness)
+newrepo; doneset
+mkdir -p "$R/sub/dir"
+echo "ask2 5" > "$R/.harness/asks/analyst.current"
+OUT=$(cd "$R/sub/dir" && printf '%s' '{"agent_type":"analyst","session_id":"S3","cwd":"'"$R/sub/dir"'"}' | HARNESS_ROLE=worker /bin/bash "$VERIFY" done analyst 2>/dev/null); RC=$?
+check "done: hook cwd in subdir -> marker at repo root" [ -f "$R/.harness/done/analyst.ask2" ]
+check "done: no marker dir in subdir" [ ! -e "$R/sub/dir/.harness" ]
+OUT=$(cd "$R" && printf '%s' '{"agent_type":"analyst","session_id":"S3","cwd":"'"$R/.harness"'"}' | HARNESS_ROLE=worker /bin/bash "$VERIFY" done analyst 2>/dev/null)
+check "done: hook cwd = .harness -> still root" [ -f "$R/.harness/done/analyst.ask2" ] && [ ! -e "$R/.harness/.harness" ]
+lcfg '{"test":"pwd -P > ran.at"}'
+hv baseline implementer; echo c > "$R/new.txt"
+OUT=$(cd "$R/sub" && printf '%s' "$(jq -n -c --arg c "$R/sub" '{hook_event_name:"Stop",agent_type:"implementer",session_id:"S1",cwd:$c,stop_hook_active:false}')" | HARNESS_ROLE=worker /bin/bash "$VERIFY" stop 2>/dev/null)
+check "done: stop from subdir verifies at repo root" [ "$(cat "$R/ran.at" 2>/dev/null)" = "$(cd "$R" && pwd -P)" ]
+check "done: stop from subdir writes marker at root" marker
+
+# missing .current in a worker session: one stderr warning, exit 0
+newrepo
+ERR=$(cd "$R" && printf '%s' '{"cwd":"'"$R"'"}' | HARNESS_ROLE=worker /bin/bash "$VERIFY" done analyst 2>&1 >/dev/null); RC=$?
+check "done: missing .current warns" [ "$(printf '%s\n' "$ERR" | grep -c 'no current ask')" = 1 ]
+check "done: missing .current exit 0" [ "$RC" -eq 0 ]
+ERR=$(cd "$R" && printf '%s' '{"cwd":"'"$R"'"}' | env -u HARNESS_ROLE /bin/bash "$VERIFY" done analyst 2>&1 >/dev/null)
+check "done: non-worker no warning" [ -z "$ERR" ]
+
 echo "PASS $pass / FAIL $fail"
 [ "$fail" -eq 0 ]
